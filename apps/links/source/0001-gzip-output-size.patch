Allocate a gzip page's output once (WHY2025 badge, sdapps/README.md).

A complete gzip stream ends with its uncompressed size. Growing the output
by a quarter at a time copies it on each step on NOMMU, old and new held
at once: Wikipedia's "Netherlands" (1.5 MB) needed a 1.8 MB block next to
a 1.4 MB one and failed with "Out of memory" while 2.7 MB were free.

--- a/compress.c	2026-10-12 11:40:07.642380507 +0200
+++ b/compress.c	2026-10-12 11:40:07.659380209 +0200
@@ -69,6 +69,43 @@
 
 #ifdef HAVE_ZLIB
 #include <zlib.h>
+
+/*
+ * WHY2025 badge (sdapps/README.md): a complete gzip stream ends with its
+ * uncompressed size (ISIZE, mod 4 GB). With it the output is allocated
+ * once; otherwise it starts at the compressed size and grows by a quarter
+ * at a time, and without an MMU each step copies it into a new block
+ * while the old one is still held: a 1.5 MB page needed a 1.8 MB block
+ * next to a 1.4 MB one, which a fragmented 13 MB pool did not have.
+ * Returns -1 when the size is not known or not believable.
+ */
+static off_t gzip_isize(struct cache_entry *ce)
+{
+	struct fragment *f;
+	struct list_head *lf;
+	unsigned char t[4] = { 0, 0, 0, 0 };
+	off_t offset = 0, i, n = 0, isize;
+
+	if (ce->incomplete)
+		return -1;
+	foreach(struct fragment, f, lf, ce->frag) {
+		if (f->offset != offset)
+			return -1;
+		for (i = f->length > 4 ? f->length - 4 : 0; i < f->length; i++, n++) {
+			memmove(t, t + 1, 3);
+			t[3] = f->data[i];
+		}
+		offset += f->length;
+	}
+	if (n < 4)
+		return -1;
+	isize = (off_t)t[0] | (off_t)t[1] << 8 | (off_t)t[2] << 16 | (off_t)t[3] << 24;
+	/* deflate expands by at most 1032:1; below the input it is wrong */
+	if (isize < offset || isize / 1032 > offset || isize > MAXINT / 2)
+		return -1;
+	return isize + 1;	/* room for the end: no expand at the last byte */
+}
+
 static int decode_gzip(struct terminal *term, struct cache_entry *ce, int defl, int *errp)
 {
 	unsigned char err;
@@ -85,7 +122,11 @@
 
 	retry_after_memory_error:
 	memory_error = 0;
-	decoder_memory_init(&p, &size, ce->length);
+	{
+		off_t isize = defl ? -1 : gzip_isize(ce);
+
+		decoder_memory_init(&p, &size, isize > 0 ? isize : ce->length);
+	}
 	init_again:
 	err = 0;
 	skip_gzip_header = 0;
