+// this is a classmethod: from_bytes(bytes, byteorder="big", *, signed=False);
+// byteorder and signed may also be given by keyword or position
+static mp_obj_t int_from_bytes(size_t n_args, const mp_obj_t *args, mp_map_t *kw_args) {
+    mp_arg_check_num(n_args, kw_args->used, 2, 4, true);
+
+    // get the buffer info
+    mp_buffer_info_t bufinfo;
+    mp_get_buffer_raise(args[1], &bufinfo, MP_BUFFER_READ);
+
+    mp_obj_t byteorder = n_args > 2 ? args[2] : MP_OBJ_NEW_QSTR(MP_QSTR_big);
+    mp_obj_t is_signed = n_args > 3 ? args[3] : mp_const_false;
+    mp_map_elem_t *kw = mp_map_lookup(kw_args, MP_OBJ_NEW_QSTR(MP_QSTR_byteorder), MP_MAP_LOOKUP);
+    if (kw != NULL) {
+        byteorder = kw->value;
+    }
+    kw = mp_map_lookup(kw_args, MP_OBJ_NEW_QSTR(MP_QSTR_signed), MP_MAP_LOOKUP);
+    if (kw != NULL) {
+        is_signed = kw->value;
+    }
+    bool big_endian = byteorder != MP_OBJ_NEW_QSTR(MP_QSTR_little);
+
+    mp_obj_t value = int_from_bytes_unsigned(big_endian, bufinfo);
+    const byte *buf = (const byte *)bufinfo.buf;
+    if (bufinfo.len > 0 && mp_obj_is_true(is_signed)
+        && (buf[big_endian ? 0 : bufinfo.len - 1] & 0x80)) {
+        // two's complement: the top bit set means value - 2**(8*len)
+        mp_obj_t range = mp_binary_op(MP_BINARY_OP_LSHIFT, MP_OBJ_NEW_SMALL_INT(1),
+            MP_OBJ_NEW_SMALL_INT(8 * bufinfo.len));
+        value = mp_binary_op(MP_BINARY_OP_SUBTRACT, value, range);
+    }
+    return value;
+}
+
+static MP_DEFINE_CONST_FUN_OBJ_KW(int_from_bytes_fun_obj, 2, int_from_bytes);
