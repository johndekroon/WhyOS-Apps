diff -ru a/win/tty/termcap.c b/win/tty/termcap.c
--- a/win/tty/termcap.c	2023-02-15 22:52:57.000000000 +0100
+++ b/win/tty/termcap.c	2026-10-12 16:54:57.192847622 +0200
@@ -1101,6 +1101,13 @@
 
     analyze_seq(nh_HI, &hi_foreg, &hi_backg);
     analyze_seq(nh_HE, &foreg, &backg);
+    /* badge: "\033[m" leaves both at NO_COLOR, which put an explicit
+     * black background (40) on every glyph and gray in a sequence of its
+     * own: the terminal's own colours are gray on black */
+    if (foreg == NO_COLOR)
+        foreg = CLR_GRAY;
+    if (backg == NO_COLOR)
+        backg = CLR_BLACK;
 
     for (c = 0; c < SIZE(hilites); c++)
         /* avoid invisibility */
@@ -1126,6 +1133,12 @@
     /* brighten low-visibility colors */
     hilites[CLR_BLUE] = hilites[CLR_BLUE | BRIGHT];
 #endif
+    /* badge: no colour stays the terminal's own; black (dark parts of
+     * rooms, some monsters) is dark gray, bold black, not standout */
+    if (hilites[NO_COLOR] && hilites[NO_COLOR] != nh_HI)
+        free((genericptr_t) hilites[NO_COLOR]);
+    hilites[NO_COLOR] = (char *) 0;
+    hilites[CLR_BLACK] = dupstr("\033[1;30m");
 #endif /* TOS */
 }
 
