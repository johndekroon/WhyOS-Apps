#!/bin/sh
# NetHack from the menu or as the nethack command (app.conf). Its program
# and data stay in the app directory (NETHACKDIR); saves, scores and the
# level files of the running game go to APP_DATA (0001-badge.patch), the
# options to APP_CONFIG/nethackrc.
d=${0%/*}
# appterm before 2026-10-12 passed no APP_* on: the store's paths then
: "${APP_DATA:=/mnt/sd/badge/appdata/nethack}"
: "${APP_CONFIG:=${HOME:-/root}/.whyos/config/nethack}"
# the name of the save file and in the scores; NetHack asks without it
: "${USER:=${LOGNAME:-root}}"
mkdir -p "$APP_DATA/save" || exit 1
for f in perm record logfile xlogfile; do
	[ -f "$APP_DATA/$f" ] || : > "$APP_DATA/$f"
done
# A NetHack that was killed (power, a reset, SIGKILL) leaves its lock
# files, which keep the next from starting ("Too many hacks running"), and
# the level files of its game. When no NetHack runs: lock files go, and
# recover makes a save of the game from its level files; what it cannot
# use goes too (that game is lost, but NetHack starts).
running() {
	for c in /proc/[0-9]*/comm; do
		read -r n < "$c" 2>/dev/null && [ "$n" = nethack ] && return 0
	done
	return 1
}
if ! running; then
	rm -f "$APP_DATA"/*_lock
	for l in "$APP_DATA"/*lock.0; do
		[ -e "$l" ] || continue
		l=${l##*/}
		"$d/recover" -d "$APP_DATA" "${l%.0}" >/dev/null 2>&1
		rm -f "$APP_DATA/${l%.0}".*
	done
fi
mkdir -p "$APP_CONFIG" &&
	{ [ -f "$APP_CONFIG/nethackrc" ] || cp "$d/nethackrc" "$APP_CONFIG/nethackrc"; } &&
	export NETHACKOPTIONS="$APP_CONFIG/nethackrc"
export APP_DATA USER NETHACKDIR="$d" TERM=vt100 TERMCAP="$d/termcap"
exec "$d/nethack" "$@"
