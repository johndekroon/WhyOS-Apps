+	 * a 32-bit buffer first (734 x 632 x 4 = 1.8 MB for Wikipedia), on top
+	 * of a pool the page itself has nearly filled; that request ended
+	 * NetSurf. Local history shows an empty picture instead.
+	 */
+	if (width > 0)
+		return NSERROR_OK;
