# NetSurf for the WHY2025 badge (sdapps/README.md): the framebuffer
# frontend on libnsfb's badge surface, as small as it can usefully be.
override NETSURF_FB_FRONTEND := badge
override NETSURF_FB_FONTLIB := internal
override NETSURF_USE_DUKTAPE := NO
override NETSURF_USE_WEBP := NO
override NETSURF_USE_JPEGXL := NO
override NETSURF_USE_NSSVG := NO
override NETSURF_USE_RSVG := NO
override NETSURF_USE_ROSPRITE := NO
override NETSURF_USE_VIDEO := NO
override NETSURF_USE_HARU_PDF := NO
override NETSURF_USE_OPENSSL := NO
override NETSURF_USE_LIBICONV_PLUG := NO
override NETSURF_FRAMEBUFFER_RESOURCES := /mnt/sd/badge/apps/netsurf/res
override NETSURF_FB_RESPATH := /mnt/sd/badge/apps/netsurf/res:$${HOME}/.netsurf/
