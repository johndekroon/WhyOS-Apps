diff --git a/Makefile.defs b/Makefile.defs
index 8cfcce10e..b18a45189 100644
--- a/Makefile.defs
+++ b/Makefile.defs
@@ -167,6 +167,22 @@ else
   DEFCFLAGS += -Wstrict-prototypes
 endif
 
+# BADGE=1: the WHY2025 badge (RV32 NOMMU Linux, uClibc-ng, static bFLT, no
+# C++). Implies the skips below; client/Makefile adds the flags. See
+# client/src/pthread_spin_uclibc.c and guidummy_badge.c.
+ifeq ($(BADGE),1)
+  NOHARDENING ?= 1
+  NOERROR ?= 1
+  SKIPQT ?= 1
+  SKIPBT ?= 1
+  SKIPPYTHON ?= 1
+  SKIPGD ?= 1
+  SKIPREADLINE ?= 1
+  SKIPLINENOISE ?= 1
+  SKIPREVENGTEST ?= 1
+  cpu_arch ?= generic
+endif
+
 ifneq ($(NOHARDENING),1)
   # Manual equivalents of -fhardened to avoid g++: warning: linker hardening options not enabled by ‘-fhardened’ because other link options were specified on the command line
   DEFCFLAGS += \
diff --git a/client/Makefile b/client/Makefile
index 13bb06ff7..b0707f47b 100644
--- a/client/Makefile
+++ b/client/Makefile
@@ -26,6 +26,11 @@ ifeq ($(PLTNAME),)
 endif
 include ../Makefile.defs
 
+ifeq ($(BADGE),1)
+    # no C++ compiler on the badge toolchain: link with the C compiler
+    CXX = $(CC)
+endif
+
 ifeq ($(PLATFORM),PM3ICOPYX)
   INCLUDES += -DICOPYX
 endif
@@ -275,11 +280,11 @@ ifndef IS_DARWIN
     LDLIBS += -Wl,--as-needed -latomic -Wl,--no-as-needed
 endif
 
-## BZIP2
+## BZIP2 and LZ4: only hardnested uses them, which the badge build leaves out
+ifneq ($(BADGE),1)
 LDLIBS += -lbz2
-
-## LZ4
 LDLIBS += -llz4
+endif
 
 ## ZLIB
 ZLIBINCLUDES = $(shell $(PKG_CONFIG_ENV) pkg-config --cflags zlib 2>/dev/null)
@@ -462,10 +467,20 @@ endif
 #######################################################################################################
 # clang doesn't like this params
 #MYCFLAGS += --param max-completely-peeled-insns=1000 --param max-completely-peel-times=10000
-MYCFLAGS += -O3
+ifeq ($(BADGE),1)
+    MYCFLAGS += -Os
+else
+    MYCFLAGS += -O3
+endif
 
 CFLAGS ?= $(DEFCFLAGS)
 CFLAGS += $(MYDEFS) $(MYCFLAGS) $(MYINCLUDES)
+ifeq ($(BADGE),1)
+    # size first; -fPIC is required for bFLT on RISC-V (NOHARDENING drops it);
+    # LOWMEM drops the 18 MB crapto1 lookup tables; BADGE gates the source changes
+    CFLAGS += -Os -fno-asynchronous-unwind-tables -fno-unwind-tables \
+              -ffunction-sections -fdata-sections -fPIC -DLOWMEM -DBADGE
+endif
 
 # We cannot just use CFLAGS+=... because it has impact on sub-makes if CFLAGS is defined in env:
 PM3CFLAGS = $(CFLAGS)
@@ -539,6 +554,11 @@ PM3CXXFLAGS += -DHAVE_SNPRINTF
 
 LDFLAGS ?= $(DEFLDFLAGS)
 LDFLAGS += $(MYLDFLAGS)
+ifeq ($(BADGE),1)
+    # bFLT loaded into RAM, with a 1 MB main stack (flthdr -s changes it later)
+    BADGE_STACK ?= 1048576
+    LDFLAGS += -Wl,--gc-sections -Wl,-elf2flt="-r -s$(BADGE_STACK)"
+endif
 
 PM3LDFLAGS = $(LDFLAGS)
 ifdef IS_IOS
@@ -949,6 +969,27 @@ else
     CXXSRCS = guidummy.cpp
 endif
 
+ifeq ($(BADGE),1)
+    # the GUI stubs as C, and the pthread spinlocks uClibc-ng lacks
+    CXXSRCS =
+    SRCS += guidummy_badge.c pthread_spin_uclibc.c
+    # Left out: Lua scripting, hardnested, the FM11RF08S static nonce attack,
+    # MQTT, USART, PIV. Their commands are #ifndef BADGE in the command tables.
+    BADGE_EXCLUDE_SRCS = \
+        cmdhfmfhard.c \
+        cmdhfmfsen.c \
+        cmdmqtt.c \
+        cmdusart.c \
+        cmdpiv.c \
+        scripting.c \
+        cmdscript.c \
+        pm3_binlib.c \
+        pm3_bitlib.c \
+        lua_bitlib.c
+    SRCS := $(filter-out $(BADGE_EXCLUDE_SRCS),$(SRCS))
+    STATICLIBS := $(filter-out $(HARDNESTEDLIB) $(MQTTLIB) $(LUALIB),$(STATICLIBS))
+endif
+
 # OS X & iOS
 ifdef IS_DARWIN
     OBJCSRCS = util_darwin.m
