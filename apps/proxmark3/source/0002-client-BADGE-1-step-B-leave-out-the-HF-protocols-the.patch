  * width, clamped to [BAR_MIN, BAR_MAX].
  */
+#ifndef BADGE   // the animation and its 220 KB of frame buffers
 static int bar_inner_width(void) {
     int w = terminal_width() - BAR_OVERHEAD;
     if (w < BAR_MIN) {
@@ -350,6 +351,8 @@ static void *anim_thread(void *arg) {
