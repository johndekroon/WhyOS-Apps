 }
 
+#endif // BADGE
+
 /*
  * Start the animation thread.
  *   fps        – frames per second (e.g. 30.0)
@@ -363,10 +366,15 @@ void hadouken_start(double fps, int glyph_mode, int wave_mode) {
     g_progress   = 0;
     g_running    = 1;
 
+#ifdef BADGE
+    fputs("[=] flashing...   0%", stdout);
+    fflush(stdout);
+#else
     // hide cursor, clear screen
     fputs(_CURSOR_HIDE_ _CLEAR_, stdout);
     fflush(stdout);
     pthread_create(&g_thread, NULL, anim_thread, NULL);
+#endif
 }
 
 /*
@@ -383,6 +391,10 @@ void hadouken_set_progress(int pct) {
         pct = 100;
     }
     g_progress = pct;
+#ifdef BADGE
+    fprintf(stdout, "\r[=] flashing... %3d%%", pct);
+    fflush(stdout);
+#endif
 }
 
 /*
@@ -390,6 +402,12 @@ void hadouken_set_progress(int pct) {
  * progress bar and restore it so subsequent printf/puts output is visible.
  */
 void hadouken_stop(void) {
+#ifdef BADGE
+    g_running = 0;
+    fputs("\n", stdout);
+    fflush(stdout);
+    return;
+#endif
     /* Wait 2 frame durations so the thread renders at least one more frame
      * with the final g_progress value (e.g. 100%) before we signal exit.
      * Without this, the thread may be mid-sleep and exit before painting 100%. */
