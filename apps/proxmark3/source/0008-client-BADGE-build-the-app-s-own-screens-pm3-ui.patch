+static int load_bin(const char *path, uint8_t *buf, int max)
+{
+	FILE *f = fopen(path, "rb");
+	int n;
+
+	if (!f)
+		return -1;
+	n = (int)fread(buf, 1, (size_t)max, f);
+	fclose(f);
+	return n;
+}
+
+/* the client's key file: every key A, then every key B, 6 bytes each */
+static int keys_load(const char *path, struct mfc_keys *k, int sectors)
+{
+	uint8_t b[PM3UI_SECTORS * 12];
+	int n = load_bin(path, b, sizeof(b));
+
+	memset(k, 0, sizeof(*k));
+	k->sectors = sectors;
+	if (n < sectors * 12)
+		return -1;
+	for (int s = 0; s < sectors; s++)
+		for (int t = 0; t < 2; t++) {
+			memcpy(k->key[s][t], b + (t * sectors + s) * 6, 6);
+			k->found[s][t] = 1;
+		}
+	return 0;
+}
+
+/* Keys not found are written as FFFFFFFFFFFF, as the client does. */
+static int keys_save(const char *path, const struct mfc_keys *k)
+{
+	FILE *f = fopen(path, "wb");
+
+	if (!f)
+		return -1;
+	for (int t = 0; t < 2; t++)
+		for (int s = 0; s < k->sectors; s++) {
+			static const uint8_t ff[6] = { 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF };
+
+			fwrite(k->found[s][t] ? k->key[s][t] : ff, 1, 6, f);
+		}
+	return fclose(f);
+}
