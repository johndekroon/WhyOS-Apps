+/* ---- 4 · Dictionary ------------------------------------------------------------------------ */
+
+/* the list's items: the built-in lists, the user's, then "New dictionary"
+ * (index n_dicts) */
+static int dict_y(int i)
+{
+	int y = 20, nb = 0;
+
+	for (int k = 0; k < n_dicts; k++)
+		nb += dicts[k].builtin;
+	if (i < nb)
+		return y + i * 46;
+	y += nb * 46 + 20 + 20;
+	return y + (i - nb) * 46;
+}
+
+static void dict_switch(int x, int cy, int on)
+{
+	if (on) {
+		box(x, cy - 11, 38, 22, 11, WB_COLOR_CYAN, 255, 0, 0, 0);
+		box(x + 38 - 3 - 16, cy - 8, 16, 16, 8, WB_COLOR_VOID, 255, 0, 0, 0);
+	} else {
+		box(x, cy - 11, 38, 22, 11, WB_COLOR_LINE, 255, 0, 0, 0);
+		box(x + 3, cy - 8, 16, 16, 8, WB_COLOR_TEXT_LOW, 255, 0, 0, 0);
+	}
+}
+
+static void draw_dict(void)
+{
+	static const struct hint hs[] = { { "Enter", "use", 0 }, { "#1", "options", 0 }, { "#2", "edit in Write", 0 },
+					  { "Esc", "back", 1 } };
+	static const struct hint hnew[] = { { "Enter", "new", 0 }, { "#1", "options", 0 }, { "Esc", "back", 1 } };
+	int top = 150, avail = BOTTOM - 8 - top, ys[DICTS_MAX + 1], hsz[DICTS_MAX + 1], cut, scroll, nb = 0;
+
+	for (int k = 0; k < n_dicts; k++)
+		nb += dicts[k].builtin;
+	for (int i = 0; i <= n_dicts; i++) {
+		ys[i] = dict_y(i);
+		hsz[i] = i == n_dicts ? 40 : 42;
+	}
+	scroll = list_scroll(ys, hsz, n_dicts + 1, O.focus, -1, avail, &cut);
+	if (O.focus <= 0)
+		scroll = 0;
+	header("PROXMARK3 \xe2\x80\xba", "Dictionary");
+	text(&f_ui18, W - X0 - text_w(&f_ui18, "Key lists that Check keys tries", 0), text_top(&f_ui18, HEAD_CY),
+	     "Key lists that Check keys tries", WB_COLOR_TEXT_MID, 0);
+	clip_rows(top, top + cut);
+	{
+		int y = top - scroll;
+
+		group_label(X0, y, "BUILT IN \xc2\xb7 READ-ONLY, FROM THE CLIENT");
+		group_label(X0 + XW - text_w(&f_mono13, "KEYS \xc2\xb7 USE", 16), y, "KEYS \xc2\xb7 USE");
+		y = top + nb * 46 + 20 - scroll;
+		group_label(X0, y, "YOURS \xc2\xb7 EDITABLE");
+		group_label(X0 + XW - text_w(&f_mono13, "KEYS \xc2\xb7 USE", 16), y, "KEYS \xc2\xb7 USE");
+	}
+	clip_end();
+	clip_rows(top - 12, top + cut);
+	for (int i = 0; i <= n_dicts; i++) {
+		int y = top + ys[i] - scroll, on = i == O.focus, cy;
+		char b[96], cnt[16];
+
+		if (y + hsz[i] < top - 12 || y > top + cut)
+			continue;
+		cy = y + hsz[i] / 2;
+		if (i == n_dicts) {
+			box(X0, y, XW, 40, 4, on ? WB_COLOR_CYAN : WB_COLOR_VOID, on ? 20 : 140, 0, 0, on ? &GLOW_FOCUS : 0);
+			dashed(X0, y, XW, 40, on ? WB_COLOR_CYAN : 0xFFFFFF, on ? 255 : 60);
+			text(&f_mono18, X0 + 14, text_top(&f_mono18, cy), "+", WB_COLOR_CYAN, 0);
+			text(&f_ui18, X0 + 14 + 22, text_top(&f_ui18, cy), "New dictionary", on ? WB_COLOR_CYAN : WB_COLOR_TEXT_MID, 0);
+			continue;
+		}
+		wb_card(X0, y, XW, 42, 4, on, &GLOW_FOCUS);
+		icon(dicts[i].builtin ? &p3_lock : &p3_pen, X0 + 14, cy - 7,
+		     on ? WB_COLOR_CYAN : dicts[i].builtin ? WB_COLOR_TEXT_LOW : WB_COLOR_TEXT_MID, 255);
+		text(&f_mono16b, X0 + 14 + 14 + 12, text_top(&f_mono16b, cy), wb_fit(&f_mono16b, dicts[i].name, XW - 200, b,
+		     sizeof(b)), on ? WB_COLOR_CYAN : WB_COLOR_TEXT_HI, 0);
+		snprintf(cnt, sizeof(cnt), "%d", dicts[i].count < 0 ? 0 : dicts[i].count);
+		text(&f_mono14, X0 + XW - 14 - 38 - 12 - text_w(&f_mono14, cnt, 0), text_top(&f_mono14, cy), cnt,
+		     WB_COLOR_TEXT_MID, 0);
+		dict_switch(X0 + XW - 14 - 38, cy, dicts[i].on);
+	}
+	clip_end();
+	if (O.focus == n_dicts)
+		hints(hnew, 3);
+	else
+		hints(hs, 4);
+}
