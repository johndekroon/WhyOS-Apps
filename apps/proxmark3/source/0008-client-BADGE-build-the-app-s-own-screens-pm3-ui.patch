+static void input_done(void)
+{
+	int add_keys = IN.what == IN_ADD_KEYS;
+
+	O.pop = POP_NONE;
+	if (!IN.text[0])
+		return;
+	if (add_keys) {
+		char dir[256], path[400];
+		FILE *f;
+
+		user_dict_dir(dir, sizeof(dir));
+		snprintf(path, sizeof(path), "%s/%s.dic", dir, IN.text);
+		if ((f = fopen(path, "a"))) {
+			fclose(f);
+			keys_to_dict(path);
+		}
+		return;
+	}
+	dict_new(IN.text);
+}
+
+static int pop_key(int code)
+{
+	if (O.pop == POP_HELP) {
+		if (code == KEY_ESC || code == KEY_SYM_HELP || code == KEY_ENTER)
+			O.pop = POP_NONE;
+		return 0;
+	}
+	if (O.pop == POP_MENU) {
+		if (code == KEY_ESC || code == KEY_SYM_MENU)
+			O.pop = POP_NONE;
+		else if (code == KEY_UP && O.pf > 0)
+			O.pf--;
+		else if (code == KEY_DOWN && O.pf < menu_n - 1)
+			O.pf++;
+		else if (code == KEY_ENTER)
+			menu_done(O.pf);
+		return 0;
+	}
+	if (O.pop == POP_CONFIRM) {
+		if (code == KEY_ESC)
+			O.pop = POP_NONE;
+		else if (code == KEY_UP && O.pf > 0)
+			O.pf--;
+		else if (code == KEY_DOWN && O.pf < 1)
+			O.pf++;
+		else if (code == KEY_ENTER)
+			confirm_done(O.pf == 1);
+		return 0;
+	}
+	if (O.pop == POP_INPUT) {
+		int n = (int)strlen(IN.text);
+		char c = key_char(code, K.shift);
+
+		if (code == KEY_ESC)
+			O.pop = POP_NONE;
+		else if (code == KEY_ENTER)
+			input_done();
+		else if (code == KEY_BACKSPACE && n)
+			IN.text[n - 1] = 0;
+		else if (c && (isalnum((unsigned char)c) || c == '-' || c == '_') && n < (int)sizeof(IN.text) - 1) {
+			IN.text[n] = c;
+			IN.text[n + 1] = 0;
+		}
+	}
+	return 0;
+}
