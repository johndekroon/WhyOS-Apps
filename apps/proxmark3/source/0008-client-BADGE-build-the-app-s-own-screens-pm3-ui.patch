+	text(&f_ui36b, X0 + 6, 72 + 18 + 6, "Keys", WB_COLOR_TEXT_HI, -11);
+	head_right(WB_COLOR_OK, 0, 0, s->c.uid);
+	snprintf(b, sizeof(b), "%d of %d keys", n, V.k.sectors * 2);
+	x = chip(X0, 150, b, 0);
