+int be_search(int band, struct pm3_card *c, char *err, int n)
+{
+	(void)err;
+	(void)n;
+	memset(c, 0, sizeof(*c));
+	c->band = band;
+	c->fam = -1;
+	if (getenv("PM3UI_NOCARD"))
+		return 0;
+	c->found = 1;
+	if (band == BAND_LF) {
+		c->fam = FAM_EM410X;
+		snprintf(c->type, sizeof(c->type), "EM410x");
+		snprintf(c->uid, sizeof(c->uid), "0F0368568B");
+		snprintf(c->proto, sizeof(c->proto), "EM 410x ID 0F0368568B \xc2\xb7 RF/64");
+		return 0;
+	}
+	c->fam = FAM_MFC;
+	c->sak = 0x08;
+	c->sectors = 16;
+	snprintf(c->type, sizeof(c->type), "MIFARE Classic 1K");
+	snprintf(c->uid, sizeof(c->uid), "07 94 71 12");
+	snprintf(c->proto, sizeof(c->proto), "ISO 14443-A \xc2\xb7 SAK 08 \xc2\xb7 1 KB");
+	snprintf(c->magic, sizeof(c->magic), "Gen 1a magic");
+	return 0;
+}
+
+int be_command(const char *cmd)
+{
+	if (!strcmp(cmd, "hf mf info"))
+		snprintf(out, sizeof(out),
+			 "\n[=] --- ISO14443-a Information ---------------------\n"
+			 "[+]  UID: 07 94 71 12 \n[+] ATQA: 00 04\n[+]  SAK: 08 [2]\n\n"
+			 "[=] --- Keys Information\n[+] loaded 2 user keys\n[+] loaded 61 hardcoded keys\n"
+			 "[+] Backdoor key..... A396EFA4E24F\n\n[=] --- Magic Tag Information\n"
+			 "[+] Magic capabilities... Gen 1a\n\n[=] --- PRNG Information\n[+] Prng....... weak\n");
+	else if (!strncmp(cmd, "hf mf eload", 11))
+		snprintf(out, sizeof(out), "[=] 64 blocks ( 1024 bytes ) to upload\n[+] Done!\n");
+	else
+		snprintf(out, sizeof(out), "[=] sim: %s\n[+] done\n", cmd);
+	return 0;
+}
+
+const char *be_output(void)
+{
+	return out;
+}
+
+int be_mfc_check_start(int sectors, const char *const *files, int nfiles, int *nkeys)
+{
+	ck_keys = 0;
+	for (int i = 0; i < nfiles; i++) {
+		FILE *f = fopen(files[i], "r");
+		char line[128];
+
+		while (f && fgets(line, sizeof(line), f))
+			ck_keys += line[0] != '#' && line[0] != '\n';
+		if (f)
+			fclose(f);
+	}
+	*nkeys = ck_keys;
+	ck_sectors = sectors;
+	ck_step = 0;
+	return 0;
+}
+
+/* four chunks; after each the next quarter of the sectors has its keys */
+int be_mfc_check_step(struct mfc_keys *k, int *permille)
+{
+	int upto = ck_sectors * ++ck_step / 4;
+
+	for (int s = 0; s < upto; s++)
+		for (int t = 0; t < 2; t++) {
+			memset(k->key[s][t], 0xFF, 6);
+			k->found[s][t] = 1;
+		}
+	*permille = ck_step * 250;
+	return ck_step >= 4;
+}
+
+void be_mfc_check_stop(void)
+{
+}
+
+int be_mfc_read_block(const struct mfc_keys *k, int block, uint8_t out16[16])
+{
+	static const uint8_t b0[16] = { 0x07, 0x94, 0x71, 0x12, 0xF0, 0x08, 0x04, 0x00, 0x62, 0x63, 0x64, 0x65, 0x66,
+					0x67, 0x68, 0x69 };
+	static const uint8_t tr[16] = { 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x07, 0x80, 0x69, 0xFF, 0xFF, 0xFF,
+					0xFF, 0xFF, 0xFF };
+	int s = block < 128 ? block / 4 : 32 + (block - 128) / 16;
+	int last = block < 128 ? block % 4 == 3 : (block - 128) % 16 == 15;
+
+	if (!k->found[s][0] && !k->found[s][1])
+		return -1;
+	memset(out16, 0, 16);
+	if (!block)
+		memcpy(out16, b0, 16);
+	if (last)
+		memcpy(out16, tr, 16);
+	return 0;
+}
+
+int be_sniff(void)
+{
+	return 0;
+}
+
+int be_trace(struct pm3_frame *f, int max, char *key, int keyn, char *note, int noten)
+{
+	static const char *const raw[][3] = {
+		{ "Rdr", "26", "REQA" }, { "Tag", "04 00", "ATQA" }, { "Rdr", "93 20", "ANTICOLL" },
+		{ "Tag", "07 94 71 12 F0", "UID + BCC" }, { "Rdr", "93 70 07 94 71 12 F0 BC 3A", "SELECT_UID" },
+		{ "Tag", "08 B6 DD", "SAK" }, { "Rdr", "60 00 F5 7B", "AUTH-A(0)" }, { "Tag", "A4 2C 8E 51", "AUTH: nt" },
+		{ "Rdr", "1D 9C 22 4F 7A 0B 6E D3", "AUTH: nr ar (enc)" }, { "Tag", "5B 08 C1 7E", "AUTH: at (enc)" },
+		{ "Rdr", "30 00 02 A8", "READBLOCK(0)" },
+	};
+	int n = (int)(sizeof(raw) / sizeof(raw[0]));
+
+	if (getenv("PM3UI_NOCARD"))
+		return 0;
+	for (int i = 0; i < n && i < max; i++) {
+		snprintf(f[i].src, sizeof(f[i].src), "%s", raw[i][0]);
+		snprintf(f[i].data, sizeof(f[i].data), "%s", raw[i][1]);
+		snprintf(f[i].note, sizeof(f[i].note), "%s", raw[i][2]);
+	}
+	snprintf(key, (size_t)keyn, "FF FF FF FF FF FF");
+	snprintf(note, (size_t)noten, "MFKEY64 \xc2\xb7 SECTOR 0 \xc2\xb7 KEY A");
+	return n;
+}
diff --git a/client/src/badgeui/test_pm3ui.py b/client/src/badgeui/test_pm3ui.py
new file mode 100644
index 000000000..c35b2a304
--- /dev/null
+++ b/client/src/badgeui/test_pm3ui.py
@@ -0,0 +1,196 @@
+#!/usr/bin/env python3
+"""Host test of the Proxmark3 app's screens (pm3ui.c with pm3ui_sim.c).
+
+Builds pm3ui-host with the computer's cc (-DPM3UI_HOST, ASan and UBSan),
+then drives it with keys and checks what it reports (where_text): the
+screens, the key check, the dump, the saved cards, the key lists, the
+sniffer and the console.
+
+    python3 test_pm3ui.py [LIBWB]       # default ../../../../why2025-linux/libwb
+    PM3UI_SHOTS=dir python3 test_pm3ui.py   # also save the screens as PPM
+"""
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+LIBWB = sys.argv[1] if len(sys.argv) > 1 else os.path.join(HERE, "../../../../why2025-linux/libwb")
+DICTS = os.path.join(HERE, "../../dictionaries")
+TMP = tempfile.mkdtemp(prefix="pm3ui-")
+EXE = os.path.join(TMP, "pm3ui-host")
+
+
+def build():
+    subprocess.run(["cc", "-O1", "-g", "-Wall", "-Wextra", "-Wno-unused-function", "-Wno-format-truncation",
+                    "-Wno-unused-parameter", "-DPM3UI_HOST", "-fsanitize=address,undefined",
+                    "-fno-sanitize-recover=undefined", "-I" + LIBWB, "-I" + HERE,
+                    os.path.join(HERE, "pm3ui.c"), os.path.join(HERE, "pm3ui_sim.c"), "-o", EXE], check=True)
+
+
+class App:
+    """A fresh home and app folder per test: no cards, the seven lists."""
+
+    def __init__(self):
+        self.dir = tempfile.mkdtemp(dir=TMP)
+        self.home = os.path.join(self.dir, "home")
+        app = os.path.join(self.dir, "app")
+        os.makedirs(self.home)
+        os.makedirs(os.path.join(app, "dictionaries"))
+        for d in ("mfc_default_keys", "mfdes_default_keys", "mfp_default_keys", "mfulc_default_keys",
+                  "iclass_default_keys", "t55xx_default_pwds", "ht2_default"):
+            shutil.copy(os.path.join(DICTS, d + ".dic"), os.path.join(app, "dictionaries"))
+        self.env = dict(os.environ, HOME=self.home, APP_DIR=app, ASAN_OPTIONS="detect_leaks=0")
+        self.env.pop("APP_CONFIG", None)
+
+    def run(self, keys, shot=None, **env):
+        e = dict(self.env, **env)
+        ppm = ""
+        if shot and os.environ.get("PM3UI_SHOTS"):
+            os.makedirs(os.environ["PM3UI_SHOTS"], exist_ok=True)
+            ppm = os.path.join(os.environ["PM3UI_SHOTS"], shot + ".ppm")
+        r = subprocess.run([EXE, keys, ppm], capture_output=True, text=True, env=e)
+        if r.returncode:
+            raise AssertionError(r.stderr)
+        w = {}
+        for line in r.stdout.splitlines():
+            k, _, v = line.partition(" ")
+            w[k] = v
+        return w
+
+
+class Test(unittest.TestCase):
+    def setUp(self):
+        self.a = App()
+
+    def test_start(self):
+        w = self.a.run("", "start")
+        self.assertEqual(w["screen"].strip(), "start")
+        self.assertTrue(w["dev"].startswith("1 Proxmark3 RDV4 v4.21611"))
+        w = self.a.run("\\e")
+        self.assertIn("closed", w)
+
+    def test_no_proxmark(self):
+        w = self.a.run("\\n", "nodev", PM3UI_NODEV="1")
+        self.assertEqual(w["screen"].strip(), "start")
+        self.assertIn("Connect a Proxmark3", w["notice"])
+        # Cards and the Console work without one
+        w = self.a.run("\\r\\r\\n", PM3UI_NODEV="1")
+        self.assertEqual(w["screen"].strip(), "cards")
+
+    def test_search(self):
+        w = self.a.run("\\n\\n", "search")
+        self.assertEqual(w["screen"].strip(), "search")
+        self.assertEqual(w["card"], "1 0 0 MIFARE Classic 1K|07 94 71 12|ISO 14443-A · SAK 08 · 1 KB|Gen 1a magic")
+        # Enter: the type's actions
+        w = self.a.run("\\n\\n\\n", "mfc")
+        self.assertEqual(w["screen"].strip(), "family")
+        w = self.a.run("\\n\\n", PM3UI_NOCARD="1")
+        self.assertTrue(w["card"].startswith("0 "))
+
+    def test_lf(self):
+        w = self.a.run("\\r\\n\\2", "lf")
+        self.assertEqual(w["card"].split("|")[0], "1 1 0 EM410x")
+        # Simulate: the Console with the command typed in, not run
+        w = self.a.run("\\r\\n\\2\\n\\d\\n")
+        self.assertEqual(w["screen"].strip(), "console")
+        self.assertEqual(w["input"], "lf em 410x sim --id 0F0368568B")
+        self.assertEqual(w["console"], "0 ")
+
+    def test_check_and_dump(self):
+        w = self.a.run("\\n\\n\\n\\d\\n", "checking", PM3UI_HOLD="1")
+        self.assertEqual(w["check"], "1 0 0 0 0/32")
+        w = self.a.run("\\n\\n\\n\\d\\n\\w", "checked")
+        self.assertEqual(w["check"], "0 1 0 1000 32/32")
+        self.assertTrue(w["cards"].startswith("1 07 94 71 12|32 of 32 keys"))
+        self.assertTrue(os.path.exists(os.path.join(self.a.home, ".proxmark3/dumps/hf-mf-07947112-key.bin")))
+        # the triangle dumps; the dump opens
+        w = self.a.run("\\n\\n\\n\\d\\n\\w\\2", "dump")
+        self.assertEqual(w["screen"].strip(), "card")
+        self.assertEqual(w["view"], "64")
+        with open(os.path.join(self.a.home, ".proxmark3/dumps/hf-mf-07947112-dump.bin"), "rb") as f:
+            data = f.read()
+        self.assertEqual(len(data), 1024)
+        self.assertEqual(data[:4], bytes.fromhex("07947112"))
+        self.assertEqual(data[48:64], bytes.fromhex("FFFFFFFFFFFFFF078069FFFFFFFFFFFF"))
+        # Esc cancels a running check
+        w = self.a.run("\\n\\n\\n\\d\\n\\e", PM3UI_HOLD="1")
+        self.assertEqual(w["check"].split()[:3], ["0", "0", "1"])
+
+    def test_dump_checks_first(self):
+        # Dump without keys checks them first, then the triangle dumps
+        w = self.a.run("\\n\\n\\n\\d\\d\\n", PM3UI_HOLD="1")
+        self.assertEqual(w["screen"].strip(), "check")
+        w = self.a.run("\\n\\n\\n\\d\\d\\n\\w\\2")
+        self.assertEqual(w["screen"].strip(), "card")
+
+    def test_cards(self):
+        self.a.run("\\n\\n\\n\\d\\n\\w\\2")
+        w = self.a.run("\\r\\r\\n", "cards")
+        self.assertEqual(w["screen"].strip(), "cards")
+        self.assertTrue(w["cards"].startswith("1 07 94 71 12|full dump"))
+        w = self.a.run("\\r\\r\\n\\n", "card")
+        self.assertEqual(w["view"], "64")
+        w = self.a.run("\\r\\r\\n\\n\\1\\n", "keys")
+        self.assertEqual(w["screen"].strip(), "keys")
+        # the keys into a new list of the user's
+        w = self.a.run("\\r\\r\\n\\n\\1\\n\\2\\n\\n")
+        lst = os.path.join(self.a.home, ".proxmark3/dictionaries/keys.dic")
+        with open(lst) as f:
+            self.assertEqual(f.read(), "FFFFFFFFFFFF\n")
+        self.assertIn("1 key added", w["notice"])
+        # delete: Cancel is the default, then Delete
+        w = self.a.run("\\r\\r\\n\\1\\d\\d\\n\\n")
+        self.assertTrue(w["cards"].startswith("1 "))
+        w = self.a.run("\\r\\r\\n\\1\\d\\d\\n\\d\\n")
+        self.assertTrue(w["cards"].startswith("0"))
+
+    def test_dictionary(self):
+        w = self.a.run("\\d\\n", "dict")
+        self.assertIn("mfc_default_keys.dic:2509:1", w["dicts"])
+        # Enter turns a list off; it stays off
+        self.a.run("\\d\\n\\d\\d\\n")
+        w = self.a.run("\\d\\n")
+        self.assertIn("mfc_default_keys.dic:2509:0", w["dicts"])
+        # with no MIFARE Classic list on, the check says so
+        w = self.a.run("\\n\\n\\n\\d\\n")
+        self.assertIn("No key list is on", w["notice"])
+        # a new list
+        w = self.a.run("\\d\\n" + "\\d" * 7 + "\\n\\bkeys\\n", "newdict")
+        self.assertIn("site-keykeys.dic:0:1", w["dicts"])
+
+    def test_sniff(self):
+        w = self.a.run("\\d\\r\\n\\2", "sniff")
+        self.assertEqual(w["sniff"], "2 11 FF FF FF FF FF FF")
+        self.assertEqual(w["focus"], "6")	# the authentication
+
+    def test_console(self):
+        w = self.a.run("\\d\\r\\r\\nhw version\\n", "console")
+        self.assertEqual(w["console"], "3 [+] done")
+        w = self.a.run("\\d\\r\\r\\nhw version\\n\\u")
+        self.assertEqual(w["screen"].strip(), "console")
+        # Esc clears, then goes back
+        w = self.a.run("\\d\\r\\r\\nabc\\e\\e")
+        self.assertEqual(w["screen"].strip(), "start")
+
+    def test_result_and_help(self):
+        w = self.a.run("\\n\\n\\n\\n", "result")
+        self.assertEqual(w["screen"].strip(), "result")
+        self.assertTrue(w["result"].startswith("16 hf mf info"))
+        for sc in ("", "\\n", "\\n\\n", "\\n\\n\\n", "\\r\\r\\n", "\\d\\n", "\\d\\r\\n", "\\d\\r\\r\\n"):
+            w = self.a.run(sc + "\\6")
+            self.assertTrue(w["screen"].endswith("help"), sc)
+        w = self.a.run("\\4")
+        self.assertEqual(w["screen"].strip(), "log")
+        w = self.a.run("\\5")
+        self.assertEqual(w["screen"].strip(), "settings")
+
+
+if __name__ == "__main__":
+    build()
+    try:
+        unittest.main(argv=[sys.argv[0]])
+    finally:
+        shutil.rmtree(TMP, ignore_errors=True)
