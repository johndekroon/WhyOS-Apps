+/* ---- the console's lines ------------------------------------------------------ */
+
+static struct {
+	char line[CON_LINES][CON_COLS + 1];
+	int n, first;			/* a ring: n lines from first */
+	int scroll;			/* lines up from the bottom */
+	char in[160];
+	int cur;
+	char hist[HIST_MAX][160];
+	int n_hist, hist_i;
+	int running;
+} C;
+
+static char *con_line(int i)
+{
+	return C.line[(C.first + i) % CON_LINES];
+}
+
+static void con_put(const char *s, int len)
+{
+	char *d;
+
+	if (C.n == CON_LINES) {
+		C.first = (C.first + 1) % CON_LINES;
+		C.n--;
+	}
+	d = C.line[(C.first + C.n) % CON_LINES];
+	if (len > CON_COLS)
+		len = CON_COLS;
+	memcpy(d, s, (size_t)len);
+	d[len] = 0;
+	C.n++;
+}
+
+/* Text into lines: ANSI codes out, tabs as spaces, cut at CON_COLS. */
+static void con_add(const char *s)
+{
+	char b[CON_COLS + 1];
+	int k = 0;
+
+	for (; *s; s++) {
+		if (*s == '\x1b') {
+			while (*s && !isalpha((unsigned char)*s))
+				s++;
+			if (!*s)
+				break;
+			continue;
+		}
+		if (*s == '\r')
+			continue;
+		if (*s == '\n' || k == CON_COLS) {
+			con_put(b, k);
+			k = 0;
+			if (*s == '\n')
+				continue;
+		}
+		b[k++] = *s == '\t' ? ' ' : *s;
+	}
+	if (k)
+		con_put(b, k);
+}
