+	switch (CF.what) {
+	case CF_DELETE_CARD:
+		delete_card(V.i);
+		if (O.sc == SC_CARD || O.sc == SC_KEYS) {
+			while (O.sc != SC_CARDS && !back())
+				;
+		}
+		if (O.focus >= n_cards)
+			O.focus = n_cards ? n_cards - 1 : 0;
+		break;
+	case CF_RESTORE: {
+		char cmd[300];
+		const struct saved *s = &cards[V.i];
+
+		snprintf(cmd, sizeof(cmd), "hf mf restore %s -f %s%s%s", mfc_size_flag(s->c.sectors), s->dump,
+			 s->keys[0] ? " -k " : "", s->keys);
+		result("CARDS \xe2\x80\xba", "Write to a card", cmd, 1);
+		break;
+	}
+	case CF_DELETE_DICT:
+		if (dict_user(O.focus)) {
