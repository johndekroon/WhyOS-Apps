+}
+
+static void run_command(const char *cmd)
+{
+	char b[200];
+
+	snprintf(b, sizeof(b), "pm3 --> %s", cmd);
+	con_add(b);
+	C.running = 1;
+	if (O.sc == SC_CONSOLE)
+		redraw();
+	be_command(cmd);
+	C.running = 0;
+	con_add(be_output());
+	log_add(cmd, 0);
+}
+
+/* a command, its output on a screen of its own */
+static void result(const char *eb, const char *title, const char *cmd, int push)
+{
+	const char *out;
+	size_t len;
+
+	snprintf(R.eb, sizeof(R.eb), "%s", eb);
+	snprintf(R.title, sizeof(R.title), "%s", title);
+	snprintf(R.cmd, sizeof(R.cmd), "%s", cmd);
+	busy(eb, "Running\xe2\x80\xa6");
+	be_command(cmd);
+	out = be_output();
+	log_add(cmd, 0);
+	{
+		char b[200];
+
+		snprintf(b, sizeof(b), "pm3 --> %s", cmd);
+		con_add(b);
+		con_add(out);
+	}
+	free(R.text);
+	len = strlen(out);
+	R.text = malloc(len + 1);
+	R.lines = 0;
+	R.scroll = 0;
+	if (R.text) {
+		/* without ANSI codes */
+		char *d = R.text;
+
+		for (const char *s = out; *s; s++) {
+			if (*s == '\x1b') {
+				while (*s && !isalpha((unsigned char)*s))
+					s++;
+				if (!*s)
+					break;
+				continue;
+			}
+			if (*s != '\r')
+				*d++ = *s;
+		}
+		*d = 0;
+		while (d > R.text && d[-1] == '\n')
+			*--d = 0;
+		for (const char *s = R.text; *s; s++)
+			R.lines += *s == '\n';
+		R.lines += R.text[0] != 0;
+	}
+	if (push)
+		go(SC_RESULT, 0);
+}
