+/* ---- Console ---------------------------------------------------------------------------- */
+
+static int c_get(int i, char *o, int n)
+{
+	if (i < 0 || i >= C.n)
+		return -1;
+	snprintf(o, (size_t)n, "%.*s", OUT_COLS, con_line(i));
+	return (int)strlen(o);
+}
+
+static int con_rows(void)
+{
+	return (604 - 12 - 150 - 24) / OUT_LH;
+}
+
+static int con_first(void)
+{
+	int rows = con_rows(), first = C.n - rows - C.scroll;
+
+	return first < 0 ? 0 : first;
+}
+
+static void draw_console(void)
+{
+	static const struct hint hs[] = { { "Enter", "run", 0 }, { "#1", "options", 0 }, { "\xe2\x86\x91", "previous", 0 },
+					  { "Esc", "back", 1 } };
+	static const struct hint typed[] = { { "Enter", "run", 0 }, { "#1", "options", 0 }, { "\xe2\x86\x91", "previous", 0 },
+					     { "Esc", "clear", 1 } };
+	static const struct hint run[] = { { "Esc", "stop", 1 } };
+	int rows = con_rows(), iy = 604, px, tx, cx;
+	const char *shown = C.in;
+
+	header("PROXMARK3 \xe2\x80\xba", "Console");
+	if (C.running)
+		head_right(WB_COLOR_PINK, "Running", WB_COLOR_TEXT_MID, 0);
+	else if (!O.dev.present)
+		head_right(0, "Offline", WB_COLOR_TEXT_MID, 0);
+	console_box(X0, 150, XW - 12, iy - 12 - 150);
+	if (!C.n)
+		text(&f_mono14, X0 + 12, 162, "Type a client command, as on a computer: hw version, hf search, help.",
+		     WB_COLOR_TEXT_LOW, 0);
+	out_lines(X0 + 12, 162, rows, c_get, con_first());
+	scrollbar(W - X0 - 4, 150, iy - 12 - 150, C.n, rows, con_first());
+	box_focus(X0, iy, XW, 48, 4, &GLOW_FOCUS);
+	px = text(&f_mono16b, X0 + 16, text_top(&f_mono16b, iy + 24), "pm3 -->", WB_COLOR_PINK, 0) + 10;
+	/* the end of a long line */
+	while (text_w(&f_mono16b, shown, 0) > XW - 32 - (px - X0) && *shown && shown < C.in + C.cur)
+		shown++;
+	tx = text(&f_mono16b, px, text_top(&f_mono16b, iy + 24), shown, WB_COLOR_TEXT_HI, 0);
+	{
+		char b[160];
+
+		snprintf(b, sizeof(b), "%.*s", (int)(C.in + C.cur - shown), shown);
+		cx = px + text_w(&f_mono16b, b, 0);
+	}
+	(void)tx;
+	if (!C.running)
+		fill(cx, iy + 12, 2, 24, WB_COLOR_CYAN);
+	if (C.running)
+		hints(run, 1);
+	else
+		hints(C.in[0] ? typed : hs, 4);
+}
