+// SPDX-License-Identifier: GPL-3.0-or-later
+/*
+ * pm3ui: the Proxmark3 app's screens on the WHY2025 badge (BADGE=1 only),
+ * after the design canvas "Proxmark3 app – ontwerp" (claude.ai, private).
+ *
+ * pm3ui.c draws the screens with the badge's drawing library (libwb,
+ * why2025-linux/libwb) and knows nothing of the client; it asks the
+ * Proxmark3 for things through the be_* functions below. pm3ui_pm3.c
+ * implements them with the client (one process, one connection), and
+ * pm3ui_sim.c with made-up answers, for the host test (test_pm3ui.py).
+ */
+#ifndef PM3UI_H__
+#define PM3UI_H__
+
+#include <stdint.h>
+
+/* the start screen's "--ui": the screens instead of the command line */
+int pm3ui_main(const char *port);
+
+/* Esc or the triangle while a command runs: the client's
+ * kbd_enter_pressed() asks this when it is set (util.c, BADGE) */
+extern int (*pm3ui_kbd)(void);
+
+#define PM3UI_SECTORS	40	/* MIFARE Classic 4K */
+
+enum { BAND_HF, BAND_LF };
+
+/* the card types on the HF and LF screens, in their order there */
+enum { FAM_MFC, FAM_MFU, FAM_DESFIRE, FAM_MFP, FAM_14A, FAM_15, FAM_ICLASS, N_HF_FAM };
+enum { FAM_EM410X, FAM_HID, FAM_INDALA, FAM_T55XX, FAM_EM4X05, FAM_HITAG, N_LF_FAM };
+
+struct pm3_dev {
+	int present;
+	char name[32];		/* "Proxmark3 RDV4" */
+	char ver[32];		/* "v4.21611" */
+};
+
+struct pm3_card {
+	int found;
+	int band;
+	int fam;		/* FAM_*, -1 another type */
+	char type[40];		/* "MIFARE Classic 1K" */
+	char uid[48];		/* "07 94 71 12"; LF: the ID */
+	char proto[64];		/* "ISO 14443-A · SAK 08 · 1 KB" */
+	char magic[24];		/* "Gen 1a magic", or "" */
+	int sak;
+	int sectors;		/* MIFARE Classic: 5, 16, 32 or 40 */
+};
+
+/* A Proxmark3 on the port: connects when one appeared, notices when it
+ * went. 1 when that changed since the last call. */
+int be_init(const char *port);
+int be_device(struct pm3_dev *d);
+
+/* hf search or lf search; 0 also when nothing was found (c->found 0),
+ * -1 with err when the Proxmark3 did not answer */
+int be_search(int band, struct pm3_card *c, char *err, int n);
+
+/* A client command, as typed on its command line. Its output is kept:
+ * be_output() returns it (ANSI codes removed) and forgets it. */
+int be_command(const char *cmd);
+const char *be_output(void);
+
+/* MIFARE Classic: the key check, a chunk of keys at a time on the
+ * Proxmark3 (hf mf fchk's two strategies). start loads the key lists
+ * (paths), step runs one chunk, fills found and key and says how far it
+ * got (permille, over both strategies): 1 when done, 0 to
+ * go on, -1 when the card went. */
+struct mfc_keys {
+	int sectors;
+	uint8_t found[PM3UI_SECTORS][2];
+	uint8_t key[PM3UI_SECTORS][2][6];
+};
+int be_mfc_check_start(int sectors, const char *const *files, int nfiles, int *nkeys);
+int be_mfc_check_step(struct mfc_keys *k, int *permille);
+void be_mfc_check_stop(void);
+
+/* one block of a sector with a known key (A, then B, twice): 0 or -1 */
+int be_mfc_read_block(const struct mfc_keys *k, int block, uint8_t out[16]);
+
+/* hf 14a sniff until the triangle or Esc (pm3ui_kbd), then the trace as
+ * MIFARE Classic */
+struct pm3_frame {
+	char src[4];		/* "Rdr", "Tag" */
+	char data[64];		/* "93 70 07 94 71 12 F0 ..." */
+	char note[40];		/* "Select", "AUTH-A(0)" */
+};
+int be_sniff(void);
+int be_trace(struct pm3_frame *f, int max, char *key, int keyn, char *key_note, int noten);
+
+#endif
