+/* ---- 5 · Sniff -------------------------------------------------------------------------- */
+
+#define SN_TOP		202
+#define SN_ROW		36
+
+static int sniff_rows(void)
+{
+	return (S.key[0] ? 364 : 446) / SN_ROW - 1;
+}
+
+static void draw_sniff(void)
+{
+	static const struct hint idle[] = { { "#1", "options", 0 }, { "#2", "sniff", 0 }, { "Esc", "back", 1 } };
+	static const struct hint listening[] = { { "#2", "stop", 0 }, { "Esc", "cancel", 1 } };
+	static const struct hint got[] = { { "#1", "options", 0 }, { "#2", "sniff", 0 }, { "#3", "save", 0 },
+					   { "Esc", "back", 1 } };
+	int x, bh = S.key[0] ? 364 : 446, rows = sniff_rows(), first = 0;
+
+	header("PROXMARK3 \xe2\x80\xba", "Sniff");
+	if (S.state == 1)
+		head_right(WB_COLOR_PINK, "Listening \xc2\xb7 reader and card", WB_COLOR_TEXT_MID, 0);
+	else if (S.state == 2)
+		head_right(S.n ? WB_COLOR_OK : 0, S.n ? "Stopped" : "Nothing heard", WB_COLOR_TEXT_MID, 0);
+	x = chip(X0, 156, "Protocol", "14a");
+	chip(x, 156, "Decode", "Crypto1");
+	fill(X0, SN_TOP, XW, bh, WB_COLOR_CONSOLE);
+	edge_rect(X0, SN_TOP, XW, bh, 0xFFFFFF, 46);
+	{
+		int cy = SN_TOP + 16, gx = X0 + 16;
+
+		text(&f_mono13, gx, text_top(&f_mono13, cy), "#", WB_COLOR_TEXT_LOW, 16);
+		text(&f_mono13, gx + 48, text_top(&f_mono13, cy), "FROM", WB_COLOR_TEXT_LOW, 16);
+		text(&f_mono13, gx + 48 + 64, text_top(&f_mono13, cy), "DATA", WB_COLOR_TEXT_LOW, 16);
+		text(&f_mono13, X0 + XW - 16 - 160, text_top(&f_mono13, cy), "MEANING", WB_COLOR_TEXT_LOW, 16);
+		fill(X0 + 1, SN_TOP + 32, XW - 2, 1, WB_COLOR_LINE);
+	}
+	if (!S.n) {
+		const char *m = S.state == 1 ? "Listening. Hold the Proxmark3 between the reader and the card; the frames "
+					       "show when you stop." :
+				S.state == 2 ? "Nothing was heard between a reader and a card." :
+					       "\xe2\x96\xb2 starts listening to a reader and a card talking (ISO 14443-A, "
+					       "MIFARE Classic decoded).";
+
+		text_wrap(&f_ui18, X0 + 16, SN_TOP + 48, XW - 32, 26, m, WB_COLOR_TEXT_LOW, 4, 1);
+	} else {
+		if (O.focus >= rows)
+			first = O.focus - rows + 1;
+		for (int i = 0; i < rows && first + i < S.n; i++) {
+			const struct pm3_frame *f = &S.f[first + i];
+			int y = SN_TOP + 33 + i * SN_ROW, cy = y + SN_ROW / 2, sel = first + i == O.focus, gx = X0 + 16;
+			char n[8], b[96];
+
+			if (sel)
+				box(X0 + 1, y, XW - 2, SN_ROW, 0, WB_COLOR_CYAN, 20, WB_COLOR_CYAN, 2, 0);
+			else
+				fill(X0 + 16, y + SN_ROW - 1, XW - 32, 1, 0x1E1E30);
+			snprintf(n, sizeof(n), "%d", first + i + 1);
+			text(&f_mono14, gx, text_top(&f_mono14, cy), n, WB_COLOR_TEXT_LOW, 0);
+			text(&f_mono14, gx + 48, text_top(&f_mono14, cy), f->src, f->src[0] == 'R' ? WB_COLOR_CYAN :
+			     WB_COLOR_TEXT_MID, 0);
+			text(&f_mono14, gx + 48 + 64, text_top(&f_mono14, cy), wb_fit(&f_mono14, f->data, XW - 16 - 48 - 64 - 176,
+			     b, sizeof(b)), WB_COLOR_TEXT_HI, 0);
+			text(&f_ui16, X0 + XW - 16 - 160, text_top(&f_ui16, cy), wb_fit(&f_ui16, f->note, 160, b, sizeof(b)),
+			     sel ? WB_COLOR_CYAN : WB_COLOR_TEXT_MID, 0);
+		}
+	}
+	if (S.key[0]) {
+		int y = SN_TOP + 364 + 12;
+
+		wb_card(X0, y, XW, 70, 4, 0, 0);
+		text(&f_mono13, X0 + 18, y + 14, S.key_note, WB_COLOR_TEXT_LOW, 16);
+		text(&f_mono18, X0 + 18, y + 36, S.key, WB_COLOR_TEXT_HI, 16);
+		box(X0 + XW - 18 - text_w(&f_ui16, "key recovered", 0) - 17, y + 31, 9, 9, 2, WB_COLOR_OK, 255, 0, 0, 0);
+		text(&f_ui16, X0 + XW - 18 - text_w(&f_ui16, "key recovered", 0), text_top(&f_ui16, y + 35), "key recovered",
+		     WB_COLOR_TEXT_MID, 0);
+	}
+	if (S.state == 1)
+		hints(listening, 2);
+	else if (S.n)
+		hints(got, 4);
+	else
+		hints(idle, 3);
+}
