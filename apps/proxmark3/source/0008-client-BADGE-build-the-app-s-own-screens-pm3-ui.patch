+/* ---- sniff ------------------------------------------------------------------------------- */
+
+static void sniff(void)
+{
+	S.state = 1;
+	S.n = 0;
+	S.key[0] = 0;
+	O.focus = 0;
+	redraw();
+	log_add("hf 14a sniff", 0);
+	be_sniff();
+	S.state = 2;
+	busy("SNIFF", "Decoding\xe2\x80\xa6");
+	S.n = be_trace(S.f, FRAMES_MAX, S.key, sizeof(S.key), S.key_note, sizeof(S.key_note));
+	if (S.n < 0)
+		S.n = 0;
+	for (int i = 0; i < S.n; i++)
+		if (strstr(S.f[i].note, "AUTH")) {
+			O.focus = i;
+			break;
+		}
+}
