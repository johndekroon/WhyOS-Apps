+	text(&f_mono13, tx, text_top(&f_mono13, 198 + 16), "SECT", WB_COLOR_TEXT_LOW, 16);
+	text(&f_mono13, tx + 48, text_top(&f_mono13, 198 + 16), "BLK", WB_COLOR_TEXT_LOW, 16);
+	text(&f_mono13, tx + 48 + 38, text_top(&f_mono13, 198 + 16), "KEY A", WB_COLOR_TEXT_LOW, 16);
+	text(&f_mono13, tx + 48 + 38 + 204, text_top(&f_mono13, 198 + 16), "KEY B", WB_COLOR_TEXT_LOW, 16);
+	fill(X0 + 1, 198 + 32, XW - 14, 1, WB_COLOR_LINE);
+	for (int i = 0; i < rows && V.scroll + i < V.k.sectors; i++) {
+		int sct = V.scroll + i, cy = ty + i * DUMP_LH + DUMP_LH / 2;
+
+		snprintf(b, sizeof(b), "%02d", sct);
+		text(&f_mono14, tx, text_top(&f_mono14, cy), b, WB_COLOR_TEXT_LOW, 0);
+		snprintf(b, sizeof(b), "%02d", mfc_first_block(sct) + mfc_blocks(sct) - 1);
+		text(&f_mono14, tx + 48, text_top(&f_mono14, cy), b, WB_COLOR_TEXT_LOW, 0);
+		for (int t = 0; t < 2; t++) {
+			if (V.k.found[sct][t])
+				hex_spaced(V.k.key[sct][t], 6, b, sizeof(b));
