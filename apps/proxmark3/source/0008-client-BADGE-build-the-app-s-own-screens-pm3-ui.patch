+#!/usr/bin/env python3
+"""Generate pm3ui_icons.h: the icons and the big UID font of the Proxmark3
+app's screens (the
+design canvas "Proxmark3 app – ontwerp", claude.ai, private), with the
+generator of the badge's drawing library (why2025-linux/libwb/gen/gen.py),
+so they draw as libwb's own icons do.
+
+    python3 gen_icons.py /path/to/why2025-linux/libwb/gen > pm3ui_icons.h
+
+Needs python3-pil and python3-cairosvg (the build VM has them). The output
+is checked in.
+"""
+import sys
+
+sys.path.insert(0, sys.argv[1])
+import gen  # noqa: E402
+
+# name, size in px, stroke width, the canvas's SVG (24 x 24 viewBox)
+ICONS = [
+    ("p3_hf", 30, 1.6, '<rect x="3" y="5" width="18" height="14" rx="2"/><rect x="6" y="9" width="5" height="4" rx="1"/>'
+                       '<path d="M15 9.5a3 3 0 0 1 0 3M17.5 8a5.5 5.5 0 0 1 0 6"/>'),
+    ("p3_lf", 30, 1.5, '<circle cx="12" cy="12" r="2.5"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="9.5"/>'),
+    ("p3_cards", 30, 1.6, '<rect x="3" y="8" width="15" height="11" rx="2"/><path d="M7 5h12a2 2 0 0 1 2 2v9"/>'
+                          '<rect x="6" y="11" width="4" height="3" rx="0.8"/>'),
+    ("p3_dict", 30, 1.6, '<circle cx="8" cy="12" r="4.5"/><path d="M12.5 12H21M18 12v3.5M21 12v2.5"/>'),
+    ("p3_sniff", 30, 1.6, '<path d="M2 12h3l2-5 3 10 3-8 2 5 2-2h5"/>'),
+    ("p3_console", 30, 1.6, '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9l3 3-3 3M12 15h5"/>'),
+    ("p3_search", 22, 1.8, '<circle cx="10" cy="10" r="6"/><path d="M14.5 14.5 20 20"/>'),
+    ("p3_lock", 14, 1.8, '<rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>'),
+    ("p3_pen", 14, 1.8, '<path d="M4 20l1-4L16 5l3 3L8 19z"/>'),
+]
+
+out = ["/* Generated by gen_icons.py; do not edit. */", "#pragma once", ""]
+# the search's UID, 30 px in the canvas: JetBrains Mono 28, space to Z only
+gen.FIRST, gen.LAST, gen.EXTRA = 0x20, 0x5A, ""
+out.append(gen.gen_font("f_mono28", gen.MONO, 28, 500))
+out.append("")
+for i in ICONS:
+    out.append(gen.gen_icon(*i))
+    out.append("")
+sys.stdout.write("\n".join(out))
