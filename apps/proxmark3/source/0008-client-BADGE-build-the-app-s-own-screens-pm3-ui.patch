+// SPDX-License-Identifier: GPL-3.0-or-later
+/*
+ * pm3ui — the Proxmark3 app's screens on the WHY2025 badge, after the
+ * design canvas "Proxmark3 app – ontwerp" (claude.ai, private, 2026-10-29),
+ * in the style of the badge's menu (libwb, Docs/06-design-system.md): the
+ * frontpanel's figures behind every screen, the eyebrow and title, cards
+ * and rows of glass with square corners, the focus cyan.
+ *
+ * The screens (the canvas's boards):
+ *
+ *   1  Start       HF, LF, Cards, Dictionary, Sniff, Console
+ *   2  HF / LF     Search, then the card types
+ *   2a Search      the card on the antenna
+ *   2b a type      its actions (MIFARE Classic: Info, Check keys, Dump, ...)
+ *   2c Check keys  the MIFARE Classic key check, sector by sector
+ *   3  Cards       the cards saved, 3a one with its dump, 3b its keys
+ *   4  Dictionary  the key lists Check keys tries; 4a opens one in Write
+ *   5  Sniff       a reader and a card talking (hf 14a sniff)
+ *      Console     the client's command line, on the screen
+ *
+ * Actions without a screen of their own run their client command and show
+ * its output (a result screen), or open the Console with the command typed
+ * in, to be edited (Restore, Simulate, writing a block: the ones where a
+ * mistake writes a card).
+ *
+ * Keys (Docs/06 6.6): Enter opens, the square the options, the triangle the
+ * screen's main action, the cross its second; the circle the log of the
+ * commands sent, the cloud the settings (none), the diamond the help; Esc
+ * one layer back. On the badge a test sends key codes to /tmp/pm3ui.keys
+ * and reads /tmp/pm3ui.where.
+ *
+ * It draws in bands of 40 rows (libwb records each frame and draws only
+ * the bands that changed), never the whole panel at once: the client
+ * needs the memory (pop-ups are then unblurred glass).
+ *
+ * Built with -DPM3UI_HOST (and pm3ui_sim.c) it runs on a computer: keys
+ * from the first argument, the screen to the second as PPM (test_pm3ui.py).
+ */
+#include <ctype.h>
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "wb_tokens.h"
+
+#define W		WB_SCREEN_W
+#define H		WB_SCREEN_H
+#include "wb.h"
+#include "lora_state.h"
+#include "wbstatus.h"
+#include "keyrep.h"
+
+#include "pm3ui_icons.h"
+#include "pm3ui.h"
+
+#ifndef PM3UI_HOST
+#include <poll.h>
+#endif
+
+#define KEY_ESC		1
+#define KEY_BACKSPACE	14
+#define KEY_TAB		15
+#define KEY_ENTER	28
+#define KEY_LEFTSHIFT	42
+#define KEY_RIGHTSHIFT	54
+#define KEY_UP		103
+#define KEY_LEFT	105
+#define KEY_RIGHT	106
+#define KEY_DOWN	108
+#define KEY_FN		0x1d0
+
+#define X0		WB_CONTENT_PAD		/* 48 */
+#define XW		(W - 2 * X0)		/* 624 */
+#define BOTTOM		(H - WB_HINT_BAR_H)	/* 664 */
+#define HEAD_CY		116			/* the title's line, right */
+#define ROW_H		56
+#define ROW_GAP		6
+
+int (*pm3ui_kbd)(void);
+
+/* ---- state ------------------------------------------------------------------ */
+
+enum { SC_START, SC_BAND, SC_SEARCH, SC_FAMILY, SC_CHECK, SC_RESULT, SC_CARDS, SC_CARD, SC_KEYS, SC_DICT,
+       SC_SNIFF, SC_CONSOLE, SC_LOG, SC_SETTINGS };
+static const char *const sc_names[] = { "start", "band", "search", "family", "check", "result", "cards", "card",
+					"keys", "dict", "sniff", "console", "log", "settings" };
+enum { POP_NONE, POP_HELP, POP_MENU, POP_INPUT, POP_CONFIRM };
+enum { T_HF, T_LF, T_CARDS, T_DICT, T_SNIFF, T_CONSOLE, N_TILES };
+
+#define DEPTH		10
+#define LOG_MAX		40
+#define CON_LINES	300
+#define CON_COLS	78
+#define CARDS_MAX	48
+#define DICTS_MAX	32
+#define FRAMES_MAX	160
+#define HIST_MAX	16
+
+static struct {
+	int sc, focus, scroll;
+	struct { int sc, focus, scroll; } stack[DEPTH];
+	int depth;
+	int band, fam;			/* the HF or LF screen, the type's screen */
+	int pop, pf, menu_what;
+	char notice[120];
+	int notice_bad;
+	struct pm3_dev dev;
+	struct pm3_card card;		/* the card searched last */
+	int searched;			/* 0 not yet, 1 searching, 2 done */
+	char search_err[80];
+	char log[LOG_MAX][80];
+	int n_log;
+	int quit;
+} O;
+
+static struct { char hhmm[6]; int clock_ok, wifi, lora; } U;
+static struct { int shift, fn; } K;
+
+static const char *const tile_names[N_TILES] = { "HF", "LF", "Cards", "Dictionary", "Sniff", "Console" };
+static const char *const tile_subs[N_TILES] = { "13.56 MHz", "125 kHz", 0, 0, 0, 0 };
+static const struct wb_icon *const tile_icons[N_TILES] = { &p3_hf, &p3_lf, &p3_cards, &p3_dict, &p3_sniff,
+							     &p3_console };
+
+static const char *const hf_fams[N_HF_FAM] = { "MIFARE Classic", "Ultralight \xc2\xb7 NTAG", "MIFARE DESFire",
+					      "MIFARE Plus", "ISO 14443-A", "ISO 15693 \xc2\xb7 ICODE",
+					      "iCLASS \xc2\xb7 PicoPass" };
+static const char *const lf_fams[N_LF_FAM] = { "EM410x", "HID Prox", "Indala", "T55xx", "EM4x05 \xc2\xb7 EM4x69",
+					      "HITAG" };
+
+/*
+ * A type's actions. What they do: run a command and show its output, open
+ * the Console with a command typed in (to edit before Enter), or a screen
+ * of their own. In commands, %U is the card's UID or ID (no spaces), %S the
+ * MIFARE Classic size flag (--1k), %F the card's dump file.
+ */
+enum { A_RUN, A_EDIT, A_CHECK, A_DUMP };
+struct action { const char *name; int kind; const char *cmd; };
+
+#define ACTS_MAX	7
+static const struct action fam_acts[N_HF_FAM + N_LF_FAM][ACTS_MAX] = {
+	/* MIFARE Classic */
+	{ { "Info", A_RUN, "hf mf info" }, { "Check keys", A_CHECK, 0 }, { "Dump", A_DUMP, 0 },
+	  { "Restore", A_EDIT, "hf mf restore %S -f %F" }, { "Read or write a block", A_EDIT, "hf mf rdbl --blk 0 -k FFFFFFFFFFFF" },
+	  { "Simulate", A_EDIT, "hf mf sim %S -u %U" }, { "Magic card", A_EDIT, "hf mf cview %S" } },
+	/* Ultralight, NTAG */
+	{ { "Info", A_RUN, "hf mfu info" }, { "Dump", A_RUN, "hf mfu dump" }, { "Read a page", A_EDIT, "hf mfu rdbl -b 4" },
+	  { "Simulate", A_EDIT, "hf mfu sim -t 2 -u %U" } },
+	/* DESFire */
+	{ { "Info", A_RUN, "hf mfdes info" }, { "Applications", A_RUN, "hf mfdes lsapp" },
+	  { "Check keys", A_RUN, "hf mfdes chk -d mfdes_default_keys" } },
+	/* Plus */
+	{ { "Info", A_RUN, "hf mfp info" }, { "Check keys", A_RUN, "hf mfp chk -d mfp_default_keys" } },
+	/* ISO 14443-A */
+	{ { "Info", A_RUN, "hf 14a info" }, { "Read the UID", A_RUN, "hf 14a reader" }, { "Raw command", A_EDIT, "hf 14a raw -sc 3000" } },
+	/* ISO 15693 */
+	{ { "Info", A_RUN, "hf 15 info" }, { "Dump", A_RUN, "hf 15 dump" }, { "Read a block", A_EDIT, "hf 15 rdbl -* -b 0" } },
+	/* iCLASS */
+	{ { "Info", A_RUN, "hf iclass info" }, { "Check keys", A_RUN, "hf iclass chk -f iclass_default_keys" },
+	  { "Dump", A_EDIT, "hf iclass dump --ki 0" } },
+	/* EM410x */
+	{ { "Read", A_RUN, "lf em 410x reader" }, { "Simulate", A_EDIT, "lf em 410x sim --id %U" },
+	  { "Clone to a T55xx", A_EDIT, "lf em 410x clone --id %U" } },
+	/* HID Prox */
+	{ { "Read", A_RUN, "lf hid reader" }, { "Simulate", A_EDIT, "lf hid sim -r %U" },
+	  { "Clone to a T55xx", A_EDIT, "lf hid clone -r %U" } },
+	/* Indala */
+	{ { "Read", A_RUN, "lf indala reader" }, { "Clone to a T55xx", A_EDIT, "lf indala clone -r %U" } },
+	/* T55xx */
+	{ { "Detect", A_RUN, "lf t55xx detect" }, { "Dump", A_RUN, "lf t55xx dump" },
+	  { "Check passwords", A_RUN, "lf t55xx chk -f t55xx_default_pwds" }, { "Wipe", A_EDIT, "lf t55xx wipe" } },
+	/* EM4x05 */
+	{ { "Info", A_RUN, "lf em 4x05 info" }, { "Dump", A_RUN, "lf em 4x05 dump" } },
+	/* HITAG */
+	{ { "Info", A_RUN, "lf hitag info" }, { "Read", A_RUN, "lf hitag reader" } },
+};
+
+static int fam_index(void)
+{
+	return O.band == BAND_LF ? N_HF_FAM + O.fam : O.fam;
+}
+
+static int n_acts(void)
+{
+	int n = 0;
+
+	while (n < ACTS_MAX && fam_acts[fam_index()][n].name)
+		n++;
+	return n;
+}
+
+/* ---- small helpers ------------------------------------------------------------ */
+
+static void notice(const char *s, int bad)
+{
+	snprintf(O.notice, sizeof(O.notice), "%s", s);
+	O.notice_bad = bad;
+}
+
+static void log_add(const char *s, int bad)
+{
+	time_t now = time(0);
+	struct tm tm;
+
+	localtime_r(&now, &tm);
+	if (O.n_log == LOG_MAX) {
+		memmove(O.log, O.log + 1, sizeof(O.log[0]) * (LOG_MAX - 1));
+		O.n_log--;
+	}
+	snprintf(O.log[O.n_log++], sizeof(O.log[0]), "%02d:%02d %c %s", tm.tm_hour, tm.tm_min, bad ? '!' : ' ', s);
+}
+
+static char key_char(int code, int shift)
+{
+	static const char lo[] =
+		"\0\0" "1234567890-=" "\0\0" "qwertyuiop[]" "\0\0" "asdfghjkl;'`"
+		"\0" "\\zxcvbnm,./";
+	static const char hi[] =
+		"\0\0" "!@#$%^&*()_+" "\0\0" "QWERTYUIOP{}" "\0\0" "ASDFGHJKL:\"~"
+		"\0" "|ZXCVBNM<>?";
+
+	if (code == 57)
+		return ' ';
+	if (code < 0 || code >= (int)sizeof(lo))
+		return 0;
+	return shift ? hi[code] : lo[code];
+}
+
+static long now_ms(void)
+{
+	struct timespec t;
+
+	clock_gettime(CLOCK_MONOTONIC, &t);
+	return (long)t.tv_sec * 1000 + t.tv_nsec / 1000000;
+}
+
+static const char *home(void)
+{
+	const char *h = getenv("HOME");
+
+	return h && h[0] ? h : "/root";
+}
+
+/* ~/.proxmark3/<sub>, made when missing */
+static void pm3_dir(char *o, int n, const char *sub)
+{
+	char b[256];
+
+	snprintf(b, sizeof(b), "%s/.proxmark3", home());
+	mkdir(b, 0755);
+	snprintf(o, (size_t)n, "%s/%s", b, sub);
+	if (sub[0])
+		mkdir(o, 0755);
+}
+
+/* "07 94 71 12" -> "07947112" */
+static void uid_hex(const char *uid, char *o, int n)
+{
+	int k = 0;
+
+	for (; *uid && k < n - 1; uid++)
+		if (isxdigit((unsigned char)*uid))
+			o[k++] = (char)toupper((unsigned char)*uid);
+	o[k] = 0;
+}
+
+static void hex_spaced(const uint8_t *b, int n, char *o, int on)
+{
+	int k = 0;
+
+	o[0] = 0;
+	for (int i = 0; i < n && k + 4 <= on; i++)
+		k += snprintf(o + k, (size_t)(on - k), i ? " %02X" : "%02X", b[i]);
+}
+
+static int mfc_first_block(int s)
+{
+	return s < 32 ? s * 4 : 128 + (s - 32) * 16;
+}
+
+static int mfc_blocks(int s)
+{
+	return s < 32 ? 4 : 16;
+}
+
+static int mfc_sector_of(int b)
+{
+	return b < 128 ? b / 4 : 32 + (b - 128) / 16;
+}
+
+static int mfc_total_blocks(int sectors)
+{
+	return mfc_first_block(sectors);
+}
+
+static const char *mfc_size_flag(int sectors)
+{
+	return sectors == 5 ? "--mini" : sectors == 32 ? "--2k" : sectors == 40 ? "--4k" : "--1k";
+}
+
+static const char *mfc_size_text(int sectors)
+{
+	return sectors == 5 ? "320 B" : sectors == 32 ? "2 KB" : sectors == 40 ? "4 KB" : "1 KB";
+}
+
+/* ---- the saved cards (~/.proxmark3/cards.tsv) ---------------------------------- */
+
+struct saved {
+	long t;
+	struct pm3_card c;
+	char dump[160], keys[160];
+	char detail[48];
+};
+
+static struct saved cards[CARDS_MAX];
+static int n_cards;
+
+static void cards_path(char *o, int n)
+{
+	char d[200];
+
+	pm3_dir(d, sizeof(d), "");
+	snprintf(o, (size_t)n, "%scards.tsv", d);
+}
+
+/* the next tab-separated field of a line */
+static void field(char **p, char *o, int n)
+{
+	char *t = strchr(*p, '\t');
+	int len = t ? (int)(t - *p) : (int)strlen(*p);
+
+	snprintf(o, (size_t)n, "%.*s", len, *p);
+	*p = t ? t + 1 : *p + len;
+}
+
+static void cards_load(void)
+{
+	char path[256], line[800];
+	FILE *f;
+
+	n_cards = 0;
+	cards_path(path, sizeof(path));
+	if (!(f = fopen(path, "r")))
+		return;
+	while (n_cards < CARDS_MAX && fgets(line, sizeof(line), f)) {
+		struct saved *s = &cards[n_cards];
+		char *p = line, num[24];
+
+		line[strcspn(line, "\n")] = 0;
+		memset(s, 0, sizeof(*s));
+		field(&p, num, sizeof(num));
+		s->t = atol(num);
+		field(&p, num, sizeof(num));
+		s->c.band = atoi(num);
+		field(&p, num, sizeof(num));
+		s->c.fam = atoi(num);
+		field(&p, s->c.type, sizeof(s->c.type));
+		field(&p, s->c.uid, sizeof(s->c.uid));
+		field(&p, s->c.proto, sizeof(s->c.proto));
+		field(&p, s->c.magic, sizeof(s->c.magic));
+		field(&p, num, sizeof(num));
+		s->c.sak = atoi(num);
+		field(&p, num, sizeof(num));
+		s->c.sectors = atoi(num);
+		field(&p, s->dump, sizeof(s->dump));
+		field(&p, s->keys, sizeof(s->keys));
+		field(&p, s->detail, sizeof(s->detail));
+		s->c.found = 1;
+		if (s->c.uid[0])
+			n_cards++;
+	}
+	fclose(f);
+}
+
+static void cards_save(void)
+{
+	char path[256], tmp[264];
+	FILE *f;
+
+	cards_path(path, sizeof(path));
+	snprintf(tmp, sizeof(tmp), "%s.new", path);
+	if (!(f = fopen(tmp, "w")))
+		return;
+	for (int i = 0; i < n_cards; i++) {
+		const struct saved *s = &cards[i];
+
+		fprintf(f, "%ld\t%d\t%d\t%s\t%s\t%s\t%s\t%d\t%d\t%s\t%s\t%s\n", s->t, s->c.band, s->c.fam, s->c.type,
+			s->c.uid, s->c.proto, s->c.magic, s->c.sak, s->c.sectors, s->dump, s->keys, s->detail);
+	}
+	if (fclose(f) == 0)
+		rename(tmp, path);
+}
