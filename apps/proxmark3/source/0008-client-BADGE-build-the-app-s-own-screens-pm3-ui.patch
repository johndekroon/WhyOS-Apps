+// SPDX-License-Identifier: GPL-3.0-or-later
+/*
+ * pm3ui_pm3.c — the be_* functions of pm3ui.h with the client itself:
+ * the same process and connection as its command line. Commands run as
+ * typed (CommandReceived) with their output grabbed instead of printed
+ * (g_printAndLog, as pm3_console() does); the MIFARE Classic key check and
+ * reading blocks call mifarehost.c directly, so the screen can show each
+ * chunk and each sector.
+ */
+#include <ctype.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "pm3ui.h"
+
+#include "cmdhf14a.h"
+#include "cmdmain.h"
+#include "commonutil.h"
+#include "comms.h"
+#include "mifare.h"
+#include "mifare/mifarehost.h"
+#include "protocols.h"
+#include "ui.h"
+#include "util.h"
+#include "util_posix.h"
+
+static char port_name[64];
+static uint64_t last_try;
+
+/* ---- the connection --------------------------------------------------------------- */
+
+static int connect_pm3(void)
+{
+	int r;
+
+	if (!OpenProxmark(&g_session.current_device, port_name, false, 20, false, 0))
+		return -1;
+	r = TestProxmark(g_session.current_device);
+	/* the badge's USB host loses the first packets to a Proxmark3 that
+	 * has been idle (why2025-linux docs/USB.md): ping again */
+	for (int i = 0; i < 2 && r != PM3_SUCCESS; i++) {
+		msleep(200);
+		r = TestProxmark(g_session.current_device);
+	}
+	if (r != PM3_SUCCESS) {
+		CloseProxmark(g_session.current_device);
+		return -1;
+	}
+	return 0;
+}
+
+/* the firmware's version from hw version: "OS........ Iceman/master/v4.21611-..." */
+static void version(struct pm3_dev *d)
+{
+	const char *o, *p;
+
+	be_command("hw version");
+	o = be_output();
+	snprintf(d->name, sizeof(d->name), "%s", g_pm3_capabilities.is_rdv4 ? "Proxmark3 RDV4" : "Proxmark3");
+	d->ver[0] = 0;
+	if ((p = strstr(o, "OS........")) && (p = strstr(p, "/v"))) {
+		int n = (int)strcspn(p + 1, "- \n");
+
+		snprintf(d->ver, sizeof(d->ver), "%.*s", n < 24 ? n : 24, p + 1);
+	}
+}
+
+int be_init(const char *port)
+{
+	snprintf(port_name, sizeof(port_name), "%s", port && port[0] ? port : "/dev/ttyACM0");
+	g_session.supports_colors = false;
+	g_session.emoji_mode = EMO_ALTTEXT;
+	g_session.show_hints = false;
+	return 0;
+}
+
+int be_device(struct pm3_dev *d)
+{
+	int was = d->present;
+
+	if (g_session.pm3_present && access(port_name, F_OK)) {
+		CloseProxmark(g_session.current_device);
+		g_session.pm3_present = false;
+	}
+	if (!g_session.pm3_present && !access(port_name, F_OK) && msclock() - last_try > 3000) {
+		last_try = msclock();
+		connect_pm3();
+	}
+	d->present = g_session.pm3_present;
+	if (d->present && !was)
+		version(d);
+	return was != d->present;
+}
+
+/* ---- commands --------------------------------------------------------------------- */
+
+int be_command(const char *cmd)
+{
+	uint8_t prev = g_printAndLog;
+	int r;
+
+	if (g_grabbed_output.ptr)
+		g_grabbed_output.idx = 0;
+	g_printAndLog = (prev | PRINTANDLOG_GRAB) & ~PRINTANDLOG_PRINT;
+	r = CommandReceived(cmd);
+	g_printAndLog = prev;
+	return r;
+}
+
+const char *be_output(void)
+{
+	if (!g_grabbed_output.ptr)
+		return "";
+	g_grabbed_output.ptr[g_grabbed_output.idx] = 0;
+	return g_grabbed_output.ptr;
+}
+
+/* ---- search ----------------------------------------------------------------------- */
+
+static void mfc_type(struct pm3_card *c, const iso14a_card_select_t *card)
+{
+	uint16_t atqa = (uint16_t)(card->atqa[1] << 8 | card->atqa[0]);
+
+	c->fam = FAM_14A;
+	switch (card->sak) {
+	case 0x08:
+	case 0x88:
+	case 0x28:
+		c->fam = FAM_MFC;
+		c->sectors = 16;
+		snprintf(c->type, sizeof(c->type), "MIFARE Classic 1K");
+		break;
+	case 0x18:
+	case 0x38:
+		c->fam = FAM_MFC;
+		c->sectors = 40;
+		snprintf(c->type, sizeof(c->type), "MIFARE Classic 4K");
+		break;
+	case 0x09:
+		c->fam = FAM_MFC;
+		c->sectors = 5;
+		snprintf(c->type, sizeof(c->type), "MIFARE Mini");
+		break;
+	case 0x19:
+		c->fam = FAM_MFC;
+		c->sectors = 32;
+		snprintf(c->type, sizeof(c->type), "MIFARE Classic 2K");
+		break;
+	case 0x10:
+	case 0x11:
+		c->fam = FAM_MFP;
+		snprintf(c->type, sizeof(c->type), "MIFARE Plus %s", card->sak == 0x10 ? "2K" : "4K");
+		break;
+	case 0x00:
+		c->fam = FAM_MFU;
+		snprintf(c->type, sizeof(c->type), "MIFARE Ultralight \xc2\xb7 NTAG");
+		break;
+	case 0x20:
+		if (atqa == 0x0344) {
+			c->fam = FAM_DESFIRE;
+			snprintf(c->type, sizeof(c->type), "MIFARE DESFire");
+		} else if (atqa == 0x0004 || atqa == 0x0002 || atqa == 0x0044 || atqa == 0x0042) {
+			c->fam = FAM_MFP;
+			snprintf(c->type, sizeof(c->type), "MIFARE Plus");
+		} else {
+			snprintf(c->type, sizeof(c->type), "ISO 14443-4 card");
+		}
+		break;
+	default:
+		snprintf(c->type, sizeof(c->type), "ISO 14443-A card");
+	}
+}
+
+static void magic_name(struct pm3_card *c)
+{
+	uint8_t prev = g_printAndLog;
+	uint16_t m;
+
+	g_printAndLog = (prev | PRINTANDLOG_GRAB) & ~PRINTANDLOG_PRINT;
+	m = detect_mf_magic(true, MF_KEY_B, 0xFFFFFFFFFFFFULL);
+	g_printAndLog = prev;
+	c->magic[0] = 0;
+	if (m & MAGIC_FLAG_GEN_1A)
+		snprintf(c->magic, sizeof(c->magic), "Gen 1a magic");
+	else if (m & MAGIC_FLAG_GEN_1B)
+		snprintf(c->magic, sizeof(c->magic), "Gen 1b magic");
+	else if (m & MAGIC_FLAG_GEN_2)
+		snprintf(c->magic, sizeof(c->magic), "Gen 2 / CUID");
+	else if (m & MAGIC_FLAG_GEN_3)
+		snprintf(c->magic, sizeof(c->magic), "Gen 3 magic");
+	else if (m & MAGIC_FLAG_GEN_4GTU)
+		snprintf(c->magic, sizeof(c->magic), "Gen 4 GTU");
+	else if (m & (MAGIC_FLAG_GDM_AUTH | MAGIC_FLAG_GDM_WUP_20 | MAGIC_FLAG_GDM_WUP_40))
+		snprintf(c->magic, sizeof(c->magic), "Gen 4 GDM");
+}
+
+/* ISO 14443-A directly: the select gives UID, ATQA and SAK */
+static int search_14a(struct pm3_card *c)
+{
+	iso14a_card_select_t card;
+	PacketResponseNG resp;
+	char uid[40];
+
+	clearCommandBuffer();
+	SendCommandMIX(CMD_HF_ISO14443A_READER, ISO14A_CONNECT | ISO14A_NO_DISCONNECT, 0, 0, NULL, 0);
+	if (!WaitForResponseTimeout(CMD_ACK, &resp, 2500)) {
+		DropField();
+		return -1;
+	}
+	if (resp.oldarg[0] == 0) {
+		DropField();
+		return 0;
+	}
+	memcpy(&card, resp.data.asBytes, sizeof(card));
+	DropField();
+	c->found = 1;
+	c->sak = card.sak;
+	snprintf(uid, sizeof(uid), "%s", sprint_hex(card.uid, card.uidlen > 10 ? 10 : card.uidlen));
+	while (uid[0] && uid[strlen(uid) - 1] == ' ')
+		uid[strlen(uid) - 1] = 0;
+	snprintf(c->uid, sizeof(c->uid), "%s", uid);
+	mfc_type(c, &card);
+	if (c->fam == FAM_MFC) {
+		snprintf(c->proto, sizeof(c->proto), "ISO 14443-A \xc2\xb7 SAK %02X \xc2\xb7 %s", card.sak,
+			 c->sectors == 40 ? "4 KB" : c->sectors == 32 ? "2 KB" : c->sectors == 5 ? "320 B" : "1 KB");
+		magic_name(c);
+	} else {
+		snprintf(c->proto, sizeof(c->proto), "ISO 14443-A \xc2\xb7 ATQA %02X %02X \xc2\xb7 SAK %02X", card.atqa[1],
+			 card.atqa[0], card.sak);
+	}
+	return 1;
+}
+
+/* the text between "Valid " and " found" */
+static int valid_found(const char *o, char *type, int n)
+{
+	const char *p = strstr(o, "Valid "), *e;
+
+	if (!p || !(e = strstr(p, " found")))
+		return 0;
+	p += 6;
+	snprintf(type, (size_t)n, "%.*s", (int)(e - p), p);
+	return 1;
+}
+
+/* On the line holding key, after it: the last run of hex words ("07 94 71
+ * 12", "0F0368568B") with at least min digits. */
+static void hex_after(const char *o, const char *key, int min, char *out, int n)
+{
+	const char *p = strstr(o, key), *end, *q;
+
+	out[0] = 0;
+	if (!p)
+		return;
+	end = p + strcspn(p, "\n");
+	for (q = p + strlen(key); q < end; ) {
+		const char *s = 0, *e = 0;
+		int digits = 0;
+
+		/* a run: words of hex digits with single spaces between */
+		while (q < end) {
+			const char *w = q;
+
+			while (q < end && isxdigit((unsigned char)*q))
+				q++;
+			if (q == w || (q < end && *q != ' ')) {
+				while (q < end && *q != ' ')
+					q++;
+				break;
+			}
+			if (!s)
+				s = w;
+			e = q;
+			digits += (int)(q - w);
+			if (q < end)
+				q++;
+		}
+		if (s && digits >= min)
+			snprintf(out, (size_t)n, "%.*s", (int)(e - s) < n - 1 ? (int)(e - s) : n - 1, s);
+		while (q < end && *q == ' ')
+			q++;
+	}
+}
+
+static void search_hf_other(struct pm3_card *c)
+{
+	const char *o;
+	char type[48];
+
+	be_command("hf search");
+	o = be_output();
+	if (!valid_found(o, type, sizeof(type)))
+		return;
+	c->found = 1;
+	c->fam = -1;
+	if (strstr(type, "15693")) {
+		c->fam = FAM_15;
+		snprintf(c->type, sizeof(c->type), "ISO 15693 tag");
+	} else if (strstr(type, "iCLASS")) {
+		c->fam = FAM_ICLASS;
+		snprintf(c->type, sizeof(c->type), "iCLASS \xc2\xb7 PicoPass");
+	} else {
+		snprintf(c->type, sizeof(c->type), "%s", type);
+	}
+	snprintf(c->proto, sizeof(c->proto), "%s", type);
+	hex_after(o, "UID", 8, c->uid, sizeof(c->uid));
+	if (!c->uid[0])
+		hex_after(o, "CSN", 8, c->uid, sizeof(c->uid));
+}
+
+static const struct { const char *in; int fam; } lf_types[] = {
+	{ "EM410x", FAM_EM410X }, { "HID Prox", FAM_HID }, { "Indala", FAM_INDALA }, { "EM4x05", FAM_EM4X05 },
+	{ "EM4x69", FAM_EM4X05 }, { "Hitag", FAM_HITAG }, { "HITAG", FAM_HITAG },
+};
+
+static void search_lf(struct pm3_card *c)
+{
+	const char *o, *p, *line;
+	char type[48];
+
+	be_command("lf search");
+	o = be_output();
+	if (strstr(o, "Chipset detection: T55xx") || strstr(o, "Chipset... T55xx"))
+		snprintf(c->magic, sizeof(c->magic), "T55xx chip");
+	if (!valid_found(o, type, sizeof(type)))
+		return;
+	c->found = 1;
+	c->fam = -1;
+	if (!strcmp(type + (strlen(type) > 3 ? strlen(type) - 3 : 0), " ID"))
+		type[strlen(type) - 3] = 0;
+	snprintf(c->type, sizeof(c->type), "%s", type);
+	for (size_t i = 0; i < sizeof(lf_types) / sizeof(lf_types[0]); i++)
+		if (strstr(type, lf_types[i].in))
+			c->fam = lf_types[i].fam;
+	if (c->magic[0] && c->fam < 0)
+		c->fam = FAM_T55XX;
+	/* the demodulator's first line: "[+] EM 410x ID 0F0368568B" */
+	if ((line = strstr(o, "[+] "))) {
+		line += 4;
+		p = strchr(line, '\n');
+		snprintf(c->proto, sizeof(c->proto), "%.*s", p ? (int)(p - line) : (int)strlen(line), line);
+		hex_after(line, "ID", 6, c->uid, sizeof(c->uid));
+		if (!c->uid[0])
+			hex_after(line, "", 6, c->uid, sizeof(c->uid));
+	}
+}
+
+int be_search(int band, struct pm3_card *c, char *err, int n)
+{
+	memset(c, 0, sizeof(*c));
+	c->band = band;
+	c->fam = -1;
+	err[0] = 0;
+	if (!g_session.pm3_present) {
+		snprintf(err, (size_t)n, "No Proxmark3 connected");
+		return -1;
+	}
+	if (band == BAND_LF) {
+		search_lf(c);
+		return 0;
+	}
+	if (search_14a(c) < 0) {
+		snprintf(err, (size_t)n, "The Proxmark3 did not answer");
+		return -1;
+	}
+	if (!c->found)
+		search_hf_other(c);
+	return 0;
+}
+
+/* ---- MIFARE Classic ---------------------------------------------------------------- */
+
+static uint8_t *ck_keys;
+static uint32_t ck_n, ck_i;
+static int ck_sectors, ck_strategy;
+static bool ck_first, ck_field;
+static sector_t *ck_sec;
+
+/* the key lists: one key per line, 12 hex digits; # starts a comment */
+int be_mfc_check_start(int sectors, const char *const *files, int nfiles, int *nkeys)
+{
+	uint32_t cap = 0;
+
+	be_mfc_check_stop();
+	ck_n = 0;
+	for (int i = 0; i < nfiles; i++) {
+		FILE *f = fopen(files[i], "r");
+		char line[128];
+
+		while (f && fgets(line, sizeof(line), f)) {
+			char *p = line;
+			int k = 0;
+
+			while (*p == ' ' || *p == '\t')
+				p++;
+			while (isxdigit((unsigned char)p[k]))
+				k++;
+			if (k < 12)
+				continue;
+			if (ck_n == cap) {
+				uint8_t *t = realloc(ck_keys, (size_t)(cap + 512) * MIFARE_KEY_SIZE);
+
+				if (!t)
+					break;
+				ck_keys = t;
+				cap += 512;
+			}
+			for (int b = 0; b < MIFARE_KEY_SIZE; b++) {
+				unsigned v;
+
+				sscanf(p + 2 * b, "%2x", &v);
+				ck_keys[ck_n * MIFARE_KEY_SIZE + (uint32_t)b] = (uint8_t)v;
+			}
+			ck_n++;
+		}
+		if (f)
+			fclose(f);
+	}
+	*nkeys = (int)ck_n;
+	if (!ck_n)
+		return -1;
+	ck_sec = calloc((size_t)sectors, sizeof(sector_t));
+	if (!ck_sec)
+		return -1;
+	ck_sectors = sectors;
+	ck_strategy = 1;
+	ck_i = 0;
+	ck_first = true;
+	return 0;
+}
+
+/* One chunk of keys on the Proxmark3, as hf mf fchk: strategy 1 deep on
+ * sector 0, then 2 across all sectors. The found keys come back with the
+ * last chunk of a strategy, or when all are found. */
+int be_mfc_check_step(struct mfc_keys *k, int *permille)
+{
+	uint32_t chunk = PM3_CMD_DATA_SIZE / MIFARE_KEY_SIZE, size;
+	bool last;
+	int r;
+
+	if (!ck_sec)
+		return 1;
+	size = ck_n - ck_i > chunk ? chunk : ck_n - ck_i;
+	last = ck_i + size >= ck_n;
+	r = mf_check_keys_fast_ex((uint8_t)ck_sectors, ck_first, last, (uint8_t)ck_strategy, size,
+				  ck_keys + ck_i * MIFARE_KEY_SIZE, ck_sec, false, false, true, 0);
+	ck_first = false;
+	ck_field = !last;
+	ck_i += size;
+	for (int s = 0; s < ck_sectors && s < PM3UI_SECTORS; s++)
+		for (int t = 0; t < 2; t++)
+			if (ck_sec[s].foundKey[t] && !k->found[s][t]) {
+				num_to_bytes(ck_sec[s].Key[t], MIFARE_KEY_SIZE, k->key[s][t]);
+				k->found[s][t] = 1;
+			}
+	*permille = (int)(((uint64_t)(ck_strategy - 1) * ck_n + ck_i) * 1000 / (2 * (uint64_t)ck_n));
+	if (r == PM3_SUCCESS)
+		return 1;			/* every key found */
+	if (r == PM3_ETIMEOUT || r == PM3_EOPABORTED)
+		return -1;
+	if (last) {
+		if (ck_strategy == 2)
+			return 1;
+		ck_strategy = 2;
+		ck_i = 0;
+		ck_first = true;
+	}
+	return 0;
+}
+
+void be_mfc_check_stop(void)
+{
+	if (ck_field) {
+		SendCommandNG(CMD_FPGA_MAJOR_MODE_OFF, NULL, 0);
+		ck_field = false;
+	}
+	free(ck_keys);
+	ck_keys = NULL;
+	free(ck_sec);
+	ck_sec = NULL;
+}
+
+int be_mfc_read_block(const struct mfc_keys *k, int block, uint8_t out[16])
+{
+	int s = block < 128 ? block / 4 : 32 + (block - 128) / 16;
+	int last = block < 128 ? block % 4 == 3 : (block - 128) % 16 == 15;
+
+	/* key A first, as hf mf dump: with the transport access bits key B
+	 * is readable, and a readable key B does not authenticate reads */
+	for (int i = 0; i < 4; i++) {
+		int t = i & 1;
+
+		if (!k->found[s][t])
+			continue;
+		if (mf_read_block((uint8_t)block, t ? MF_KEY_B : MF_KEY_A, k->key[s][t], out) != PM3_SUCCESS)
+			continue;
+		/* a trailer reads its keys as zeros (key B where readable):
+		 * fill in what was found, as hf mf dump does */
+		if (last) {
+			if (k->found[s][0])
+				memcpy(out, k->key[s][0], 6);
+			if (k->found[s][1])
+				memcpy(out + 10, k->key[s][1], 6);
+		}
+		return 0;
+	}
+	return -1;
+}
+
+/* ---- sniff ------------------------------------------------------------------------- */
+
+int be_sniff(void)
+{
+	return be_command("hf 14a sniff");
+}
+
+/* trim spaces at both ends, in place */
+static char *trim(char *s)
+{
+	char *e;
+
+	while (*s == ' ')
+		s++;
+	e = s + strlen(s);
+	while (e > s && (e[-1] == ' ' || e[-1] == '\r'))
+		*--e = 0;
+	return s;
+}
+
+/*
+ * trace list -t mf: "  start |  end | Src | Data | CRC | Annotation", a
+ * frame's data going on in rows with an empty Src, and rows with "*" as
+ * Src for the keys the client recovered ("key", "last used key",
+ * "nested probable key: ...").
+ */
+int be_trace(struct pm3_frame *f, int max, char *key, int keyn, char *note, int noten)
+{
+	const char *o, *p;
+	char line[400];
+	int n = 0;
+
+	key[0] = note[0] = 0;
+	be_command("trace list -t mf");
+	o = be_output();
+	for (p = o; *p; ) {
+		int len = (int)strcspn(p, "\n");
+		char *col[6], *q;
+		int nc = 0;
+
+		snprintf(line, sizeof(line), "%.*s", len, p);
+		p += len + (p[len] == '\n');
+		for (q = line, col[nc++] = q; nc < 6 && (q = strchr(q, '|')); col[nc++] = ++q)
+			*q = 0;
+		if (nc < 5)
+			continue;
+		for (int i = 0; i < nc; i++)
+			col[i] = trim(col[i]);
+		if (!strcmp(col[2], "*")) {
+			char *kp = strstr(col[3], "key");
+
+			if (kp && !key[0]) {
+				char hex[16];
+
+				hex_after(kp, "key", 12, hex, sizeof(hex));
+				if (strlen(hex) == 12) {
+					snprintf(key, (size_t)keyn, "%.2s %.2s %.2s %.2s %.2s %.2s", hex, hex + 2, hex + 4, hex + 6,
+						 hex + 8, hex + 10);
+					snprintf(note, (size_t)noten, "%s", strstr(col[3], "nested") ? "NESTED \xc2\xb7 PROBABLE KEY" :
+						 "MFKEY \xc2\xb7 RECOVERED KEY");
+				}
+			}
+			continue;
+		}
+		if (!strcmp(col[2], "Rdr") || !strcmp(col[2], "Tag")) {
+			if (n == max)
+				continue;
+			snprintf(f[n].src, sizeof(f[n].src), "%s", col[2]);
+			snprintf(f[n].data, sizeof(f[n].data), "%s", col[3]);
+			snprintf(f[n].note, sizeof(f[n].note), "%s", nc > 5 ? col[5] : "");
+			n++;
+		} else if (!col[2][0] && n && col[3][0] && isxdigit((unsigned char)col[3][0])) {
+			/* the frame goes on */
+			size_t l = strlen(f[n - 1].data);
+
+			snprintf(f[n - 1].data + l, sizeof(f[n - 1].data) - l, " %s", col[3]);
+			if (nc > 5 && col[5][0] && !f[n - 1].note[0])
+				snprintf(f[n - 1].note, sizeof(f[n - 1].note), "%s", col[5]);
+		}
+	}
+	return n;
+}
