+static void when_text(long t, char *o, int n)
+{
+	static const char *const mon[] = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct",
+					   "Nov", "Dec" };
+	time_t now = time(0), tt = (time_t)t;
+	struct tm a, b;
+
+	localtime_r(&now, &a);
+	localtime_r(&tt, &b);
+	if (a.tm_year == b.tm_year && a.tm_yday == b.tm_yday)
+		snprintf(o, (size_t)n, "today");
+	else if (a.tm_year == b.tm_year && a.tm_yday == b.tm_yday + 1)
+		snprintf(o, (size_t)n, "yesterday");
+	else
+		snprintf(o, (size_t)n, "%d %s", b.tm_mday, mon[b.tm_mon % 12]);
+}
