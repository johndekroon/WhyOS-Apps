+/* ---- the key check ------------------------------------------------------------------------ */
+
+static void check_start(void)
+{
+	const char *paths[DICTS_MAX];
+
+	memset(&CK.k, 0, sizeof(CK.k));
+	memset(CK.have_trailer, 0, sizeof(CK.have_trailer));
+	CK.k.sectors = O.card.sectors ? O.card.sectors : 16;
+	CK.running = CK.done = CK.cancelled = CK.err = 0;
+	CK.permille = 0;
+	if (CK.sel >= CK.k.sectors)
+		CK.sel = 0;
+	snprintf(CK.uid, sizeof(CK.uid), "%s", O.card.uid);
+	CK.nlists = dicts_for_mfc(paths, DICTS_MAX, &CK.nkeys);
+	if (!CK.nlists) {
+		notice("No key list is on: turn one on in Dictionary", 1);
+		CK.done = 1;
+		return;
+	}
+	if (be_mfc_check_start(CK.k.sectors, paths, CK.nlists, &CK.nkeys) < 0) {
+		notice("Could not read the key lists", 1);
+		CK.done = 1;
+		return;
+	}
+	CK.running = 1;
+	log_add("hf mf fchk (on screen)", 0);
+}
+
+static void check_finish(void)
+{
+	char path[256];
+	struct saved *s;
+	int n = ck_found_keys();
+
+	CK.running = 0;
+	CK.done = 1;
+	CK.permille = 1000;
+	be_mfc_check_stop();
+	if (!n)
+		return;
+	card_file(&O.card, "key", path, sizeof(path));
+	if (keys_save(path, &CK.k) == 0) {
+		s = card_save(&O.card);
+		snprintf(s->keys, sizeof(s->keys), "%s", path);
+		if (!s->dump[0])
+			snprintf(s->detail, sizeof(s->detail), "%d of %d keys \xc2\xb7 %s", n, CK.k.sectors * 2,
+				 mfc_size_text(CK.k.sectors));
+		cards_save();
+	}
+}
+
+/* one chunk of keys; called from the main loop while the check runs */
+static void check_step(void)
+{
+	int r = be_mfc_check_step(&CK.k, &CK.permille);
+
+	if (r < 0) {
+		CK.running = 0;
+		CK.err = 1;
+		be_mfc_check_stop();
+		log_add("hf mf fchk: the card went", 1);
+		return;
+	}
+	if (r > 0) {
+		check_finish();
+		if (CK.dump_after && ck_found_keys())
+			notice("\xe2\x96\xb2 dumps the card with these keys", 0);
+	}
+}
+
+static void check_cancel(void)
+{
+	CK.running = 0;
+	CK.cancelled = 1;
+	be_mfc_check_stop();
+	log_add("hf mf fchk: cancelled", 0);
+}
+
+/* the selected sector's trailer, read once with a key found */
+static void check_trailer(void)
+{
+	int s = CK.sel;
+
+	if (CK.running || CK.have_trailer[s] || (!CK.k.found[s][0] && !CK.k.found[s][1]))
+		return;
+	if (be_mfc_read_block(&CK.k, mfc_first_block(s) + mfc_blocks(s) - 1, CK.trailer[s]) == 0)
+		CK.have_trailer[s] = 1;
+}
+
+/* ---- dump ---------------------------------------------------------------------------------- */
+
+static void open_card(int i);
+
+static void dump(const struct mfc_keys *k)
+{
+	static uint8_t data[4096];
+	char path[256], b[64];
+	int sectors = k->sectors, bad = 0;
+	struct saved *s;
+	FILE *f;
+
+	memset(data, 0, sizeof(data));
+	for (int sct = 0; sct < sectors; sct++) {
+		snprintf(b, sizeof(b), "Reading sector %d of %d", sct + 1, sectors);
+		busy("DUMP", b);
+		for (int i = 0; i < mfc_blocks(sct); i++) {
+			int blk = mfc_first_block(sct) + i;
+
+			if (be_mfc_read_block(k, blk, data + blk * 16) < 0) {
+				bad++;
+				break;
+			}
+		}
+	}
+	card_file(&O.card, "dump", path, sizeof(path));
+	if (!(f = fopen(path, "wb")) || fwrite(data, 16, (size_t)mfc_total_blocks(sectors), f) !=
+					   (size_t)mfc_total_blocks(sectors)) {
+		if (f)
+			fclose(f);
+		notice("Could not save the dump", 1);
+		return;
+	}
+	fclose(f);
+	s = card_save(&O.card);
+	snprintf(s->dump, sizeof(s->dump), "%s", path);
+	if (bad)
+		snprintf(s->detail, sizeof(s->detail), "%d of %d sectors read", sectors - bad, sectors);
+	else
+		snprintf(s->detail, sizeof(s->detail), "full dump \xc2\xb7 %s", mfc_size_text(sectors));
+	card_file(&O.card, "key", path, sizeof(path));
+	if (!s->keys[0] && keys_save(path, k) == 0)
+		snprintf(s->keys, sizeof(s->keys), "%s", path);
+	cards_save();
+	log_add(bad ? "dump: some sectors not read" : "dump: saved", bad);
+	open_card(0);
+	if (bad)
+		notice("Sectors without a key were not read", 1);
+	else
+		notice("Saved in ~/.proxmark3/dumps", 0);
+}
+
+/* Dump: with the keys checked here, or saved for this card; else check
+ * them first */
+static void dump_card(void)
+{
+	char path[256];
+	struct mfc_keys k;
+
+	if (CK.done && !strcmp(CK.uid, O.card.uid) && ck_found_keys()) {
+		dump(&CK.k);
+		return;
+	}
+	card_file(&O.card, "key", path, sizeof(path));
+	if (keys_load(path, &k, O.card.sectors ? O.card.sectors : 16) == 0) {
+		dump(&k);
+		return;
+	}
+	go(SC_CHECK, 0);
+	CK.sel = 0;
+	CK.dump_after = 1;
+	check_start();
+	notice("Checking the keys first", 0);
+}
+
+/* ---- cards ------------------------------------------------------------------------------- */
+
+static void open_card(int i)
+{
+	const struct saved *s = &cards[i];
+	int n;
+
+	V.i = i;
+	V.scroll = 0;
+	V.blocks = 0;
+	V.have_keys = 0;
+	if (s->dump[0] && (n = load_bin(s->dump, V.data, sizeof(V.data))) > 0)
+		V.blocks = n / 16;
+	if (s->keys[0] && keys_load(s->keys, &V.k, s->c.sectors ? s->c.sectors : 16) == 0)
+		V.have_keys = 1;
+	O.card = s->c;
+	go(SC_CARD, 0);
+}
+
+static void open_keys(void)
+{
+	const struct saved *s = &cards[V.i];
+
+	if (!V.have_keys && !(s->keys[0] && keys_load(s->keys, &V.k, s->c.sectors ? s->c.sectors : 16) == 0)) {
+		notice("No keys saved for this card", 1);
+		return;
+	}
+	V.have_keys = 1;
+	V.scroll = 0;
+	go(SC_KEYS, 0);
+}
+
+static void delete_card(int i)
+{
+	if (i < 0 || i >= n_cards)
+		return;
+	memmove(cards + i, cards + i + 1, sizeof(cards[0]) * (size_t)(n_cards - i - 1));
+	n_cards--;
+	cards_save();
+	notice("Removed from Cards; the files stay in ~/.proxmark3/dumps", 0);
+}
