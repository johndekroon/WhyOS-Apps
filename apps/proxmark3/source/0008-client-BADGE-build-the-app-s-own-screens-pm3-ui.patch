+/* ---- the key lists ----------------------------------------------------------- */
+
+struct dict {
+	char name[64];		/* the file's name, "mfc_default_keys.dic" */
+	char path[200];
+	int count, builtin, on;
+};
+
+static struct dict dicts[DICTS_MAX];
+static int n_dicts;
+
+static void dicts_conf(char *o, int n)
+{
+	const char *c = getenv("APP_CONFIG");
+
+	if (c && c[0]) {
+		mkdir(c, 0755);
+		snprintf(o, (size_t)n, "%s/dicts", c);
+	} else {
+		char d[200];
+
+		pm3_dir(d, sizeof(d), "");
+		snprintf(o, (size_t)n, "%sui-dicts", d);
+	}
+}
+
+static int dict_count(const char *path)
+{
+	char line[128];
+	int n = 0;
+	FILE *f = fopen(path, "r");
+
+	if (!f)
+		return -1;
+	while (fgets(line, sizeof(line), f)) {
+		char *p = line;
+
+		while (*p == ' ' || *p == '\t')
+			p++;
+		if (isxdigit((unsigned char)*p))
+			n++;
+	}
+	fclose(f);
+	return n;
+}
+
+static void dicts_scan(const char *dir, int builtin)
+{
+	DIR *d = opendir(dir);
+	struct dirent *e;
+	int first = n_dicts;
+
+	while (d && (e = readdir(d)) && n_dicts < DICTS_MAX) {
+		struct dict *x = &dicts[n_dicts];
+		size_t len = strlen(e->d_name);
+
+		if (e->d_name[0] == '.' || len < 5 || strcmp(e->d_name + len - 4, ".dic"))
+			continue;
+		memset(x, 0, sizeof(*x));
+		snprintf(x->name, sizeof(x->name), "%s", e->d_name);
+		snprintf(x->path, sizeof(x->path), "%s/%s", dir, e->d_name);
+		x->builtin = builtin;
+		x->on = 1;
+		x->count = dict_count(x->path);
+		n_dicts++;
+	}
+	if (d)
+		closedir(d);
+	/* by name */
+	for (int i = first + 1; i < n_dicts; i++)
+		for (int j = i; j > first && strcmp(dicts[j - 1].name, dicts[j].name) > 0; j--) {
+			struct dict t = dicts[j];
+
+			dicts[j] = dicts[j - 1];
+			dicts[j - 1] = t;
+		}
+}
+
+static void user_dict_dir(char *o, int n)
+{
+	pm3_dir(o, n, "dictionaries");
+}
+
+static void dicts_load(void)
+{
+	char dir[256], conf[256], line[128];
+	const char *ad = getenv("APP_DIR");
+	FILE *f;
+
+	n_dicts = 0;
+	snprintf(dir, sizeof(dir), "%s/dictionaries", ad && ad[0] ? ad : ".");
+	dicts_scan(dir, 1);
+	user_dict_dir(dir, sizeof(dir));
+	dicts_scan(dir, 0);
+	dicts_conf(conf, sizeof(conf));
+	if (!(f = fopen(conf, "r")))
+		return;
+	while (fgets(line, sizeof(line), f)) {
+		char *t = strchr(line, '\t');
+
+		if (!t)
+			continue;
+		*t = 0;
+		for (int i = 0; i < n_dicts; i++)
+			if (!strcmp(dicts[i].name, line))
+				dicts[i].on = atoi(t + 1) != 0;
+	}
+	fclose(f);
+}
+
+static void dicts_save(void)
+{
+	char conf[256], tmp[264];
+	FILE *f;
+
+	dicts_conf(conf, sizeof(conf));
+	snprintf(tmp, sizeof(tmp), "%s.new", conf);
+	if (!(f = fopen(tmp, "w")))
+		return;
+	for (int i = 0; i < n_dicts; i++)
+		fprintf(f, "%s\t%d\n", dicts[i].name, dicts[i].on);
+	if (fclose(f) == 0)
+		rename(tmp, conf);
+}
