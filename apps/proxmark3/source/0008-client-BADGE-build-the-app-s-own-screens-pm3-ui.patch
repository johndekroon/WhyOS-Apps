+static void go(int sc, int focus)
+{
+	if (O.depth < DEPTH) {
+		O.stack[O.depth].sc = O.sc;
+		O.stack[O.depth].focus = O.focus;
+		O.stack[O.depth].scroll = O.scroll;
+		O.depth++;
+	}
+	O.sc = sc;
+	O.focus = focus;
+	O.scroll = 0;
+	O.notice[0] = 0;
+}
+
+static int back(void)
+{
+	if (!O.depth)
+		return 1;
+	O.depth--;
+	O.sc = O.stack[O.depth].sc;
+	O.focus = O.stack[O.depth].focus;
+	O.scroll = O.stack[O.depth].scroll;
+	O.notice[0] = 0;
+	return 0;
+}
