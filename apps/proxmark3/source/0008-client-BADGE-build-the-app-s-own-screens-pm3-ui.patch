+/* ---- the screens' keys -------------------------------------------------------------------- */
+
+static void family_action(int i)
+{
+	const struct action *a = &fam_acts[fam_index()][i];
+	char cmd[200], eb[64], dumpf[200] = "";
+
+	if (!O.dev.present && a->kind != A_EDIT) {
+		need_pm3();
+		return;
+	}
+	snprintf(eb, sizeof(eb), "%s \xe2\x80\xba %s \xe2\x80\xba", O.band == BAND_LF ? "LF" : "HF", band_fam(O.fam));
+	for (char *p = eb; *p; p++)
+		*p = (char)toupper((unsigned char)*p);
+	switch (a->kind) {
+	case A_CHECK:
+		if (!O.card.found || O.card.band != BAND_HF || O.card.fam != FAM_MFC) {
+			notice("Search for the card first (\xe2\x96\xb2)", 1);
+			return;
+		}
+		go(SC_CHECK, 0);
+		CK.sel = 0;
+		CK.dump_after = 0;
+		check_start();
+		return;
+	case A_DUMP:
+		if (!O.card.found || O.card.band != BAND_HF || O.card.fam != FAM_MFC) {
+			notice("Search for the card first (\xe2\x96\xb2)", 1);
+			return;
+		}
+		dump_card();
+		return;
+	case A_EDIT:
+		for (int k = 0; k < n_cards; k++)
+			if (!strcmp(cards[k].c.uid, O.card.uid) && cards[k].dump[0])
+				snprintf(dumpf, sizeof(dumpf), "%s", cards[k].dump);
+		expand(a->cmd, cmd, sizeof(cmd), dumpf);
+		console_typed(cmd);
+		return;
+	default:
+		expand(a->cmd, cmd, sizeof(cmd), 0);
+		result(eb, a->name, cmd, 1);
+	}
+}
+
+static void start_key(int code)
+{
+	int t = O.focus;
+
+	if (code == KEY_LEFT && t % 3)
+		O.focus--;
+	else if (code == KEY_RIGHT && t % 3 < 2)
+		O.focus++;
+	else if (code == KEY_UP && t >= 3)
+		O.focus -= 3;
+	else if (code == KEY_DOWN && t < 3)
+		O.focus += 3;
+	else if (code == KEY_ENTER) {
+		if (tile_needs_pm3(t) && !O.dev.present) {
+			need_pm3();
+			return;
+		}
+		switch (t) {
+		case T_HF:
+		case T_LF:
+			O.band = t == T_LF ? BAND_LF : BAND_HF;
+			go(SC_BAND, 0);
+			break;
+		case T_CARDS:
+			cards_load();
+			go(SC_CARDS, 0);
+			break;
+		case T_DICT:
+			dicts_load();
+			go(SC_DICT, 0);
+			break;
+		case T_SNIFF:
+			go(SC_SNIFF, 0);
+			break;
+		default:
+			go(SC_CONSOLE, 0);
+			C.hist_i = C.n_hist;
+		}
+	}
+}
+
+static void band_key(int code)
+{
+	int n = band_n();
+
+	if (code == KEY_UP && O.focus > 0)
+		O.focus--;
+	else if (code == KEY_DOWN && O.focus < n)
+		O.focus++;
+	else if (code == KEY_LEFT)
+		O.focus = O.focus > 4 ? O.focus - 4 : 0;
+	else if (code == KEY_RIGHT)
+		O.focus = O.focus + 4 < n ? O.focus + 4 : n;
+	else if (code == KEY_SYM_MENU)
+		menu_build(M_BAND), O.pop = POP_MENU;
+	else if (code == KEY_SYM_MAIN || (code == KEY_ENTER && O.focus == 0)) {
+		go(SC_SEARCH, 0);
+		search();
+	} else if (code == KEY_ENTER) {
+		O.fam = O.focus - 1;
+		go(SC_FAMILY, 0);
+	}
+}
+
+static void search_key(int code)
+{
+	if (code == KEY_SYM_MAIN) {
+		search();
+	} else if (O.searched != 2 || !O.card.found) {
+		return;
+	} else if (code == KEY_SYM_MENU) {
+		menu_build(M_SEARCH);
+		O.pop = POP_MENU;
+	} else if (code == KEY_ENTER) {
+		if (O.card.fam < 0) {
+			console_typed(O.band == BAND_LF ? "lf " : "hf ");
+			return;
+		}
+		O.fam = O.card.fam;
+		go(SC_FAMILY, 0);
+	}
+}
+
+static void family_key(int code)
+{
+	int n = n_acts();
+
+	if (code == KEY_UP && O.focus > 0)
+		O.focus--;
+	else if (code == KEY_DOWN && O.focus < n - 1)
+		O.focus++;
+	else if (code == KEY_SYM_MENU)
+		menu_build(M_FAMILY), O.pop = POP_MENU;
+	else if (code == KEY_SYM_MAIN) {
+		if (!O.dev.present) {
+			need_pm3();
+			return;
+		}
+		go(SC_SEARCH, 0);
+		search();
+	} else if (code == KEY_ENTER)
+		family_action(O.focus);
+}
+
+static void check_key(int code)
+{
+	int s = CK.k.sectors ? CK.k.sectors : 16;
+
+	if (code == KEY_LEFT && CK.sel > 0)
+		CK.sel--;
+	else if (code == KEY_RIGHT && CK.sel < s - 1)
+		CK.sel++;
+	else if (code == KEY_UP && CK.sel >= 8)
+		CK.sel -= 8;
+	else if (code == KEY_DOWN && CK.sel + 8 < s)
+		CK.sel += 8;
+	else if (code == KEY_SYM_MENU)
+		menu_build(M_CHECK), O.pop = POP_MENU;
+	else if (code == KEY_SYM_MAIN && !CK.running) {
+		if (ck_found_keys())
+			dump(&CK.k);
+		else
+			notice("No keys found to read the card with", 1);
+		return;
+	}
+	check_trailer();
+}
+
+static void result_key(int code)
+{
+	int rows = r_rows(), max = R.lines > rows ? R.lines - rows : 0;
+
+	if (code == KEY_UP && R.scroll > 0)
+		R.scroll--;
+	else if (code == KEY_DOWN && R.scroll < max)
+		R.scroll++;
+	else if (code == KEY_LEFT)
+		R.scroll = R.scroll > rows ? R.scroll - rows : 0;
+	else if (code == KEY_RIGHT)
+		R.scroll = R.scroll + rows < max ? R.scroll + rows : max;
+	else if (code == KEY_SYM_MENU)
+		menu_build(M_RESULT), O.pop = POP_MENU;
+	else if (code == KEY_SYM_MAIN)
+		result(R.eb, R.title, R.cmd, 0);
+}
+
+static void cards_key(int code)
+{
+	if (!n_cards)
+		return;
+	if (code == KEY_UP && O.focus > 0)
+		O.focus--;
+	else if (code == KEY_DOWN && O.focus < n_cards - 1)
+		O.focus++;
+	else if (code == KEY_SYM_MENU)
+		menu_build(M_CARDS), O.pop = POP_MENU;
+	else if (code == KEY_ENTER)
+		open_card(O.focus);
+}
+
+static void card_key(int code)
+{
+	int rows = card_rows(), max = V.blocks > rows ? V.blocks - rows : 0;
+
+	if (code == KEY_UP && V.scroll > 0)
+		V.scroll--;
+	else if (code == KEY_DOWN && V.scroll < max)
+		V.scroll++;
+	else if (code == KEY_LEFT)
+		V.scroll = V.scroll > rows ? V.scroll - rows : 0;
+	else if (code == KEY_RIGHT)
+		V.scroll = V.scroll + rows < max ? V.scroll + rows : max;
+	else if (code == KEY_SYM_MENU)
+		menu_build(M_CARD), O.pop = POP_MENU;
+	else if (code == KEY_SYM_MAIN && V.blocks) {
+		char cmd[300];
+		const struct saved *s = &cards[V.i];
+
+		if (!O.dev.present) {
+			need_pm3();
+			return;
+		}
+		snprintf(cmd, sizeof(cmd), "hf mf eload %s -f %s", mfc_size_flag(s->c.sectors), s->dump);
+		busy("CARDS", "Loading into the Proxmark3\xe2\x80\xa6");
+		run_command(cmd);
+		notice("In the Proxmark3's emulator memory: Simulate uses it", 0);
+	}
+}
+
+static void keys_key(int code)
+{
+	int rows = card_rows(), max = V.k.sectors > rows ? V.k.sectors - rows : 0;
+
+	if (code == KEY_UP && V.scroll > 0)
+		V.scroll--;
+	else if (code == KEY_DOWN && V.scroll < max)
+		V.scroll++;
+	else if (code == KEY_SYM_MENU)
+		menu_build(M_KEYS), O.pop = POP_MENU;
+	else if (code == KEY_SYM_MAIN)
+		menu_build(M_ADD_TO), O.pop = POP_MENU;
+}
+
+static void dict_key(int code)
+{
+	if (code == KEY_UP && O.focus > 0)
+		O.focus--;
+	else if (code == KEY_DOWN && O.focus < n_dicts)
+		O.focus++;
+	else if (code == KEY_SYM_MENU)
+		menu_build(M_DICT), O.pop = POP_MENU;
+	else if (code == KEY_ENTER && O.focus == n_dicts) {
+		menu_build(M_DICT);
+		menu_done(0);
+	} else if (code == KEY_ENTER) {
+		dicts[O.focus].on ^= 1;
+		dicts_save();
+	} else if (code == KEY_SYM_MAIN && O.focus < n_dicts) {
+		if (dicts[O.focus].builtin) {
+			notice("Built-in lists are read-only: \xe2\x96\xa0 copies one to your lists", 0);
+			return;
+		}
+		open_in_write(dicts[O.focus].path);
+		dicts_load();
+	}
+}
+
+static void sniff_key(int code)
+{
+	if (code == KEY_UP && O.focus > 0)
+		O.focus--;
+	else if (code == KEY_DOWN && O.focus < S.n - 1)
+		O.focus++;
+	else if (code == KEY_SYM_MENU)
+		menu_build(M_SNIFF), O.pop = POP_MENU;
+	else if (code == KEY_SYM_MAIN) {
+		if (!O.dev.present) {
+			need_pm3();
+			return;
+		}
+		sniff();
+	} else if (code == KEY_SYM_SECOND && S.n) {
+		char cmd[96];
+		time_t t = time(0);
+		struct tm tm;
+
+		localtime_r(&t, &tm);
+		snprintf(cmd, sizeof(cmd), "trace save -f hf-14a-sniff-%04d%02d%02d-%02d%02d", tm.tm_year + 1900, tm.tm_mon + 1,
+			 tm.tm_mday, tm.tm_hour, tm.tm_min);
+		run_command(cmd);
+		notice("Saved in ~/.proxmark3/dumps", 0);
+	}
+}
+
+static void console_key(int code)
+{
+	int n = (int)strlen(C.in);
+	char c;
+
+	if (code == KEY_ENTER) {
+		char cmd[160];
+
+		if (!C.in[0])
+			return;
+		snprintf(cmd, sizeof(cmd), "%s", C.in);
+		if (!C.n_hist || strcmp(C.hist[(C.n_hist - 1) % HIST_MAX], cmd))
+			snprintf(C.hist[C.n_hist++ % HIST_MAX], sizeof(C.hist[0]), "%s", cmd);
+		C.hist_i = C.n_hist;
+		C.in[0] = 0;
+		C.cur = 0;
+		C.scroll = 0;
+		if (!strcmp(cmd, "quit") || !strcmp(cmd, "exit")) {
+			back();
+			return;
+		}
+		run_command(cmd);
+		return;
+	}
+	if (K.fn && (code == KEY_UP || code == KEY_DOWN)) {
+		int max = C.n > con_rows() ? C.n - con_rows() : 0;
+
+		C.scroll += code == KEY_UP ? 3 : -3;
+		C.scroll = C.scroll < 0 ? 0 : C.scroll > max ? max : C.scroll;
+		return;
+	}
+	if (code == KEY_UP || code == KEY_DOWN) {
+		int lo = C.n_hist > HIST_MAX ? C.n_hist - HIST_MAX : 0;
+
+		if (code == KEY_UP && C.hist_i > lo)
+			C.hist_i--;
+		else if (code == KEY_DOWN && C.hist_i < C.n_hist)
+			C.hist_i++;
+		else
+			return;
+		snprintf(C.in, sizeof(C.in), "%s", C.hist_i < C.n_hist ? C.hist[C.hist_i % HIST_MAX] : "");
+		C.cur = (int)strlen(C.in);
+		return;
+	}
+	if (code == KEY_LEFT && C.cur > 0)
+		C.cur--;
+	else if (code == KEY_RIGHT && C.cur < n)
+		C.cur++;
+	else if (code == KEY_BACKSPACE && C.cur > 0) {
+		memmove(C.in + C.cur - 1, C.in + C.cur, (size_t)(n - C.cur + 1));
+		C.cur--;
+	} else if (code == KEY_SYM_MENU) {
+		menu_build(M_CONSOLE);
+		O.pop = POP_MENU;
+	} else if ((c = key_char(code, K.shift)) && n < (int)sizeof(C.in) - 1) {
+		memmove(C.in + C.cur + 1, C.in + C.cur, (size_t)(n - C.cur + 1));
+		C.in[C.cur++] = c;
+	}
+}
+
+/* Esc, one layer at a time (Docs/06 6.7); 1 closes the app */
+static int esc(void)
+{
+	if (O.sc == SC_CHECK && CK.running) {
+		check_cancel();
+		return 0;
+	}
+	if (O.sc == SC_CONSOLE && C.in[0]) {
+		C.in[0] = 0;
+		C.cur = 0;
+		return 0;
+	}
+	return back();
+}
+
+/* a key; 1 when the app closes */
+static int key(int code)
+{
+	if (code == KEY_ESC || code == KEY_ENTER || (code >= KEY_SYM_MENU && code <= KEY_SYM_HELP))
+		O.notice[0] = 0;
+	if (O.pop)
+		return pop_key(code);
+	if (code == KEY_SYM_HELP) {
+		O.pop = POP_HELP;
+		return 0;
+	}
+	if (code == KEY_SYM_LOG && O.sc != SC_LOG) {
+		go(SC_LOG, 0);
+		return 0;
+	}
+	if (code == KEY_SYM_SETTINGS && O.sc != SC_SETTINGS) {
+		go(SC_SETTINGS, 0);
+		return 0;
+	}
+	if (code == KEY_ESC)
+		return esc();
+	switch (O.sc) {
+	case SC_START:
+		start_key(code);
+		break;
+	case SC_BAND:
+		band_key(code);
+		break;
+	case SC_SEARCH:
+		search_key(code);
+		break;
+	case SC_FAMILY:
+		family_key(code);
+		break;
+	case SC_CHECK:
+		check_key(code);
+		break;
+	case SC_RESULT:
+		result_key(code);
+		break;
+	case SC_CARDS:
+		cards_key(code);
+		break;
+	case SC_CARD:
+		card_key(code);
+		break;
+	case SC_KEYS:
+		keys_key(code);
+		break;
+	case SC_DICT:
+		dict_key(code);
+		break;
+	case SC_SNIFF:
+		sniff_key(code);
+		break;
+	case SC_CONSOLE:
+		console_key(code);
+		break;
+	}
+	return 0;
+}
+
+/* what a test reads: where the app is and what it shows */
+static int where_text(char *o, int size)
+{
+	int n = 0;
+
+	n += snprintf(o + n, (size_t)(size - n), "screen %s %s\nfocus %d\nnotice %s\ndev %d %s %s\n", sc_names[O.sc],
+		      O.pop == POP_HELP ? "help" : O.pop == POP_MENU ? "menu" : O.pop == POP_INPUT ? "input" :
+		      O.pop == POP_CONFIRM ? "confirm" : "", O.focus, O.notice, O.dev.present, O.dev.name, O.dev.ver);
+	n += snprintf(o + n, (size_t)(size - n), "card %d %d %d %s|%s|%s|%s\n", O.card.found, O.card.band, O.card.fam,
+		      O.card.type, O.card.uid, O.card.proto, O.card.magic);
+	n += snprintf(o + n, (size_t)(size - n), "check %d %d %d %d %d/%d\n", CK.running, CK.done, CK.cancelled,
+		      CK.permille, ck_found_keys(), CK.k.sectors * 2);
+	n += snprintf(o + n, (size_t)(size - n), "cards %d", n_cards);
+	for (int i = 0; i < n_cards; i++)
+		n += snprintf(o + n, (size_t)(size - n), " %s|%s", cards[i].c.uid, cards[i].detail);
+	n += snprintf(o + n, (size_t)(size - n), "\ndicts %d", n_dicts);
+	for (int i = 0; i < n_dicts; i++)
+		n += snprintf(o + n, (size_t)(size - n), " %s:%d:%d", dicts[i].name, dicts[i].count, dicts[i].on);
+	n += snprintf(o + n, (size_t)(size - n), "\nsniff %d %d %s\nview %d\nresult %d %s\nconsole %d %s\nmenu",
+		      S.state, S.n, S.key, V.blocks, R.lines, R.cmd, C.n, C.n ? con_line(C.n - 1) : "");
+	for (int i = 0; O.pop == POP_MENU && i < menu_n; i++)
+		n += snprintf(o + n, (size_t)(size - n), " |%s", menu_it[i].label);
+	n += snprintf(o + n, (size_t)(size - n), "\nlog %d\ninput %s\n", O.n_log, C.in);
+	return n;
+}
+
+static void finish(void)
+{
+	if (CK.running)
+		check_cancel();
+	free(R.text);
+	R.text = 0;
+}
+
+#ifdef PM3UI_HOST
+/* ---- the host test ------------------------------------------------------------------------ */
+
+static void save_ppm(const char *path)
+{
+	FILE *f = fopen(path, "wb");
+
+	if (!f)
+		return;
+	fprintf(f, "P6\n%d %d\n255\n", W, H);
+	for (int i = 0; i < W * H; i++) {
+		uint16_t p = screen[i];
+		unsigned char c[3] = { (unsigned char)((p >> 11) << 3), (unsigned char)(((p >> 5) & 63) << 2),
+				       (unsigned char)((p & 31) << 3) };
+
+		fwrite(c, 3, 1, f);
+	}
+	fclose(f);
+}
+
+/*
+ * pm3ui-host KEYS [OUT.ppm]: \n Enter, \e Esc, \b Backspace, \u \d \l \r
+ * the arrows, \1..\6 the symbol keys, \s Shift and \f Fn for the next key,
+ * \w a check step (the main loop's); other characters typed. PM3UI_FRAMES
+ * =DIR: the screen after every key, DIR/NNN.ppm. Prints where_text.
+ */
+int main(int argc, char **argv)
+{
+	const char *k = argc > 1 ? argv[1] : "", *frames = getenv("PM3UI_FRAMES");
+	static char out[16384];
+	int closed = 0, nf = 0;
+
+	memcpy(U.hhmm, "14:32", 6);
+	U.clock_ok = 1;
+	U.wifi = 3;
+	U.lora = 1;
+	be_init("/dev/ttyACM0");
+	be_device(&O.dev);
+	cards_load();
+	dicts_load();
+	for (; *k && !closed; k++) {
+		int code = -1;
+
+		if (*k == '\\' && k[1] == 's') {
+			K.shift = 1;
+			k += 2;
+		}
+		if (*k == '\\' && k[1] == 'f') {
+			K.fn = 1;
+			k += 2;
+		}
+		if (*k == '\\' && k[1] == 'w') {
+			k++;
+			while (CK.running)
+				check_step();
+			continue;
+		}
+		if (*k == '\\' && k[1] && k[1] != '\\') {
+			k++;
+			code = *k == 'n' ? KEY_ENTER : *k == 'e' ? KEY_ESC : *k == 'b' ? KEY_BACKSPACE : *k == 'u' ? KEY_UP :
+			       *k == 'd' ? KEY_DOWN : *k == 'l' ? KEY_LEFT : *k == 'r' ? KEY_RIGHT :
+			       *k >= '1' && *k <= '6' ? KEY_SYM_MENU + (*k - '1') : -1;
+		} else {
+			k += *k == '\\';
+			for (int c = 0; c < 64 && code < 0; c++) {
+				if (key_char(c, 0) == *k)
+					code = c;
+				else if (key_char(c, 1) == *k)
+					code = c, K.shift = 1;
+			}
+			if (*k == ' ')
+				code = 57;
+		}
+		if (code >= 0)
+			closed = key(code);
+		if (CK.running && !getenv("PM3UI_HOLD"))	/* the main loop runs the check between keys */
+			check_step();
+		K.shift = K.fn = 0;
+		if (frames && !closed) {
+			char path[300];
+
+			redraw();
+			snprintf(path, sizeof(path), "%s/%03d.ppm", frames, nf++);
+			save_ppm(path);
+		}
+	}
+	redraw();
+	if (argc > 2 && argv[2][0])
+		save_ppm(argv[2]);
+	where_text(out, sizeof(out));
+	fputs(out, stdout);
+	if (closed)
+		puts("closed");
+	finish();
+	return 0;
+}
+
+#else
+/* ---- the badge ------------------------------------------------------------------------------- */
+
+#define FIFO	"/tmp/pm3ui.keys"
+#define WHERE	"/tmp/pm3ui.where"
+
+struct ev {
+	unsigned int sec, usec;
+	unsigned short type, code;
+	int value;
+};
+
+static volatile sig_atomic_t stop;
+static int ev_fd = -1, fifo_fd = -1, fifo_used;
+
+static void on_signal(int s)
+{
+	stop = s;
+}
+
+static int status_read(void)
+{
+	time_t t = time(0);
+	struct tm tm;
+	char old[6];
+	int wifi = U.wifi, ok = U.clock_ok, lora = U.lora;
+
+	memcpy(old, U.hhmm, sizeof(old));
+	localtime_r(&t, &tm);
+	U.clock_ok = tm.tm_year >= 124;
+	snprintf(U.hhmm, sizeof(U.hhmm), "%02d:%02d", tm.tm_hour % 100, tm.tm_min % 100);
+	U.wifi = wifi_bars();
+	U.lora = lora_on();
+	return wifi != U.wifi || ok != U.clock_ok || lora != U.lora || memcmp(old, U.hhmm, sizeof(old));
+}
+
+static void where_write(void)
+{
+	static char b[16384];
+	int n = where_text(b, sizeof(b));
+	FILE *f = fopen(WHERE ".new", "w");
+
+	if (!f)
+		return;
+	fwrite(b, 1, (size_t)n, f);
+	if (fclose(f) == 0)
+		rename(WHERE ".new", WHERE);
+}
+
+/* While a client command runs: Esc, Enter or the triangle stop it (the
+ * client asks through kbd_enter_pressed()). Other keys wait. */
+static int kbd_stop(void)
+{
+	struct pollfd p = { ev_fd, POLLIN, 0 };
+	struct ev e;
+	char buf[256];
+	int n;
+
+	while (poll(&p, 1, 0) > 0 && read(ev_fd, &e, sizeof(e)) == sizeof(e))
+		if (e.type == 1 && e.value == 1 && (e.code == KEY_ESC || e.code == KEY_ENTER || e.code == KEY_SYM_MAIN))
+			return 1;
+	if (fifo_fd >= 0 && (n = (int)read(fifo_fd, buf, sizeof(buf) - 1)) > 0) {
+		buf[n] = 0;
+		for (char *q = buf; *q; ) {
+			int code = (int)strtol(q, &q, 10);
+
+			if (code == KEY_ESC || code == KEY_ENTER || code == KEY_SYM_MAIN)
+				return 1;
+			while (*q == ' ' || *q == '\n')
+				q++;
+			if (*q && !isdigit((unsigned char)*q))
+				q++;
+		}
+	}
+	return stop != 0;
+}
+
+/* keys from a test: decimal codes, s30 Shift+A, f103 Fn+Up */
+static int fifo_keys(void)
+{
+	char buf[1024], *p = buf;
+	int n = (int)read(fifo_fd, buf, sizeof(buf) - 1);
+
+	if (n <= 0)
+		return 0;
+	buf[n] = 0;
+	fifo_used = 1;
+	while (*p) {
+		int code = 0;
+
+		while (*p == ' ' || *p == '\n')
+			p++;
+		if (!*p)
+			break;
+		K.shift = *p == 's';
+		K.fn = *p == 'f';
+		p += K.shift || K.fn;
+		while (*p >= '0' && *p <= '9')
+			code = code * 10 + *p++ - '0';
+		while (*p && *p != ' ' && *p != '\n')
+			p++;
+		if (key(code))
+			return 1;
+		K.shift = K.fn = 0;
+		redraw();
+	}
+	return 0;
+}
+
+/* the keys pressed while Write had the screen: not ours */
+static void drain_keys(void)
+{
+	struct pollfd p = { ev_fd, POLLIN, 0 };
+	struct ev e[16];
+
+	while (poll(&p, 1, 0) > 0 && read(ev_fd, e, sizeof(e)) > 0)
+		;
+}
+
+int pm3ui_main(const char *port)
+{
+	struct sigaction sa;
+	long last_dev = 0, last_read = 0;
+	int ticks = 0;
+
+	memset(&sa, 0, sizeof(sa));
+	sa.sa_handler = on_signal;
+	sigaction(SIGTERM, &sa, 0);
+	sigaction(SIGHUP, &sa, 0);
+	sigaction(SIGINT, &sa, 0);
+	fb_fd = open("/dev/fb0", O_RDWR | O_CLOEXEC);
+	ev_fd = open("/dev/input/event0", O_RDONLY | O_CLOEXEC);
+	if (fb_fd < 0 || ev_fd < 0)
+		return 1;
+	unlink(FIFO);
+	if (!mkfifo(FIFO, 0600))
+		fifo_fd = open(FIFO, O_RDWR | O_NONBLOCK | O_CLOEXEC);
+	pm3ui_kbd = kbd_stop;
+	status_read();
+	cards_load();
+	dicts_load();
+	busy("PROXMARK3", "Connecting\xe2\x80\xa6");
+	be_init(port);
+	be_device(&O.dev);
+	log_add(O.dev.present ? "Proxmark3 connected" : "No Proxmark3", !O.dev.present);
+	redraw();
+	while (!stop) {
+		struct pollfd p[2];
+		int np = 0, k, draw = 0, quit = 0;
+		long now;
+
+		p[np].fd = ev_fd;
+		p[np++].events = POLLIN;
+		if (fifo_fd >= 0) {
+			p[np].fd = fifo_fd;
+			p[np++].events = POLLIN;
+		}
+		k = poll(p, (nfds_t)np, CK.running ? 0 : 200);
+		now = now_ms();
+		if (wb_scene_turned())
+			draw = 1;
+		if (CK.running && O.sc == SC_CHECK && !O.pop) {
+			check_step();
+			draw = 1;
+		}
+		if (now - last_dev >= 2000 && !CK.running) {
+			last_dev = now;
+			if (be_device(&O.dev)) {
+				log_add(O.dev.present ? "Proxmark3 connected" : "Proxmark3 gone", !O.dev.present);
+				draw = 1;
+			}
+		}
+		if (now - last_read >= 1000) {
+			last_read = now;
+			if (++ticks % 5 == 0 && status_read())
+				draw = 1;
+		}
+		if (k > 0 && fifo_fd >= 0 && np > 1 && (p[1].revents & POLLIN)) {
+			quit = fifo_keys();
+			draw = 1;
+		}
+		if (k > 0 && (p[0].revents & POLLIN)) {
+			struct ev evs[16];
+			int got = (int)read(ev_fd, evs, sizeof(evs)) / (int)sizeof(evs[0]);
+
+			for (int q = 0; q < got && !quit; q++) {
+				const struct ev e = evs[q];
+
+				if (e.type != 1)
+					continue;
+				if (e.code == KEY_LEFTSHIFT || e.code == KEY_RIGHTSHIFT)
+					K.shift = e.value != 0;
+				else if (e.code == KEY_FN)
+					K.fn = e.value != 0;
+				else if (key_acts(e.code, e.value) && !(e.value == 2 && key_stale(e.sec, e.usec))) {
+					int was = O.sc;
+
+					quit = key(e.code);
+					draw = 1;
+					if (was == SC_DICT || O.sc == SC_DICT)
+						drain_keys();	/* Write may have had the screen */
+				}
+			}
+		}
+		if (quit)
+			break;
+		if (draw) {
+			redraw();
+			if (fifo_used)
+				where_write();
+		}
+	}
+	finish();
+	pm3ui_kbd = 0;
+	if (fifo_fd >= 0)
+		unlink(FIFO);
+	return 0;
+}
+#endif
