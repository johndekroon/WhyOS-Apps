+/* the lists Check keys uses for MIFARE Classic: the built-in mfc_ ones and
+ * every list of the user's, when on */
+static int dicts_for_mfc(const char **paths, int max, int *keys)
+{
+	int n = 0;
+
+	*keys = 0;
+	for (int i = 0; i < n_dicts && n < max; i++)
+		if (dicts[i].on && (!dicts[i].builtin || !strncmp(dicts[i].name, "mfc_", 4))) {
+			paths[n++] = dicts[i].path;
+			*keys += dicts[i].count > 0 ? dicts[i].count : 0;
+		}
+	return n;
+}
