+/* a command's text with the card's things filled in */
+static void expand(const char *t, char *o, int n, const char *dump)
+{
+	int k = 0;
+
+	for (; *t && k < n - 1; t++) {
+		const char *v = 0;
+		char u[48];
+
+		if (*t == '%' && t[1]) {
+			t++;
+			if (*t == 'U') {
+				uid_hex(O.card.uid, u, sizeof(u));
+				v = u;
+			} else if (*t == 'S') {
+				v = mfc_size_flag(O.card.sectors);
+			} else if (*t == 'F') {
+				v = dump && dump[0] ? dump : "<dump file>";
+			}
+		}
+		if (v) {
+			int l = snprintf(o + k, (size_t)(n - k), "%s", v);
+
+			k += l < n - k ? l : n - k - 1;
+		} else {
+			o[k++] = *t;
+		}
+	}
+	o[k] = 0;
+}
