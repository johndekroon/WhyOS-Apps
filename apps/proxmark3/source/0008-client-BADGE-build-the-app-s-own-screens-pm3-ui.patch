+/* The saved card with this UID on this band, made (newest first) when
+ * there was none. */
+static struct saved *card_save(const struct pm3_card *c)
+{
+	struct saved s;
+	int i;
+
+	for (i = 0; i < n_cards; i++)
+		if (cards[i].c.band == c->band && !strcmp(cards[i].c.uid, c->uid))
+			break;
+	if (i < n_cards) {
+		s = cards[i];
+		memmove(cards + 1, cards, sizeof(cards[0]) * (size_t)i);
+	} else {
+		memset(&s, 0, sizeof(s));
+		snprintf(s.detail, sizeof(s.detail), "ID only");
+		if (n_cards == CARDS_MAX)
+			n_cards--;
+		memmove(cards + 1, cards, sizeof(cards[0]) * (size_t)n_cards);
+		n_cards++;
+	}
+	s.c = *c;
+	s.c.found = 1;
+	s.t = (long)time(0);
+	cards[0] = s;
+	return &cards[0];
+}
