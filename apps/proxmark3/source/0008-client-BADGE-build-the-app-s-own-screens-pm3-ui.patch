+/* ---- dictionaries ----------------------------------------------------------------------- */
+
+static void open_in_write(const char *path)
+{
+#ifdef PM3UI_HOST
+	char b[300];
+
+	snprintf(b, sizeof(b), "Write: %s", path);
+	log_add(b, 0);
+	notice("Opened in Write", 0);
+#else
+	static const char dir[] = "/data/apps/write";
+	char exe[64], cfg[96], old_id[64] = "", old_dir[200] = "", old_cfg[200] = "";
+	const char *e;
+	pid_t pid;
+	int status;
+
+	snprintf(exe, sizeof(exe), "%s/write", dir);
+	if (access(exe, X_OK)) {
+		notice("Write is not on this badge", 1);
+		return;
+	}
+	if ((e = getenv("APP_ID")))
+		snprintf(old_id, sizeof(old_id), "%s", e);
+	if ((e = getenv("APP_DIR")))
+		snprintf(old_dir, sizeof(old_dir), "%s", e);
+	if ((e = getenv("APP_CONFIG")))
+		snprintf(old_cfg, sizeof(old_cfg), "%s", e);
+	snprintf(cfg, sizeof(cfg), "%s/.whyos/config/write", home());
+	mkdir(cfg, 0755);
+	setenv("APP_ID", "write", 1);
+	setenv("APP_DIR", dir, 1);
+	setenv("APP_CONFIG", cfg, 1);
+	pid = vfork();
+	if (pid == 0) {
+		execl(exe, "write", path, (char *)0);
+		_exit(127);
+	}
+	setenv("APP_ID", old_id, 1);
+	setenv("APP_DIR", old_dir, 1);
+	setenv("APP_CONFIG", old_cfg, 1);
+	if (pid < 0) {
+		notice("Could not start Write", 1);
+		return;
+	}
+	while (waitpid(pid, &status, 0) < 0 && errno == EINTR)
+		;
+	wb_rec_invalidate();
+	log_add("Write closed", 0);
+#endif
+}
+
+static int dict_user(int i)
+{
+	return i >= 0 && i < n_dicts && !dicts[i].builtin;
+}
+
+static void dict_new(const char *name)
+{
+	char dir[256], path[400];
+	FILE *f;
+
+	user_dict_dir(dir, sizeof(dir));
+	snprintf(path, sizeof(path), "%s/%s.dic", dir, name);
+	if (!access(path, F_OK)) {
+		notice("A list with that name exists", 1);
+		return;
+	}
+	if (!(f = fopen(path, "w"))) {
+		notice("Could not make the list", 1);
+		return;
+	}
+	fprintf(f, "# %s: keys for Check keys\n# one key per line, 12 hex digits\n", name);
+	fclose(f);
+	open_in_write(path);
+	dicts_load();
+	for (int i = 0; i < n_dicts; i++)
+		if (!strcmp(dicts[i].path, path))
+			O.focus = i;
+}
+
+static void dict_copy(int i)
+{
+	char dir[256], path[400], line[128], name[64];
+	FILE *in, *out;
+
+	snprintf(name, sizeof(name), "%s", dicts[i].name);
+	user_dict_dir(dir, sizeof(dir));
+	snprintf(path, sizeof(path), "%s/my_%s", dir, name);
+	if (!(in = fopen(dicts[i].path, "r")))
+		return;
+	if (!(out = fopen(path, "w"))) {
+		fclose(in);
+		notice("Could not copy the list", 1);
+		return;
+	}
+	while (fgets(line, sizeof(line), in))
+		fputs(line, out);
+	fclose(in);
+	fclose(out);
+	dicts_load();
+	notice("Copied to your lists", 0);
+}
+
+/* the card's keys added to a list of the user's, without the ones it has */
+static void keys_to_dict(const char *path)
+{
+	char line[64], have[PM3UI_SECTORS * 2][13];
+	int nh = 0, added = 0;
+	FILE *f = fopen(path, "r");
+
+	if (f) {
+		while (fgets(line, sizeof(line), f) && nh < PM3UI_SECTORS * 2) {
+			uid_hex(line, have[nh], sizeof(have[0]));
+			nh += line[0] != '#' && strlen(have[nh]) == 12;
+		}
+		fclose(f);
+	}
+	if (!(f = fopen(path, "a"))) {
+		notice("Could not write the list", 1);
+		return;
+	}
+	for (int s = 0; s < V.k.sectors; s++)
+		for (int t = 0; t < 2; t++) {
+			char k[13];
+			int dup = 0;
+
+			if (!V.k.found[s][t])
+				continue;
+			for (int i = 0; i < 6; i++)
+				snprintf(k + i * 2, 3, "%02X", V.k.key[s][t][i]);
+			for (int j = 0; j < nh; j++)
+				dup |= !strcmp(have[j], k);
+			if (dup)
+				continue;
+			if (nh < PM3UI_SECTORS * 2)
+				strcpy(have[nh++], k);
+			fprintf(f, "%s\n", k);
+			added++;
+		}
+	fclose(f);
+	dicts_load();
+	snprintf(line, sizeof(line), added == 1 ? "1 key added" : "%d keys added", added);
+	notice(line, 0);
+}
