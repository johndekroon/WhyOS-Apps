+
+static void draw_check(void)
+{
+	static const struct hint running[] = { { "#1", "options", 0 }, { "Esc", "cancel", 1 } };
+	static const struct hint done[] = { { "#1", "options", 0 }, { "#2", "dump", 0 }, { "Esc", "back", 1 } };
+	int sectors = CK.k.sectors ? CK.k.sectors : 16, rows = (sectors + 7) / 8, big = sectors <= 16;
+	int cw = (XW - 7 * 8) / 8, ch = big ? 76 : 40, gy = 206, py, dy, dh, x;
+	int first_missing = -1;
+	char b[64], v[32];
+
+	header("PROXMARK3 \xe2\x80\xba", "MIFARE keys");
+	if (CK.running) {
+		snprintf(b, sizeof(b), "Checking keys \xc2\xb7 %d %%", CK.permille / 10);
+		text(&f_ui18, W - X0 - text_w(&f_ui18, b, 0), text_top(&f_ui18, HEAD_CY), b, WB_COLOR_TEXT_MID, 0);
+	} else if (CK.err) {
+		head_right(WB_COLOR_ERROR, "The card went", WB_COLOR_TEXT_MID, 0);
+	} else if (CK.cancelled) {
+		head_right(0, "Cancelled", WB_COLOR_TEXT_MID, 0);
+	} else if (CK.done) {
+		head_right(ck_found_keys() == sectors * 2 ? WB_COLOR_OK : WB_COLOR_WARN,
+			   ck_found_keys() == sectors * 2 ? "All keys found" : "All sectors checked", WB_COLOR_TEXT_MID, 0);
+	}
+	snprintf(v, sizeof(v), CK.nlists == 1 ? "%d \xc2\xb7 1 list" : "%d \xc2\xb7 %d lists", CK.nkeys, CK.nlists);
+	x = chip(X0, 156, "Keys", v);
+	x = chip(x, 156, "Runs", "on Proxmark3");
+	chip(x, 156, "Card", CK.uid);
+	for (int s = 0; s < sectors && first_missing < 0; s++)
+		if (!CK.k.found[s][0] || !CK.k.found[s][1])
+			first_missing = s;
+	for (int s = 0; s < sectors; s++) {
+		int cx = X0 + (s % 8) * (cw + 8), cy = gy + (s / 8) * (ch + 8), sel = s == CK.sel;
+		int any = CK.k.found[s][0] || CK.k.found[s][1];
+		uint32_t nc = sel ? WB_COLOR_CYAN : any || (CK.running && s == first_missing) ? WB_COLOR_TEXT_HI :
+			      WB_COLOR_TEXT_LOW;
+
+		snprintf(b, sizeof(b), "%02d", s);
+		wb_card(cx, cy, cw, ch, 4, sel, &GLOW_FOCUS);
+		if (CK.running && s == first_missing && !sel)
+			dashed(cx, cy, cw, ch, WB_COLOR_CYAN, 255);
+		if (big) {
+			text(&f_mono14, cx + 10, cy + 8, b, nc, 0);
+			for (int t = 0; t < 2; t++) {
+				int dx = cx + 10 + t * 30, dyy = cy + ch - 18;
+
+				if (CK.k.found[s][t])
+					box(dx, dyy, 8, 8, 2, WB_COLOR_OK, 255, 0, 0, 0);
+				else
+					box(dx, dyy, 8, 8, 2, 0, 0, WB_COLOR_TEXT_LOW, 2, 0);
+				text(&f_mono13, dx + 11, text_top(&f_mono13, dyy + 4), t ? "B" : "A", WB_COLOR_TEXT_MID, 0);
+			}
+		} else {
+			text(&f_mono13, cx + 8, text_top(&f_mono13, cy + ch / 2), b, nc, 0);
+			for (int t = 0; t < 2; t++) {
+				int dx = cx + cw - 30 + t * 12, dyy = cy + ch / 2 - 4;
+
+				if (CK.k.found[s][t])
+					box(dx, dyy, 8, 8, 2, WB_COLOR_OK, 255, 0, 0, 0);
+				else
+					box(dx, dyy, 8, 8, 2, 0, 0, WB_COLOR_TEXT_LOW, 2, 0);
+			}
+		}
+	}
+	py = gy + rows * (ch + 8) - 8 + 22;
+	snprintf(b, sizeof(b), "%d of %d sectors", ck_full_sectors(), sectors);
+	text(&f_mono13, X0, py, b, WB_COLOR_TEXT_MID, 0);
+	snprintf(b, sizeof(b), "%d of %d keys found", ck_found_keys(), sectors * 2);
+	text(&f_mono13, X0 + XW - text_w(&f_mono13, b, 0), py, b, WB_COLOR_TEXT_MID, 0);
+	box(X0, py + 25, XW, 6, 3, WB_COLOR_LINE, 255, 0, 0, 0);
+	{
+		int pm = CK.running ? CK.permille : CK.done ? 1000 : CK.permille, w = XW * pm / 1000;
+
+		if (w > 0)
+			box(X0, py + 25, w < 6 ? 6 : w, 6, 3, WB_COLOR_CYAN, 255, 0, 0, 0);
+	}
+	dy = py + 48;
+	dh = BOTTOM - 16 - dy;
+	if (dh > 218)
+		dh = 218;
+	wb_card(X0, dy, XW, dh, 4, 0, 0);
+	{
+		int s = CK.sel, fblk = mfc_first_block(s), nb = mfc_blocks(s), ry = dy + 16;
+		static const char *const kn[2] = { "Key A", "Key B" };
+
+		snprintf(b, sizeof(b), "Sector %d", s);
+		text(&f_ui22, X0 + 20, text_top(&f_ui22, ry + 14), b, WB_COLOR_TEXT_HI, 0);
+		snprintf(b, sizeof(b), "blocks %d\xe2\x80\x93%d \xc2\xb7 trailer %d", fblk, fblk + nb - 1, fblk + nb - 1);
+		text(&f_mono13, X0 + XW - 20 - text_w(&f_mono13, b, 0), text_top(&f_mono13, ry + 16), b, WB_COLOR_TEXT_LOW, 0);
+		ry += 38;
+		fill(X0 + 20, ry, XW - 40, 1, WB_COLOR_LINE);
+		ry += 10;
+		for (int t = 0; t < 2 && ry + 34 <= dy + dh; t++, ry += 44) {
+			int rx = X0 + XW - 20 - 9;
+
+			text(&f_ui18, X0 + 20, text_top(&f_ui18, ry + 17), kn[t], WB_COLOR_TEXT_MID, 0);
+			if (CK.k.found[s][t]) {
+				hex_spaced(CK.k.key[s][t], 6, b, sizeof(b));
+				box(rx, ry + 13, 9, 9, 2, WB_COLOR_OK, 255, 0, 0, 0);
+				rx -= 12 + text_w(&f_mono18, b, 0);
+				text(&f_mono18, rx, text_top(&f_mono18, ry + 17), b, WB_COLOR_TEXT_HI, 0);
+			} else {
+				const char *w = CK.running ? "checking" : "not found";
+
+				box(rx, ry + 13, 9, 9, 2, 0, 0, WB_COLOR_TEXT_LOW, 2, 0);
+				rx -= 12 + text_w(&f_mono14, w, 0);
+				text(&f_mono14, rx, text_top(&f_mono14, ry + 17), w, WB_COLOR_TEXT_LOW, 0);
+			}
+		}
+		if (ry + 34 <= dy + dh) {
+			int rx = X0 + XW - 20;
+
+			text(&f_ui18, X0 + 20, text_top(&f_ui18, ry + 17), "Access bits", WB_COLOR_TEXT_MID, 0);
+			if (CK.have_trailer[s]) {
+				const uint8_t *tr = CK.trailer[s];
+				int transport = tr[6] == 0xFF && tr[7] == 0x07 && tr[8] == 0x80;
+
+				hex_spaced(tr + 6, 4, b, sizeof(b));
+				rx -= text_w(&f_mono18, b, 0);
+				text(&f_mono18, rx, text_top(&f_mono18, ry + 17), b, WB_COLOR_TEXT_HI, 0);
+				rx -= 12 + text_w(&f_mono13, transport ? "transport" : "custom", 0);
+				text(&f_mono13, rx, text_top(&f_mono13, ry + 17), transport ? "transport" : "custom",
+				     WB_COLOR_TEXT_LOW, 0);
+			} else {
+				const char *w = CK.k.found[s][0] || CK.k.found[s][1] ? "not read yet" : "needs a key";
+
+				rx -= text_w(&f_mono14, w, 0);
+				text(&f_mono14, rx, text_top(&f_mono14, ry + 17), w, WB_COLOR_TEXT_LOW, 0);
+			}
+		}
+	}
+	if (CK.running)
+		hints(running, 2);
+	else
+		hints(done, 3);
+}
+
+/* ---- a command's output ------------------------------------------------------------------ */
+
+/* the line'th line of a text, its length in *len */
+static const char *nth_line(const char *t, int line, int *len)
+{
+	for (int i = 0; i < line && t; i++) {
+		t = strchr(t, '\n');
+		if (t)
+			t++;
+	}
+	if (!t || !*t) {
+		*len = 0;
+		return "";
+	}
+	*len = (int)strcspn(t, "\n");
+	return t;
+}
+
+static uint32_t line_colour(const char *s)
+{
+	if (!strncmp(s, "[+]", 3))
+		return WB_COLOR_OK;
+	if (!strncmp(s, "[!!]", 4) || !strncmp(s, "[-]", 3))
+		return WB_COLOR_ERROR;
+	if (!strncmp(s, "[!]", 3))
+		return WB_COLOR_WARN;
+	if (!strncmp(s, "[=]", 3) || !strncmp(s, "[?]", 3) || !strncmp(s, "[#]", 3))
+		return WB_COLOR_TEXT_MID;
+	return WB_COLOR_TEXT_HI;
+}
+
+#define OUT_LH		18
+#define OUT_COLS	74
+
+/* lines of output in a console box: first..first+rows */
+static void out_lines(int x, int y, int rows, int (*get)(int, char *, int), int first)
+{
+	char b[CON_COLS + 1];
+
+	for (int i = 0; i < rows; i++) {
+		int n = get(first + i, b, sizeof(b));
+
+		if (n < 0)
+			break;
+		if (!strncmp(b, "pm3 --> ", 8)) {
+			int ex = text(&f_mono14, x, y + i * OUT_LH, "pm3 -->", WB_COLOR_PINK, 0);
+
+			text(&f_mono14, ex + 9, y + i * OUT_LH, b + 8, WB_COLOR_TEXT_HI, 0);
+			continue;
+		}
+		text(&f_mono14, x, y + i * OUT_LH, b, line_colour(b), 0);
+	}
+}
+
+static int r_get(int i, char *o, int n)
+{
+	int len;
+	const char *s;
+
+	if (i >= R.lines || !R.text)
+		return -1;
+	s = nth_line(R.text, i, &len);
+	if (len > n - 1)
+		len = n - 1;
+	if (len > OUT_COLS)
+		len = OUT_COLS;
+	memcpy(o, s, (size_t)len);
+	o[len] = 0;
+	return len;
+}
+
+static int r_rows(void)
+{
+	return (BOTTOM - 12 - 150 - 24) / OUT_LH;
+}
+
+static void draw_result(void)
+{
+	static const struct hint hs[] = { { "#1", "options", 0 }, { "#2", "run again", 0 }, { "Esc", "back", 1 } };
+	int rows = r_rows();
+
+	header(R.eb, R.title);
+	console_box(X0, 150, XW - 12, BOTTOM - 12 - 150);
+	if (!R.lines)
+		text(&f_mono14, X0 + 12, 162, "No output.", WB_COLOR_TEXT_LOW, 0);
+	out_lines(X0 + 12, 162, rows, r_get, R.scroll);
+	scrollbar(W - X0 - 4, 150, BOTTOM - 12 - 150, R.lines, rows, R.scroll);
+	hints(hs, 3);
+}
