+    def test_iclass_dump_to_cards(self):
+        # HF › iCLASS › Dump types the command in the Console; run, it is in Cards
+        w = self.a.run("\\n" + "\\d" * 7 + "\\n\\d\\d\\n")
+        self.assertEqual(w["input"], "hf iclass dump --ki 0")
+        w = self.a.run("\\n" + "\\d" * 7 + "\\n\\d\\d\\n\\n")
+        self.assertEqual(w["cards"], "1 01 02 03 04 05 06 07 08|dump · 32 blocks")
+        self.assertIn("Saved to Cards", w["notice"])
+        w = self.a.run("\\r\\r\\n\\n", "card-iclass")
+        self.assertEqual(w["screen"].strip(), "card")
+        self.assertEqual(w["view"], "32")
+        # no MIFARE keys; Simulate and Write type their iCLASS commands
+        w = self.a.run("\\r\\r\\n\\n\\1")
+        self.assertEqual(w["menu"], "|Simulate |Write to a card |Delete")
+        w = self.a.run("\\r\\r\\n\\n\\1\\d\\n")
+        self.assertTrue(w["input"].startswith("hf iclass restore -f "), w["input"])
+        self.assertTrue(w["input"].endswith("hf-iclass-0102030405060708-dump.bin --first 6 --last 31 --ki 0"))
+        # the triangle loads it into the emulator memory
+        w = self.a.run("\\r\\r\\n\\n\\2")
+        self.assertIn("emulator memory", w["notice"])
+
     def test_dictionary(self):
         w = self.a.run("\\d\\n", "dict")
         self.assertIn("mfc_default_keys.dic:2509:1", w["dicts"])
