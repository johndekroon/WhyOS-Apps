+/* a dump's block: MIFARE Classic 16 bytes, iCLASS 8; other dumps as rows
+ * of 16 bytes */
+static int card_bs(const struct saved *s)
+{
+	return s->c.fam == FAM_ICLASS ? 8 : 16;
+}
+
+/* the dumps the Proxmark3 can load into its emulator memory */
+static int card_loads(const struct saved *s)
+{
+	return s->c.fam == FAM_MFC || s->c.fam == FAM_ICLASS;
+}
+
+/* an iCLASS dump: the blocks before the application, then the rest */
+static void draw_card_iclass(int tx, int ty, int rows)
+{
+	static const char *const tags[] = { "CSN", "config", "e-purse", "Kd", "Kc", "AIA" };
+
+	text(&f_mono13, tx, text_top(&f_mono13, 198 + 16), "BLK", WB_COLOR_TEXT_LOW, 16);
+	text(&f_mono13, tx + 48, text_top(&f_mono13, 198 + 16), "DATA", WB_COLOR_TEXT_LOW, 16);
+	fill(X0 + 1, 198 + 32, XW - 14, 1, WB_COLOR_LINE);
+	for (int i = 0; i < rows && V.scroll + i < V.blocks; i++) {
+		int b = V.scroll + i, cy = ty + i * DUMP_LH + DUMP_LH / 2;
+		uint32_t hc = b == 3 || b == 4 ? WB_COLOR_TEXT_MID : WB_COLOR_TEXT_HI;
+		char hx[64];
+
+		if (b == 6 && i)
+			fill(tx, ty + i * DUMP_LH, XW - 12 - 32, 1, WB_COLOR_LINE);
+		snprintf(hx, sizeof(hx), "%02d", b);
+		text(&f_mono14, tx, text_top(&f_mono14, cy), hx, WB_COLOR_TEXT_LOW, 0);
+		hex_spaced(V.data + b * 8, 8, hx, sizeof(hx));
+		text(&f_mono14, tx + 48, text_top(&f_mono14, cy), hx, hc, 0);
+		if (b < 6)
+			text(&f_mono13, X0 + XW - 12 - 14 - text_w(&f_mono13, tags[b], 0), text_top(&f_mono13, cy), tags[b],
+			     b == 3 || b == 4 ? WB_COLOR_CYAN : WB_COLOR_TEXT_LOW, 0);
+	}
+}
+
+/* another dump: its bytes, 16 to a row, with the offset */
+static void draw_card_bytes(int tx, int ty, int rows)
+{
+	text(&f_mono13, tx, text_top(&f_mono13, 198 + 16), "OFFS", WB_COLOR_TEXT_LOW, 16);
+	text(&f_mono13, tx + 48 + 38, text_top(&f_mono13, 198 + 16), "DATA", WB_COLOR_TEXT_LOW, 16);
+	fill(X0 + 1, 198 + 32, XW - 14, 1, WB_COLOR_LINE);
+	for (int i = 0; i < rows && V.scroll + i < V.blocks; i++) {
+		int b = V.scroll + i, cy = ty + i * DUMP_LH + DUMP_LH / 2, x;
+		char hx[64];
+
+		snprintf(hx, sizeof(hx), "%03X", b * 16);
+		text(&f_mono14, tx, text_top(&f_mono14, cy), hx, WB_COLOR_TEXT_LOW, 0);
+		hex_spaced(V.data + b * 16, 8, hx, sizeof(hx));
+		x = text(&f_mono14, tx + 48 + 38, text_top(&f_mono14, cy), hx, WB_COLOR_TEXT_HI, 0);
+		hex_spaced(V.data + b * 16 + 8, 8, hx, sizeof(hx));
+		text(&f_mono14, x + 14, text_top(&f_mono14, cy), hx, WB_COLOR_TEXT_HI, 0);
+	}
+}
