@@ -10,6 +10,7 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#include <sys/stat.h>
 
 #include "pm3ui.h"
 
@@ -68,7 +69,26 @@ int be_command(const char *cmd)
 			 "[=] --- Keys Information\n[+] loaded 2 user keys\n[+] loaded 61 hardcoded keys\n"
 			 "[+] Backdoor key..... A396EFA4E24F\n\n[=] --- Magic Tag Information\n"
 			 "[+] Magic capabilities... Gen 1a\n\n[=] --- PRNG Information\n[+] Prng....... weak\n");
-	else if (!strncmp(cmd, "hf mf eload", 11))
+	else if (!strncmp(cmd, "hf iclass dump", 14)) {
+		/* as the client: the file in ~/.proxmark3/dumps, its path in colour */
+		char path[256];
+		unsigned char d[256] = { 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x12, 0xFF, 0xFF, 0xFF, 0x7F,
+					 0x1F, 0xFF, 0x3C };
+		FILE *f;
+
+		snprintf(path, sizeof(path), "%s/.proxmark3", getenv("HOME"));
+		mkdir(path, 0755);
+		snprintf(path, sizeof(path), "%s/.proxmark3/dumps", getenv("HOME"));
+		mkdir(path, 0755);
+		snprintf(path, sizeof(path), "%s/.proxmark3/dumps/hf-iclass-0102030405060708-dump.bin", getenv("HOME"));
+		if ((f = fopen(path, "wb"))) {
+			fwrite(d, 1, sizeof(d), f);
+			fclose(f);
+		}
+		snprintf(out, sizeof(out),
+			 "[+] Saved \x1b[33m256\x1b[0m bytes to binary file `\x1b[33m%s\x1b[0m`\n"
+			 "[+] Saved to json file \x1b[33m%.*s.json\x1b[0m\n", path, (int)strlen(path) - 4, path);
+	} else if (!strncmp(cmd, "hf mf eload", 11))
 		snprintf(out, sizeof(out), "[=] 64 blocks ( 1024 bytes ) to upload\n[+] Done!\n");
 	else
 		snprintf(out, sizeof(out), "[=] sim: %s\n[+] done\n", cmd);
