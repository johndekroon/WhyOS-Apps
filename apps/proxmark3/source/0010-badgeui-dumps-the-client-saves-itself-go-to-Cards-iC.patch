 	busy(eb, "Running\xe2\x80\xa6");
 	be_command(cmd);
 	out = be_output();
+	dump_saved(out);
 	log_add(cmd, 0);
 	{
 		char b[200];
@@ -2372,7 +2531,7 @@ static void open_card(int i)
 	V.blocks = 0;
 	V.have_keys = 0;
 	if (s->dump[0] && (n = load_bin(s->dump, V.data, sizeof(V.data))) > 0)
-		V.blocks = n / 16;
+		V.blocks = (n + card_bs(s) - 1) / card_bs(s);
 	if (s->keys[0] && keys_load(s->keys, &V.k, s->c.sectors ? s->c.sectors : 16) == 0)
 		V.have_keys = 1;
 	O.card = s->c;
@@ -2603,15 +2762,19 @@ static void menu_build(int what)
 	case M_CARDS:
 		menu_open(what, "CARDS", cards[O.focus].c.type);
 		menu_add("Open");
-		menu_add("Keys");
+		if (cards[O.focus].c.fam == FAM_MFC)
+			menu_add("Keys");
 		menu_add("Delete")->danger = 1;
 		menu_it[menu_n - 1].sep = 1;
 		break;
 	case M_CARD:
 		menu_open(what, "CARDS", cards[V.i].c.type);
-		menu_add("Keys");
-		menu_add("Simulate");
-		menu_add("Write to a card");
+		if (cards[V.i].c.fam == FAM_MFC)
+			menu_add("Keys");
+		if (card_loads(&cards[V.i])) {
+			menu_add("Simulate");
+			menu_add("Write to a card");
+		}
 		menu_add("Delete")->danger = 1;
 		menu_it[menu_n - 1].sep = 1;
 		break;
@@ -2739,12 +2902,20 @@ static void menu_done(int i)
 		} else if (!strcmp(l, "Simulate")) {
 			char cmd[200];
 
-			expand("hf mf sim %S -u %U", cmd, sizeof(cmd), 0);
+			/* iCLASS: the dump in the emulator memory (the triangle loads it) */
+			expand(cards[V.i].c.fam == FAM_ICLASS ? "hf iclass sim -t 3" : "hf mf sim %S -u %U", cmd, sizeof(cmd), 0);
 			console_typed(cmd);
 		} else if (!strcmp(l, "Write to a card")) {
-			if (!V.blocks)
+			if (!V.blocks) {
 				notice("No dump to write", 1);
-			else
+			} else if (cards[V.i].c.fam == FAM_ICLASS) {
+				char cmd[300];
+
+				/* the application's blocks, with the key to edit */
+				snprintf(cmd, sizeof(cmd), "hf iclass restore -f %s --first 6 --last %d --ki 0", cards[V.i].dump,
+					 V.blocks - 1);
+				console_typed(cmd);
+			} else
 				confirm(CF_RESTORE, "WRITE TO A CARD", "Write this dump to the card on the Proxmark3?", "Write", 0);
 		} else {
 			confirm(CF_DELETE_CARD, "CARDS", "Delete this card?", "Delete", 1);
@@ -3131,7 +3302,7 @@ static void card_key(int code)
 		V.scroll = V.scroll + rows < max ? V.scroll + rows : max;
 	else if (code == KEY_SYM_MENU)
 		menu_build(M_CARD), O.pop = POP_MENU;
-	else if (code == KEY_SYM_MAIN && V.blocks) {
+	else if (code == KEY_SYM_MAIN && V.blocks && card_loads(&cards[V.i])) {
 		char cmd[300];
 		const struct saved *s = &cards[V.i];
 
@@ -3139,7 +3310,10 @@ static void card_key(int code)
 			need_pm3();
 			return;
 		}
-		snprintf(cmd, sizeof(cmd), "hf mf eload %s -f %s", mfc_size_flag(s->c.sectors), s->dump);
+		if (s->c.fam == FAM_ICLASS)
+			snprintf(cmd, sizeof(cmd), "hf iclass eload -f %s", s->dump);
+		else
+			snprintf(cmd, sizeof(cmd), "hf mf eload %s -f %s", mfc_size_flag(s->c.sectors), s->dump);
 		busy("CARDS", "Loading into the Proxmark3\xe2\x80\xa6");
 		run_command(cmd);
 		notice("In the Proxmark3's emulator memory: Simulate uses it", 0);
diff --git a/client/src/badgeui/pm3ui_sim.c b/client/src/badgeui/pm3ui_sim.c
