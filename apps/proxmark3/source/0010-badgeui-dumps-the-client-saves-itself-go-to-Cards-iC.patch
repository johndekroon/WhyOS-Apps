+/* ---- dumps the client saved itself ------------------------------------------------------- */
+
+/*
+ * A dump command typed in the Console or run as an action (hf iclass dump,
+ * hf mf dump, hf mfu dump, hf 15 dump) saves its file itself and says so:
+ * "Saved 256 bytes to binary file `.../hf-iclass-<CSN>-dump.bin`". That
+ * file goes to Cards: on the card searched last when the name has its
+ * UID, else on the card the name says (hf-<type>-<UID>-dump).
+ */
+static const struct { const char *tag; int fam; } dump_tags[] = {
+	{ "iclass", FAM_ICLASS }, { "mf", FAM_MFC }, { "mfu", FAM_MFU }, { "15", FAM_15 },
+};
+
+static void dump_saved(const char *out)
+{
+	static const char said[] = "to binary file `";
+	const char *p = out;
+
+	while ((p = strstr(p, said))) {
+		char path[160], tag[16], u[48], cu[48];
+		const char *base, *dash;
+		struct pm3_card c;
+		struct saved *s;
+		struct stat st;
+		int k = 0, fam = -1;
+
+		/* the path, without the colour codes around it */
+		for (p += sizeof(said) - 1; *p && *p != '`' && *p != '\n' && k < (int)sizeof(path) - 1; p++) {
+			if (*p == '\x1b') {
+				while (p[1] && !isalpha((unsigned char)*p))
+					p++;
+				continue;
+			}
+			path[k++] = *p;
+		}
+		path[k] = 0;
+		base = strrchr(path, '/') ? strrchr(path, '/') + 1 : path;
+		if (strncmp(base, "hf-", 3) || !strstr(base, "-dump") || stat(path, &st) || st.st_size <= 0)
+			continue;
+		dash = strchr(base + 3, '-');
+		if (!dash || dash - base - 3 >= (int)sizeof(tag))
+			continue;
+		snprintf(tag, sizeof(tag), "%.*s", (int)(dash - base - 3), base + 3);
+		for (size_t i = 0; i < sizeof(dump_tags) / sizeof(dump_tags[0]); i++)
+			if (!strcmp(tag, dump_tags[i].tag))
+				fam = dump_tags[i].fam;
+		k = 0;
+		for (const char *q = dash + 1; isxdigit((unsigned char)*q) && k < (int)sizeof(u) - 1; q++)
+			u[k++] = (char)toupper((unsigned char)*q);
+		u[k] = 0;
+		if (fam < 0 || k < 8 || k % 2)
+			continue;
+		uid_hex(O.card.uid, cu, sizeof(cu));
+		if (O.card.found && O.card.band == BAND_HF && !strcmp(cu, u)) {
+			c = O.card;
+		} else {
+			/* the UID spaced, as a search writes it */
+			memset(&c, 0, sizeof(c));
+			c.found = 1;
+			c.band = BAND_HF;
+			c.fam = fam;
+			c.sak = -1;
+			snprintf(c.type, sizeof(c.type), "%s", hf_fams[fam]);
+			for (int i = 0, n = 0; u[i] && n < (int)sizeof(c.uid) - 3; i += 2)
+				n += snprintf(c.uid + n, sizeof(c.uid) - (size_t)n, i ? " %.2s" : "%.2s", u + i);
+			for (int i = 0; i < n_cards; i++) {
+				uid_hex(cards[i].c.uid, cu, sizeof(cu));
+				if (cards[i].c.band == BAND_HF && !strcmp(cu, u))
+					c = cards[i].c;
+			}
+		}
+		if (c.fam == FAM_MFC && !c.sectors)
+			c.sectors = st.st_size <= 320 ? 5 : st.st_size <= 1024 ? 16 : st.st_size <= 2048 ? 32 : 40;
+		s = card_save(&c);
+		snprintf(s->dump, sizeof(s->dump), "%s", path);
+		if (c.fam == FAM_MFC)
+			snprintf(s->detail, sizeof(s->detail), "dump \xc2\xb7 %s", mfc_size_text(c.sectors));
+		else if (c.fam == FAM_ICLASS)
+			snprintf(s->detail, sizeof(s->detail), "dump \xc2\xb7 %ld blocks", (long)st.st_size / 8);
+		else
+			snprintf(s->detail, sizeof(s->detail), "dump \xc2\xb7 %ld bytes", (long)st.st_size);
+		cards_save();
+		log_add("dump: saved to Cards", 0);
+		notice("Saved to Cards", 0);
+	}
+}
+
 static void run_command(const char *cmd)
 {
 	char b[200];
@@ -2126,6 +2283,7 @@ static void run_command(const char *cmd)
 	be_command(cmd);
 	C.running = 0;
 	con_add(be_output());
