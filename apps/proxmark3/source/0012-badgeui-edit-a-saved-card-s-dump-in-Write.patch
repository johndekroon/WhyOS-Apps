+    def test_edit_dump_in_write(self):
+        # an iCLASS dump in Cards, then Edit in Write changes block 6
+        self.a.run("\\n" + "\\d" * 7 + "\\n\\d\\d\\n\\n")
+        dump = os.path.join(self.a.home, ".proxmark3/dumps/hf-iclass-0102030405060708-dump.bin")
+        text = dump[:-4] + ".txt"
+        w = self.a.run("\\r\\r\\n\\n\\1")
+        self.assertEqual(w["menu"], "|Edit in Write |Simulate |Write to a card |Delete")
+        edit = "perl -pi -e 's/^00 00 00 00 00 00 00 00  # 6$/11 22 33 44 55 66 77 88  # 6/'"
+        w = self.a.run("\\r\\r\\n\\n\\1\\n", "edited", PM3UI_WRITE=edit)
+        self.assertEqual(w["screen"].strip(), "card")
+        self.assertIn("1 block changed", w["notice"])
+        with open(dump, "rb") as f:
+            data = f.read()
+        self.assertEqual(len(data), 256)
+        self.assertEqual(data[48:56], bytes.fromhex("1122334455667788"))
+        self.assertEqual(data[:8], bytes.fromhex("0102030405060708"))
+        self.assertFalse(os.path.exists(text))
+        # a mistake: nothing written, the text stays and opens again
+        bad = "perl -pi -e 's/^00 00 00 00 00 00 00 00  # 7$/12 34  # 7/'"
+        w = self.a.run("\\r\\r\\n\\n\\1\\n", PM3UI_WRITE=bad)
+        self.assertIn("2 bytes, a block has 8", w["notice"])
+        with open(dump, "rb") as f:
+            self.assertEqual(f.read(), data)
+        with open(text) as f:
+            self.assertIn("12 34  # 7", f.read())
+        fix = "perl -pi -e 's/^12 34  # 7$/AA BB CC DD EE FF 00 11  # 7/'"
+        w = self.a.run("\\r\\r\\n\\n\\1\\n", PM3UI_WRITE=fix)
+        self.assertIn("1 block changed", w["notice"])
+        with open(dump, "rb") as f:
+            self.assertEqual(f.read()[56:64], bytes.fromhex("AABBCCDDEEFF0011"))
+        # no change: no changes
+        w = self.a.run("\\r\\r\\n\\n\\1\\n", PM3UI_WRITE="true")
+        self.assertEqual(w["notice"], "No changes")
+
     def test_dictionary(self):
