+/* ---- a card's dump in Write ------------------------------------------------------------- */
+
+/* the dump's text next to it: hf-...-dump.bin -> hf-...-dump.txt */
+static void dump_text_path(const struct saved *s, char *o, int n)
+{
+	int l = (int)strlen(s->dump);
+
+	if (l > 4 && !strcmp(s->dump + l - 4, ".bin"))
+		snprintf(o, (size_t)n, "%.*s.txt", l - 4, s->dump);
+	else
+		snprintf(o, (size_t)n, "%s.txt", s->dump);
+}
+
+/* One block per line in hex; what follows a # is a comment (the block's
+ * number and what it holds), and lines of only a comment are skipped. */
+static int dump_to_text(const struct saved *s, const char *path)
+{
+	static const char *const iclass_tags[] = { "CSN", "config", "e-purse", "Kd", "Kc", "AIA" };
+	int bs = card_bs(s);
+	const char *fn = strrchr(s->dump, '/');
+	FILE *f = fopen(path, "w");
+
+	if (!f)
+		return -1;
+	fprintf(f, "# %s \xc2\xb7 %s \xc2\xb7 UID %s\n", fn ? fn + 1 : s->dump, s->c.type, s->c.uid);
+	fprintf(f, "# One block per line, %d bytes in hex; after a # is a comment.\n", bs);
+	fprintf(f, "# Save and close Write: the Proxmark3 app then writes the dump file.\n");
+	for (int b = 0; b < V.blocks; b++) {
+		int n = V.len - b * bs < bs ? V.len - b * bs : bs;
+		char hx[64];
+
+		if (s->c.fam == FAM_MFC && b == mfc_first_block(mfc_sector_of(b)))
+			fprintf(f, "# sector %d\n", mfc_sector_of(b));
+		hex_spaced(V.data + b * bs, n, hx, sizeof(hx));
+		if (s->c.fam == FAM_MFC) {
+			int sct = mfc_sector_of(b);
+
+			fprintf(f, "%s  # %d%s\n", hx, b, !b ? " UID" :
+				b == mfc_first_block(sct) + mfc_blocks(sct) - 1 ? " keys + AC" : "");
+		} else if (s->c.fam == FAM_ICLASS) {
+			fprintf(f, "%s  # %d%s%s\n", hx, b, b < 6 ? " " : "", b < 6 ? iclass_tags[b] : "");
+		} else {
+			fprintf(f, "%s  # %03X\n", hx, b * bs);
+		}
+	}
+	return fclose(f);
+}
+
+/* The text back into the dump: 0, or the line that is wrong (err says
+ * why). Every block must have its bytes; nothing is written then. */
+static int dump_from_text(const struct saved *s, const char *path, uint8_t *out, int *changed, char *err, int en)
+{
+	char line[400];
+	int bs = card_bs(s), got = 0, ln = 0;
+	FILE *f = fopen(path, "r");
+
+	*changed = 0;
+	if (!f) {
+		snprintf(err, (size_t)en, "Could not read the text");
+		return -1;
+	}
+	while (fgets(line, sizeof(line), f)) {
+		int k = 0, want;
+
+		ln++;
+		line[strcspn(line, "#")] = 0;
+		for (char *p = line; *p; p++) {
+			if (isspace((unsigned char)*p))
+				continue;
+			if (!isxdigit((unsigned char)*p) || !isxdigit((unsigned char)p[1])) {
+				snprintf(err, (size_t)en, "Line %d: \"%c\" is not hex", ln, *p);
+				fclose(f);
+				return ln;
+			}
+			if (got + k >= V.len) {
+				snprintf(err, (size_t)en, "Line %d: more blocks than the dump has", ln);
+				fclose(f);
+				return ln;
+			}
+			out[got + k] = (uint8_t)strtol((char[3]){ p[0], p[1], 0 }, 0, 16);
+			k++;
+			p++;
+		}
+		if (!k)
+			continue;
+		want = V.len - got < bs ? V.len - got : bs;
+		if (k != want) {
+			snprintf(err, (size_t)en, "Line %d: %d bytes, a block has %d", ln, k, want);
+			fclose(f);
+			return ln;
+		}
+		if (memcmp(out + got, V.data + got, (size_t)k))
+			(*changed)++;
+		got += k;
+	}
+	fclose(f);
+	if (got != V.len) {
+		snprintf(err, (size_t)en, "%d of %d blocks: a block is missing", got / bs, V.blocks);
+		return ln ? ln : 1;
+	}
+	return 0;
+}
+
+/* Edit in Write: the dump as text; when Write closes, the text back into
+ * the dump file. After a mistake the text stays and opens again. */
+static void edit_dump(void)
+{
+	static uint8_t out[sizeof(V.data)];
+	struct saved *s = &cards[V.i];
+	char path[200], err[80], b[120], tmp[208];
+	struct stat ts, ds;
+	int changed, bad, scroll = V.scroll;
+	FILE *f;
+
+	if (!V.blocks) {
+		notice("No dump to edit", 1);
+		return;
+	}
+	if (stat(s->dump, &ds) || ds.st_size != V.len) {
+		notice("This dump is too large to edit here", 1);
+		return;
+	}
+	dump_text_path(s, path, sizeof(path));
+	/* a text newer than the dump: the edit that had a mistake */
+	if (stat(path, &ts) || ts.st_mtime < ds.st_mtime) {
+		if (dump_to_text(s, path)) {
+			notice("Could not write the text for Write", 1);
+			return;
+		}
+	}
+	open_in_write(path);
+	bad = dump_from_text(s, path, out, &changed, err, sizeof(err));
+	if (bad) {
+		snprintf(b, sizeof(b), "%s: dump not changed", err);
+		notice(b, 1);
+		log_add(b, 1);
+		return;
+	}
+	if (changed) {
+		snprintf(tmp, sizeof(tmp), "%s.new", s->dump);
+		if (!(f = fopen(tmp, "wb")) || fwrite(out, 1, (size_t)V.len, f) != (size_t)V.len) {
+			if (f)
+				fclose(f);
+			notice("Could not save the dump", 1);
+			return;
+		}
+		if (fclose(f) || rename(tmp, s->dump)) {
+			notice("Could not save the dump", 1);
+			return;
+		}
+	}
+	unlink(path);
+	card_load(V.i);
+	V.scroll = scroll;
+	snprintf(b, sizeof(b), changed == 1 ? "Dump saved: 1 block changed" : "Dump saved: %d blocks changed",
+		 changed);
+	notice(changed ? b : "No changes", 0);
+	log_add(changed ? b : "edit: no changes", 0);
+}
+
 static int dict_user(int i)
 {
 	return i >= 0 && i < n_dicts && !dicts[i].builtin;
@@ -2771,6 +2948,8 @@ static void menu_build(int what)
 		menu_open(what, "CARDS", cards[V.i].c.type);
 		if (cards[V.i].c.fam == FAM_MFC)
 			menu_add("Keys");
+		if (V.blocks)
+			menu_add("Edit in Write");
 		if (card_loads(&cards[V.i])) {
 			menu_add("Simulate");
 			menu_add("Write to a card");
@@ -2899,6 +3078,8 @@ static void menu_done(int i)
 	case M_CARD:
 		if (!strcmp(l, "Keys")) {
 			open_keys();
+		} else if (!strcmp(l, "Edit in Write")) {
+			edit_dump();
 		} else if (!strcmp(l, "Simulate")) {
 			char cmd[200];
 
