-			s->c.fam = FAM_ICLASS;
-			snprintf(s->c.type, sizeof(s->c.type), "%s", hf_fams[FAM_ICLASS]);
+		/* the dump says what the card is (cards saved before the search
+		 * knew better: an iCLASS card called ISO 15693, or no type) */
+		if (s->dump[0] && (fam = dump_fam(s->dump)) >= 0 && fam != s->c.fam) {
+			s->c.fam = fam;
+			snprintf(s->c.type, sizeof(s->c.type), "%s", hf_fams[fam]);
 		}
 		if (s->c.uid[0])
 			n_cards++;
@@ -1457,7 +1479,7 @@ static int card_bs(const struct saved *s)
 /* the dumps the Proxmark3 can load into its emulator memory */
 static int card_loads(const struct saved *s)
 {
-	return s->c.fam == FAM_MFC || s->c.fam == FAM_ICLASS;
+	return s->c.fam == FAM_MFC || s->c.fam == FAM_ICLASS || s->c.fam == FAM_15;
 }
 
 /* an iCLASS dump: the blocks before the application, then the rest */
@@ -1524,6 +1546,7 @@ static void draw_card(void)
 		text_wrap(&f_ui18, X0 + 20, 198 + 20, XW - 52, 26,
 			  s->c.fam == FAM_MFC ? "No dump of this card yet. Dump it in HF \xe2\x80\xba MIFARE Classic." :
 			  s->c.fam == FAM_ICLASS ? "No dump of this card yet. Dump it in HF \xe2\x80\xba iCLASS \xc2\xb7 PicoPass." :
+			  s->c.fam == FAM_15 ? "No dump of this card yet. Dump it in HF \xe2\x80\xba ISO 15693 \xc2\xb7 ICODE." :
 			  "Only the ID of this card is saved.", WB_COLOR_TEXT_LOW, 3, 1);
 		hints(nodump, 2);
 		return;
@@ -2199,17 +2222,13 @@ static void console_typed(const char *cmd)
  * file goes to Cards: on the card searched last when the name has its
