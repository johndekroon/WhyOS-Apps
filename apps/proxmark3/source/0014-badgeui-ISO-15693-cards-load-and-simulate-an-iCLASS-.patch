 	return sectors == 5 ? "320 B" : sectors == 32 ? "2 KB" : sectors == 40 ? "4 KB" : "1 KB";
 }
 
+/* the card types of the dumps the client names hf-<type>-<UID>-dump */
+static const struct { const char *tag; int fam; } dump_tags[] = {
+	{ "iclass", FAM_ICLASS }, { "mf", FAM_MFC }, { "mfu", FAM_MFU }, { "15", FAM_15 },
+};
+
+/* the card type a dump's name says (hf-<type>-<UID>-dump), or -1 */
+static int dump_fam(const char *path)
+{
+	const char *base = strrchr(path, '/') ? strrchr(path, '/') + 1 : path, *dash;
+
+	if (strncmp(base, "hf-", 3) || !(dash = strchr(base + 3, '-')))
+		return -1;
+	for (size_t i = 0; i < sizeof(dump_tags) / sizeof(dump_tags[0]); i++)
+		if ((int)strlen(dump_tags[i].tag) == dash - base - 3 && !strncmp(base + 3, dump_tags[i].tag, (size_t)(dash - base - 3)))
+			return dump_tags[i].fam;
+	return -1;
+}
+
 /* ---- the saved cards (~/.proxmark3/cards.tsv) ---------------------------------- */
 
 struct saved {
