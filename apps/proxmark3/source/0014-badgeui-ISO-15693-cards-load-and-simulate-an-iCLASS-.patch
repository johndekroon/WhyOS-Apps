-static const struct { const char *tag; int fam; } dump_tags[] = {
-	{ "iclass", FAM_ICLASS }, { "mf", FAM_MFC }, { "mfu", FAM_MFU }, { "15", FAM_15 },
-};
-
 static void dump_saved(const char *out)
 {
 	static const char said[] = "to binary file `";
 	const char *p = out;
 
 	while ((p = strstr(p, said))) {
-		char path[160], tag[16], u[48], cu[48];
+		char path[160], u[48], cu[48];
 		const char *base, *dash;
 		struct pm3_card c;
 		struct saved *s;
@@ -2229,23 +2248,21 @@ static void dump_saved(const char *out)
 		base = strrchr(path, '/') ? strrchr(path, '/') + 1 : path;
 		if (strncmp(base, "hf-", 3) || !strstr(base, "-dump") || stat(path, &st) || st.st_size <= 0)
 			continue;
-		dash = strchr(base + 3, '-');
-		if (!dash || dash - base - 3 >= (int)sizeof(tag))
+		if ((fam = dump_fam(path)) < 0)
 			continue;
-		snprintf(tag, sizeof(tag), "%.*s", (int)(dash - base - 3), base + 3);
-		for (size_t i = 0; i < sizeof(dump_tags) / sizeof(dump_tags[0]); i++)
-			if (!strcmp(tag, dump_tags[i].tag))
-				fam = dump_tags[i].fam;
+		dash = strchr(base + 3, '-');
 		k = 0;
 		for (const char *q = dash + 1; isxdigit((unsigned char)*q) && k < (int)sizeof(u) - 1; q++)
 			u[k++] = (char)toupper((unsigned char)*q);
 		u[k] = 0;
-		if (fam < 0 || k < 8 || k % 2)
+		if (k < 8 || k % 2)
 			continue;
 		uid_hex(O.card.uid, cu, sizeof(cu));
 		if (O.card.found && O.card.band == BAND_HF && !strcmp(cu, u)) {
 			c = O.card;
-			if (c.fam < 0) {	/* a type the search did not know */
+			/* the dump says what the card is: an iCLASS card a search
+			 * called ISO 15693, or one it did not know */
+			if (c.fam != fam) {
 				c.fam = fam;
 				snprintf(c.type, sizeof(c.type), "%s", hf_fams[fam]);
 			}
@@ -3097,8 +3114,9 @@ static void menu_done(int i)
 		} else if (!strcmp(l, "Simulate")) {
 			char cmd[200];
 
-			/* iCLASS: the dump in the emulator memory (the triangle loads it) */
-			expand(cards[V.i].c.fam == FAM_ICLASS ? "hf iclass sim -t 3" : "hf mf sim %S -u %U", cmd, sizeof(cmd), 0);
+			/* iCLASS, ISO 15693: the dump in the emulator memory (Load) */
+			expand(cards[V.i].c.fam == FAM_ICLASS ? "hf iclass sim -t 3" : cards[V.i].c.fam == FAM_15 ? "hf 15 sim" :
+			       "hf mf sim %S -u %U", cmd, sizeof(cmd), 0);
 			console_typed(cmd);
 		} else if (!strcmp(l, "Write to a card")) {
 			if (!V.blocks) {
@@ -3110,6 +3128,11 @@ static void menu_done(int i)
 				snprintf(cmd, sizeof(cmd), "hf iclass restore -f %s --first 6 --last %d --ki 0", cards[V.i].dump,
 					 V.blocks - 1);
