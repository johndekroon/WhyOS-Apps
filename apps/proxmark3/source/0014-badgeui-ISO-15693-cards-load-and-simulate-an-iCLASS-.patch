diff --git a/client/src/badgeui/test_pm3ui.py b/client/src/badgeui/test_pm3ui.py
index cd0dd634d..51cd4f237 100644
--- a/client/src/badgeui/test_pm3ui.py
+++ b/client/src/badgeui/test_pm3ui.py
@@ -182,6 +182,43 @@ class Test(unittest.TestCase):
         w = self.a.run("\\r\\r\\n\\n\\1")
         self.assertIn("Load into the Proxmark3", w["menu"])
 
+    def saved_card(self, fam, type_, uid, dump_name, size):
+        """a card in cards.tsv with a dump, as the app writes them"""
+        d = os.path.join(self.a.home, ".proxmark3/dumps")
+        os.makedirs(d, exist_ok=True)
+        dump = os.path.join(d, dump_name)
+        with open(dump, "wb") as f:
+            f.write(bytes(range(256)) * (size // 256))
+        with open(os.path.join(self.a.home, ".proxmark3/cards.tsv"), "w") as f:
+            f.write("\t".join(["1793300000", "0", str(fam), type_, uid, "", "", "-1", "0", dump, "", "dump"]) + "\n")
+        return dump
+
+    def test_iso15693_card(self):
+        # an ISO 15693 dump: load, simulate and write, as for iCLASS
+        dump = self.saved_card(5, "ISO 15693 tag", "E0 04 01 50 12 34 56 78", "hf-15-E004015012345678-dump.bin", 512)
+        w = self.a.run("\\r\\r\\n\\n\\1", "card-15")
+        self.assertEqual(w["menu"], "|Edit in Write |Load into the Proxmark3 |Simulate |Write to a card |Delete")
+        w = self.a.run("\\r\\r\\n\\n\\1\\d\\n")
+        self.assertIn("emulator memory", w["notice"])
+        w = self.a.run("\\r\\r\\n\\n\\1\\d\\d\\n")
+        self.assertEqual(w["input"], "hf 15 sim")
+        w = self.a.run("\\r\\r\\n\\n\\1\\d\\d\\d\\n")
+        self.assertEqual(w["input"], "hf 15 restore -f " + dump)
+
+    def test_iclass_dump_on_an_iso15693_card(self):
+        # saved as ISO 15693 by a search, its dump iCLASS: it is iCLASS
+        self.saved_card(5, "ISO 15693 tag", "01 02 03 04 05 06 07 08", "hf-iclass-0102030405060708-dump.bin", 256)
+        w = self.a.run("\\r\\r\\n\\n\\1\\d\\d\\n")
+        self.assertEqual(w["input"], "hf iclass sim -t 3")
+        self.assertEqual(w["view"], "32")             # 8-byte blocks
+
+    def test_family_load_and_simulate(self):
+        # HF > ISO 15693 and HF > iCLASS: Load the dump, Simulate
+        w = self.a.run("\\n" + "\\d" * 6 + "\\n" + "\\d" * 4 + "\\n")
+        self.assertEqual(w["input"], "hf 15 sim")
+        w = self.a.run("\\n" + "\\d" * 7 + "\\n" + "\\d" * 4 + "\\n")
+        self.assertEqual(w["input"], "hf iclass sim -t 3")
+
     def test_edit_dump_in_write(self):
         # an iCLASS dump in Cards, then Edit in Write changes block 6
         self.a.run("\\n" + "\\d" * 7 + "\\n\\d\\d\\n\\n")
