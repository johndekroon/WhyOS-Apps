+/* The card is of this HF type: the HF and LF types are numbered apart
+ * (FAM_MFC and FAM_EM410X are both 0), so the band counts too. */
+static int is_hf(const struct pm3_card *c, int fam)
+{
+	return c->band == BAND_HF && c->fam == fam;
+}
+
+/*
+ * What a saved card offers, per type: its dump into the Proxmark3's
+ * emulator memory (load), simulating it, and writing it to a card (HF:
+ * the dump; LF: the ID onto a T55xx). In the commands, %F is the dump, %U
+ * the UID or ID, %S the MIFARE Classic size flag, %L the dump's last
+ * block. Writing a MIFARE Classic asks first and runs (CF_RESTORE); the
+ * others are typed in the Console, to edit (a key, a block range).
+ */
+struct card_cmds { int band, fam; const char *load, *sim, *write, *write_label; };
+static const struct card_cmds card_table[] = {
+	{ BAND_HF, FAM_MFC, "hf mf eload %S -f %F", "hf mf sim %S -u %U", 0, "Write to a card" },
+	{ BAND_HF, FAM_MFU, "hf mfu eload -f %F", "hf mfu sim -t 2 -u %U", "hf mfu restore -f %F", "Write to a card" },
+	{ BAND_HF, FAM_15, "hf 15 eload -f %F", "hf 15 sim", "hf 15 restore -f %F", "Write to a card" },
+	{ BAND_HF, FAM_ICLASS, "hf iclass eload -f %F", "hf iclass sim -t 3",
+	  "hf iclass restore -f %F --first 6 --last %L --ki 0", "Write to a card" },
+	{ BAND_LF, FAM_EM410X, 0, "lf em 410x sim --id %U", "lf em 410x clone --id %U", "Clone to a T55xx" },
+	{ BAND_LF, FAM_HID, 0, "lf hid sim -r %U", "lf hid clone -r %U", "Clone to a T55xx" },
+	{ BAND_LF, FAM_INDALA, 0, "lf indala sim -r %U", "lf indala clone -r %U", "Clone to a T55xx" },
+};
+
+static const struct card_cmds *card_cmds(const struct saved *s)
+{
+	for (size_t i = 0; i < sizeof(card_table) / sizeof(card_table[0]); i++)
+		if (card_table[i].band == s->c.band && card_table[i].fam == s->c.fam)
+			return &card_table[i];
+	return 0;
+}
+
 /* a dump's block: MIFARE Classic 16 bytes, iCLASS 8; other dumps as rows
  * of 16 bytes */
 static int card_bs(const struct saved *s)
 {
-	return s->c.fam == FAM_ICLASS ? 8 : 16;
+	return is_hf(&s->c, FAM_ICLASS) ? 8 : 16;
 }
 
 /* the dumps the Proxmark3 can load into its emulator memory */
 static int card_loads(const struct saved *s)
 {
-	return s->c.fam == FAM_MFC || s->c.fam == FAM_ICLASS || s->c.fam == FAM_15;
+	return card_cmds(s) && card_cmds(s)->load;
 }
 
 /* an iCLASS dump: the blocks before the application, then the rest */
