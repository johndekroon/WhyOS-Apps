+++ b/client/src/badgeui/pm3ui_pm3.c
@@ -351,6 +351,15 @@ static void search_lf(struct pm3_card *c)
 		if (!c->uid[0])
 			hex_after(line, "", 6, c->uid, sizeof(c->uid));
 	}
+	/* HID's first line is its Wiegand format (FC, CN); sim and clone
+	 * want the raw bits, on a line of their own, as Indala's */
+	if (c->fam == FAM_HID || c->fam == FAM_INDALA) {
+		char raw[48];
+
+		hex_after(o, c->fam == FAM_HID ? "raw:" : "Raw:", 6, raw, sizeof(raw));
+		if (raw[0])
+			snprintf(c->uid, sizeof(c->uid), "%s", raw);
+	}
 }
 
