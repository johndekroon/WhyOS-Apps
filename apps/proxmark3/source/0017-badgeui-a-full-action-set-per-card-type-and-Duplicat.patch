+/* copy src to a file of its own in the same folder ("-copyN" before the
+ * extension); the type tag stays the second field, so Cards still reads
+ * it. Sets dst, 0 or -1. */
+static int copy_dump(const char *src, char *dst, int dn)
+{
+	static uint8_t buf[sizeof(V.data)];
+	const char *dot = strrchr(src, '.');
+	int stem = dot ? (int)(dot - src) : (int)strlen(src);
+	int n = load_bin(src, buf, sizeof(buf));
+	FILE *f;
+
+	if (n <= 0)
+		return -1;
+	for (int i = 2; i < 100; i++) {
+		snprintf(dst, (size_t)dn, "%.*s-copy%d%s", stem, src, i, dot ? dot : "");
+		if (access(dst, F_OK))
+			break;
+	}
+	if (!(f = fopen(dst, "wb")))
+		return -1;
+	fwrite(buf, 1, (size_t)n, f);
+	return fclose(f) ? -1 : 0;
+}
+
+/* A second card from card i, newest first, with its dump and keys copied
+ * to files of their own: editing or writing the copy leaves the original.
+ * Named "<its name> copy". */
+static void duplicate_card(int i)
+{
+	struct saved d;
+
+	if (i < 0 || i >= n_cards)
+		return;
+	if (n_cards >= CARDS_MAX) {
+		notice("Cards is full", 1);
+		return;
+	}
+	d = cards[i];
+	d.t = (long)time(0);
+	snprintf(d.name, sizeof(d.name), "%.40s copy", card_title(&cards[i]));
+	if (d.dump[0] && copy_dump(cards[i].dump, d.dump, sizeof(d.dump)) < 0) {
+		notice("Could not copy the dump", 1);
+		return;
+	}
+	if (d.keys[0] && copy_dump(cards[i].keys, d.keys, sizeof(d.keys)) < 0)
+		d.keys[0] = 0;		/* the copy without keys is better than shared keys */
+	memmove(cards + 1, cards, sizeof(cards[0]) * (size_t)n_cards);
+	n_cards++;
+	cards[0] = d;
+	cards_save();
+	O.focus = 0;
+	while (O.sc != SC_CARDS && !back())
+		;			/* from the card view: to the list, on the copy */
+	notice("Card duplicated", 0);
+}
