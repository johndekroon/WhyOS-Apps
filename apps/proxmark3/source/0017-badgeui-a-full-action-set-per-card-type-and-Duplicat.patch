+    def test_commands_exist_in_the_client(self):
+        """Every hf/lf command the app types or runs, against the client's
+        own CLIParser definitions: the command exists, and each flag it
+        passes is one of its arguments."""
+        src = os.path.join(HERE, "..")
+        defs = {}       # "hf mf rdbl" -> (shorts, longs)
+        for fn in os.listdir(src):
+            if not (fn.startswith("cmd") and fn.endswith(".c")):
+                continue
+            text = open(os.path.join(src, fn), errors="replace").read()
+            default = re.search(r"arg_add_default\(void \*at\[\]\) \{(.*?)\n\}", text, re.S)
+            for m in re.finditer(r'CLIParserInit\(&ctx, "([a-z0-9 ]+)"(.*?)CLIExec', text, re.S):
+                body = m.group(2) + (default.group(1) if default and "arg_add_default" in m.group(2) else "")
+                shorts, longs = set(), set()
+                for a in re.finditer(r'arg_\w+\(\s*(NULL|"[^"]*")\s*,\s*(NULL|"[^"]*")', body):
+                    if a.group(1) != "NULL":
+                        shorts.update(a.group(1).strip('"'))
+                    if a.group(2) != "NULL":
+                        longs.add(a.group(2).strip('"'))
+                defs[m.group(1)] = (shorts, longs)
+        code = open(os.path.join(HERE, "pm3ui.c")).read()
+        cmds = set(re.findall(r'"((?:hf|lf) [^"%]*(?:%[A-Z][^"%]*)*)"', code))
+        checked = 0
+        for cmd in sorted(cmds):
+            if ":" in cmd:
+                continue            # a log line ("hf mf fchk: cancelled")
+            words = cmd.replace("%S", "--1k").replace("%U", "01020304").replace("%F", "x.bin") \
+                       .replace("%L", "18").split()
+            path = None
+            for n in range(len(words), 1, -1):
+                if " ".join(words[:n]) in defs:
+                    path = " ".join(words[:n])
+                    break
+            if path is None:
+                if len(words) <= 3 and not any(w.startswith("-") for w in words):
+                    continue        # a prefix ("hf ", "lf search" without a parser of its own)
+                self.fail("%r: no such command in the client" % cmd)
+            shorts, longs = defs[path]
+            for w in words[len(path.split()):]:
+                if w.startswith("--"):
+                    self.assertIn(w[2:], longs, "%r: %s has no --%s" % (cmd, path, w[2:]))
+                elif w.startswith("-") and len(w) > 1:
+                    for ch in w[1:]:
+                        self.assertIn(ch, shorts, "%r: %s has no -%s" % (cmd, path, ch))
+            checked += 1
+        self.assertGreater(checked, 60)
