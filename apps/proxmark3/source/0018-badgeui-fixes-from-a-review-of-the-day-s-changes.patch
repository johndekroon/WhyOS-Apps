+/*
+ * The saved card a new dump goes on: one with this UID on this band that
+ * has no dump yet (saved from a search, the key check), else a new card,
+ * newest first. A dump never replaces another: dumping a card again, or a
+ * card that was duplicated, adds a card, so no dump drops out of Cards and
+ * a copy stays apart from its original. 0 when Cards is full.
+ */
+static struct saved *card_for_dump(const struct pm3_card *c)
+{
+	struct saved s;
+	int i;
+
+	for (i = 0; i < n_cards; i++)
+		if (cards[i].c.band == c->band && !strcmp(cards[i].c.uid, c->uid) && !cards[i].dump[0])
+			break;
+	if (i < n_cards) {
+		s = cards[i];
+		memmove(cards + 1, cards, sizeof(cards[0]) * (size_t)i);
+	} else {
+		if (n_cards == CARDS_MAX)
+			return 0;
+		memset(&s, 0, sizeof(s));
+		memmove(cards + 1, cards, sizeof(cards[0]) * (size_t)n_cards);
+		n_cards++;
+	}
+	s.c = *c;
+	s.c.found = 1;
+	s.t = (long)time(0);
+	cards[0] = s;
+	return &cards[0];
+}
+
+/* path, or path-001.bin, -002, ... when that exists, as the client names
+ * its files (newfilenamemcopy): a dump never overwrites another */
+static void free_path(char *path, int n)
+{
+	char base[256];
+	const char *dot;
+	int stem;
+
+	if (access(path, F_OK))
+		return;
+	snprintf(base, sizeof(base), "%s", path);
+	dot = strrchr(base, '.');
+	stem = dot ? (int)(dot - base) : (int)strlen(base);
+	for (int i = 1; i < 1000; i++) {
+		snprintf(path, (size_t)n, "%.*s-%03d%s", stem, base, i, dot ? dot : "");
+		if (access(path, F_OK))
+			return;
+	}
+}
