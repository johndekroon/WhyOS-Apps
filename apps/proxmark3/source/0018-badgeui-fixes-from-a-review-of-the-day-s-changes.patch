+        self.a.run("\\n\\n\\1\\n")                           # HF search, Save to Cards
+        w = self.a.run("\\n\\n\\n\\d\\n\\w\\2\\e")          # check, dump (Esc: no name)
+        self.assertTrue(w["cards"].startswith("1 07 94 71 12|full dump"), w["cards"])
+        # dumped again: a second card, a second file (-001), the first kept
+        w = self.a.run("\\n\\n\\n\\d\\n\\w\\2\\e")
+        self.assertTrue(w["cards"].startswith("2 "), w["cards"])
+        d = os.path.join(self.a.home, ".proxmark3/dumps")
+        self.assertTrue(os.path.exists(os.path.join(d, "hf-mf-07947112-dump.bin")))
+        self.assertTrue(os.path.exists(os.path.join(d, "hf-mf-07947112-dump-001.bin")))
