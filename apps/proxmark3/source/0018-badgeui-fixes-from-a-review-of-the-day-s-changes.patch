+    def test_a_dump_never_replaces_another(self):
+        # dumped, duplicated, dumped again: three cards, each its own file;
+        # the copy keeps its own (it would have shared the original's)
+        con = "\\d\\r\\r\\n"
+        self.a.run(con + "hf iclass dump\\nOrig\\n")
+        self.a.run("\\r\\r\\n\\1\\d\\d\\n")                 # Duplicate: "Orig copy"
+        self.a.run(con + "hf iclass dump\\nNew\\n")
+        with open(os.path.join(self.a.home, ".proxmark3/cards.tsv")) as f:
+            rows = [line.rstrip("\n").split("\t") for line in f]
+        self.assertEqual([r[12] for r in rows], ["New", "Orig copy", "Orig"])
+        dumps = [os.path.basename(r[9]) for r in rows]
+        self.assertEqual(dumps, ["hf-iclass-0102030405060708-dump-001.bin",
+                                 "hf-iclass-0102030405060708-dump-copy2.bin",
+                                 "hf-iclass-0102030405060708-dump.bin"])
+
