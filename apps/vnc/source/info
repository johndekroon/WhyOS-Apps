#!/bin/sh
# Where to reach the VNC server (vncd) and its password.
pw=${APP_DATA:-/mnt/sd/badge/appdata/vnc}/password
echo "VNC server"
echo
if grep -qsx vncd /proc/[0-9]*/comm; then
	echo "Running, on port 5900."
else
	echo "Off: turn it on in Settings > Connection > VNC server."
fi
echo
found=
for i in wlan0 usb0; do
	a=$(ifconfig "$i" 2>/dev/null | sed -n 's/.*inet addr:\([0-9.]*\).*/\1/p')
	[ -n "$a" ] || continue
	case $i in
	wlan0) what="Wi-Fi" ;;
	*) what="USB  " ;;
	esac
	echo "  $what  vnc://$a"
	found=1
done
[ -n "$found" ] || echo "  No network: connect Wi-Fi or USB first."
echo
if [ -r "$pw" ]; then
	echo "Password: $(head -n 1 "$pw")"
else
	echo "The password appears here once the server has run."
fi
echo
echo "On a Mac: Finder > Go > Connect to Server, the address above."
echo "Other viewers: the address and port 5900, VNC password."
echo "The viewer's keys go to the badge; Cmd or Windows is the logo key."
