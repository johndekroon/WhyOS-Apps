 "category": "hardware",
 "description": "Control a Bus Pirate 6 on the badge's bottom USB port from the keypad,\nwith tiles like the home screen:\n\n- Power supply: on and off, 0.8 to 5.0 V, a current limit, pull-ups; the\n  voltage and current it measures, every second.\n- Logic analyzer: 8 channels at 10 kHz to 50 MHz, a trigger on one pin,\n  saved to /root/capture.bin; scroll and zoom with the arrows.\n- LEDs: WS2812 or APA102 strips or the Bus Pirate's own LEDs, colour,\n  brightness and count.\n- Console: the Bus Pirate's own terminal, in colour, for everything else.\n- Pins and Info: the voltage on every pin, and the output of \"i\".\n\nEsc on the tiles or the logo key closes it.",
 "format": 1,
 "homepage": "https://buspirate.com",
 "icon": null,
 "id": "buspirate",
 "install_location": "sd",
 "launch": {
  "exec": "buspirate",
  "icon": "chip",
  "info": "Bus Pirate 6 on the bottom port",
  "menu": "apps",
  "rotation": "auto",
  "terminal": false
 },
 "license": "MIT AND OFL-1.1 AND LGPL-2.1-or-later",
 "license_url": "licenses/buspirate/buspirate.txt",
 "name": "Bus Pirate",
 "requires": {
  "features": [
   "usb-host",
   "display",
   "keyboard"
  ],
  "memory_kb": 1500,
  "os_api": 1
 },
 "screenshots": [],
 "source": "https://github.com/johndekroon/WhyOS-Apps/tree/main/apps/buspirate/source",
 "summary": "Power supply, logic analyzer, LEDs and console for a Bus Pirate 6",
 "tags": [
  "bus-pirate",
  "logic-analyzer",
  "power-supply",
  "ws2812",
  "usb"
 ],
