 "cover": "screens/flashlight-cover.qoi",
 "description": "Three modes: white at 100%, white at 50% and red at 100%. The square,\ntriangle and cross choose one, the arrow keys step through them and the\ndiamond shows the help. The mode you used last comes back the next time.\n\nFor the first two seconds the screen stays at the badge's own brightness\nand shows the keys in the bar at the bottom, so a dark room is not lit\nat once. Then the keys go and the whole screen is the light. The screen stays on until you close\nthe app with Esc or the logo key, and the brightness goes back to your\nsetting.",
 "format": 1,
 "homepage": "https://github.com/johndekroon/WhyOS-Apps",
 "icon": null,
 "id": "flashlight",
 "install_location": "sd",
 "launch": {
  "exec": "flashlight",
  "icon": "sun",
  "info": "a white or red light",
  "menu": "apps",
  "rotation": "auto",
  "statusbar": "hidden",
  "terminal": false
 },
 "license": "MIT AND OFL-1.1 AND LGPL-2.1-or-later",
