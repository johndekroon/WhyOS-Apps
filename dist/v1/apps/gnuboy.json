 "cover": null,
 "description": "Plays Game Boy and Game Boy Color games, scaled 4x to 640x576 in the\nmiddle of the panel. The emulation runs at full speed; the screen is drawn\nup to 30 times a second, less often while the whole screen scrolls. There\nis no sound.\n\nPut your .gb and .gbc files in the roms folder of this app: on the SD card\nin badge/appdata/gnuboy/roms. Battery saves go to roms/saves.\n\nKeys: arrows are the D-pad, square or Enter is A, triangle or Backspace\nis B, cross or X is Start, circle or O is Select. Esc pauses: save or load\nthe state there, or quit. Diamond shows the keys.",
 "format": 1,
 "homepage": "https://github.com/rofl0r/gnuboy",
 "icon": null,
 "id": "gnuboy",
 "install_location": "sd",
 "launch": {
  "args": "--source %d/badge.rc --savedir=%D/roms/saves %f",
  "exec": "gnuboy",
  "files": "%D/roms",
  "icon": "gameboy",
  "info": "gnuboy",
  "menu": "games",
  "rotation": "auto",
  "stack_kb": 64,
  "terminal": false,
  "types": [
   "gb",
   "gbc"
  ]
 },
 "license": "GPL-2.0-or-later AND LGPL-2.1-or-later",
 "license_url": "licenses/gnuboy/gnuboy.txt",
 "name": "Game Boy",
 "requires": {
  "features": [
   "sd-card",
   "display",
   "keyboard"
  ],
  "memory_kb": 1000,
  "os_api": 1
 },
 "screenshots": [],
 "source": "https://github.com/johndekroon/WhyOS-Apps/tree/main/apps/gnuboy/source",
 "storage": {
  "data": {
   "folders": [
    "roms",
    "roms/saves"
   ],
   "user_folders": [
    "roms"
   ]
  }
 },
