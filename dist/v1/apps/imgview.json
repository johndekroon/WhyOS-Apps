 "category": "other",
 "description": "Shows photos and pictures on the panel: JPEG and PNG, fitted to the\nscreen, with the other pictures in the same folder under the arrow keys.\nJPEGs are turned upright from their EXIF orientation.\n\nPictures are scaled down while they are read, so even a 12-megapixel\nphone photo fits in the badge's memory. Files opens pictures with it; it\nhas no entry in the menu's lists.",
 "format": 1,
 "icon": null,
 "id": "imgview",
 "install_location": "sd",
 "launch": {
  "args": "%f",
  "exec": "imgview",
  "info": "Shows JPEG and PNG pictures…",
  "menu": "none",
  "opens": [
   "jpg",
   "jpeg",
   "png"
  ],
  "rotation": "auto",
  "stack_kb": 64,
  "terminal": false
 },
 "license": "MIT AND IJG AND libpng-2.0 AND Zlib AND OFL-1.1 AND LGPL-2.1-or-later",
 "license_url": "licenses/imgview/imgview.txt",
 "name": "Picture viewer",
 "requires": {
  "features": [
   "display",
   "keyboard"
  ],
  "memory_kb": 2500,
  "os_api": 1
 },
