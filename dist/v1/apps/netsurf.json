 "category": "internet",
 "description": "A web browser with its own layout engine: HTML, CSS, PNG, JPEG and GIF,\nHTTPS through Mbed TLS. No JavaScript, WebP, SVG or video, to save memory.\n\nThe badge has no mouse, so the browser brings a pointer: the arrows move\nit (faster while held), circle clicks or drags, triangle and cross scroll\na page up and down, square and diamond go back and forward, and the cloud\nkey opens the address bar. Fn with the arrows sends the arrow keys\nthemselves.\n\nLarge pages such as Wikipedia do not fit in the badge's memory; NetSurf\nthen stops with an error instead of hanging.",
 "format": 1,
 "homepage": "https://www.netsurf-browser.org",
 "icon": null,
 "id": "netsurf",
 "install_location": "sd",
 "launch": {
  "args": "-f badge -w 720 -h 720 -b 16 %u",
  "exec": "start",
  "icon": "globe",
  "info": "web browser",
  "menu": "apps",
  "opens": [
   "html",
   "htm",
   "xhtml",
   "svg"
  ],
  "rotation": "auto",
  "stack_kb": 256,
  "terminal": false
 },
 "license": "GPL-2.0-only AND MIT AND Unicode-DFS-2015 AND (Apache-2.0 OR GPL-2.0-or-later) AND curl AND libpng-2.0 AND IJG AND Zlib AND LGPL-2.1-or-later AND MPL-2.0",
 "license_url": "licenses/netsurf/netsurf.txt",
 "name": "NetSurf",
 "permissions": [
  "network"
 ],
 "requires": {
  "features": [
   "wifi",
   "sd-card",
   "display",
   "keyboard"
  ],
  "memory_kb": 5000,
  "os_api": 1
 },
 "screenshots": [],
 "source": "https://github.com/johndekroon/WhyOS-Apps/tree/main/apps/netsurf/source",
 "storage": {
  "config": {
   "max_kb": 128
  }
 },
 "summary": "Graphical web browser with HTTPS, without JavaScript",
 "tags": [
  "browser",
  "web",
  "https"
 ],
