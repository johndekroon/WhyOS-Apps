 "category": "other",
 "cover": "screens/pdfview-cover.qoi",
 "description": "Reads PDF documents on the badge: a page as wide as the screen, to\nscroll with the arrow keys, on into the next page. Left and Right turn\nthe pages, Space goes a screen down, Enter zooms in 2x. The square key\nhas Go to page and Whole page. It opens a file again on the page you\nleft it at.\n\nFiles opens PDF files with it; it has no entry in the menu's lists.\nRendering is done by MuPDF, cut down for the badge: documents in Chinese,\nJapanese or Korean, and PDFs with JPEG 2000 images, show those parts as\nboxes or blank. Locked PDFs (with a password) cannot be opened.\n\nIt needs about 6 MB of memory while it shows a page.",
 "format": 1,
 "icon": null,
 "id": "pdfview",
 "install_location": "sd",
 "launch": {
  "args": "%f",
  "exec": "pdfview",
  "info": "Shows PDF documents, opened…",
  "menu": "none",
  "opens": [
   "pdf"
  ],
  "rotation": "auto",
  "stack_kb": 256,
  "terminal": false
 },
 "license": "AGPL-3.0-or-later AND FTL AND IJG AND Zlib AND OFL-1.1 AND LGPL-2.1-or-later",
 "license_url": "licenses/pdfview/pdfview.txt",
 "name": "PDF viewer",
 "requires": {
  "features": [
   "display",
   "keyboard"
  ],
  "memory_kb": 7000,
  "os_api": 1
 },
