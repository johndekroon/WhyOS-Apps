 "category": "hardware",
 "cover": null,
 "description": "Shows the BME680's temperature, humidity and pressure and the BMI270's\nacceleration on all three axes, about three times a second, with a graph\nof the last 20 temperatures. The BME680 sits on the board, so it reads\nwarmer than the room.\n\nEsc or the logo key closes it.",
 "format": 1,
 "homepage": "https://github.com/mrbreaker/why2025-linux",
 "icon": null,
 "id": "sensorpanel",
 "install_location": "sd",
 "launch": {
  "esc": "quit",
  "exec": "sensorpanel",
  "icon": "sensors",
  "info": "temperature, humidity, motion",
  "menu": "apps",
  "rotation": "auto",
  "terminal": false
 },
 "license": "GPL-2.0-only AND LGPL-2.1-or-later",
 "license_url": "licenses/sensorpanel/sensorpanel.txt",
 "name": "Sensor panel",
 "requires": {
  "features": [
   "display",
   "environment-sensor",
   "accelerometer"
  ],
  "memory_kb": 1200,
  "os_api": 1
 },
 "screenshots": [],
 "source": "https://github.com/johndekroon/WhyOS-Apps/tree/main/apps/sensorpanel/source",
 "summary": "Live readings of the badge's environment and motion sensors",
