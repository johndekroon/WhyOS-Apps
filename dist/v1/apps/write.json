 "category": "other",
 "cover": "screens/write-cover.qoi",
 "description": "Write notes and documents on the badge, with headings, lists, bold,\nitalic and underline, saved as markdown (.md) that any other editor can\nopen. Markdown works while you type: \"# \" makes a heading, \"- \" a list,\n**bold** turns bold when you type the last star. The cross key shows the\nmarkdown itself.\n\nCode and other text open in a code view with line numbers, colours for\nPython, shell, HTML, CSS, JavaScript, JSON, YAML, C and more, and Tab\nand Enter keep the indent. The triangle runs a Python or shell script\nin a terminal window, or shows an HTML page in NetSurf.\n\nSelect with Fn and the arrows, copy, cut and paste between documents,\nfind and replace, full screen for long texts. Files opens .md and .txt\nfiles in Write. The logo key saves before going back to the menu.",
 "format": 1,
 "homepage": "https://github.com/johndekroon/WhyOS-Apps",
 "icon": null,
 "id": "write",
 "install_location": "flash",
 "launch": {
  "args": "%f",
  "exec": "write",
  "icon": "text",
  "info": "notes and code",
  "menu": "apps",
  "opens": [
   "md",
   "markdown",
   "txt"
  ],
  "opens_also": [
   "conf",
   "cfg",
   "ini",
   "log",
   "sh",
